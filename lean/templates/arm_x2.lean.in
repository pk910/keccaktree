import Keccaktree.Kernels.@NS@.GenSE1.Seg
import Keccaktree.Kernels.@NS@.GenSH.Seg
import Keccaktree.Kernels.@NS@.GenSHa.Seg
import Keccaktree.Kernels.@NS@.GenSHb.Seg
import Keccaktree.Kernels.@NS@.GenSHc.Seg
import Keccaktree.Kernels.@NS@.GenSBe.Seg
import Keccaktree.Kernels.@NS@.GenSBo.Seg
import Keccaktree.Kernels.@NS@.GenSX.Seg
import Keccaktree.Asm.KernelGlue
import Keccaktree.Asm.ArmSteps
import Keccaktree.Asm.ArmFlags
import Keccaktree.Asm.Nodes
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
/-!
# `@SYM@` (AArch64, two nodes per batch) on any number of nodes

GENERATED by lean/gen_all_arm.py (template templates/arm_x2.lean.in); do not edit.

The kernel: a frame (`stp` of `d8..d15`, `cbz x2` to the epilogue), the loop head (`add x3, x1, #64;
add x4, x0, #32; add x5, sp, #64`), `cmp x2, #2; csel x3, x3, x1, cs; csel x4, x4, x5, cs` (with one node
left the second lane re-hashes node 0 into a scratch slot on the stack), the batch (two nodes, the
pointers advanced), `subs x2, x2, #2; b.gt loop`, the epilogue.  Segments: `GenSE1` frame, `GenSH` loop
head, `GenSHa/b/c` the two `csel` with the flags of `cmp` for `r ≥ 3`, `r = 2`, `r = 1` nodes left,
`GenSBe` the batch on two nodes, `GenSBo` the batch with node 0 duplicated, `GenSX` the epilogue.
The flag-free segments run from any flags (`seg_flags`); `cmp`, `subs`, `cbz`, `b.gt`, `ret` are the
concrete lemmas of `ArmSteps`.  The loop is an induction over the batches, batch `k` running at
nodes `off + 2k` (relocation `rho (off + 2k)`).

**Result** (`all`): for every count `c` and node offset `off` with `64·(off+c) ≤ 2^54`, from an entry
state (`Entry`: any flags), `@XLEN6@ + @IT@·⌈c/2⌉` steps halt without a model fault and without a tail
call, keep the output words before node `off`, and leave the keccak256 digest of input node `off+n` in
output words `4(off+n) ..`, for every `n < c`.
-/
namespace Keccaktree.Kernels.@NS@.All
open Keccaktree.Asm Keccaktree.Asm.X86 Keccaktree.Asm.Nodes Keccaktree.Proof Keccak
open Keccaktree.Kernels.@NS@ (prog rodata)

@COMMON@
/-! ## The batch -/

@INV0E@@INV0O@@DIGE0@@DIGE1@@DIGO0@
/-- The batch's write condition is false outside its nodes' output words and the stack. -/
theorem wok_out (N : Nat) (q : Int) (h : q < 0 ∨ 4 * (N : Int) ≤ q) :
    ((rOutput == 3) || (rOutput == 2 && decide (0 ≤ q) && decide (q < 4 * N))) = false := by
  rcases h with h | h
  · rw [show decide (0 ≤ q) = false from decide_eq_false (by omega)]; rfl
  · rw [show decide (q < 4 * N) = false from decide_eq_false (by omega)]
    cases decide (0 ≤ q) <;> rfl

/-- The loop head before batch `k` (of a call on `c` nodes at offset `off` from `S0`): with the
recorded flags, the head's start cut relocated by `off + 2k`; the count `c - 2k` in `x2`, the
message, the earlier output words, and the digests of the nodes done. -/
@[reducible] def Head (off c : Nat) (input : Int → BitVec 64) (S0 : State (BitVec 64)) (k : Nat) (S : State (BitVec 64)) : Prop :=
  relocState (rho (off + 2 * k)) (cutOf GenSH.ctl0 GenSH.sc0) = cutOf GenSH.ctl0 (norm S GenSH.sc0) ∧ SliceCert.Ok S ∧
  S.getGD 2 = gprWord ⟨0, (c : Int) - 2 * k⟩ ∧ (∀ q, S.mem rInput q = input q) ∧
  (∀ q : Int, q < 4 * (off : Int) → S.mem rOutput q = S0.mem rOutput q) ∧
  (∀ n, n < 2 * k → Digest input S (off + n))

/-- The epilogue: its start cut (recorded flags, relocated by `m` nodes), the earlier output words,
and every digest. -/
@[reducible] def ExitAt (off c : Nat) (input : Int → BitVec 64) (S0 : State (BitVec 64)) (m : Nat) (S : State (BitVec 64)) : Prop :=
  relocState (rho m) (cutOf GenSX.ctl0 GenSX.sc0) = cutOf GenSX.ctl0 (norm S GenSX.sc0) ∧ SliceCert.Ok S ∧
  (∀ q : Int, q < 4 * (off : Int) → S.mem rOutput q = S0.mem rOutput q) ∧
  (∀ n, n < c → Digest input S (off + n))

set_option maxRecDepth 100000 in
set_option maxHeartbeats 40000000 in
/-- The loop head and `cmp x2, #2`: four steps to the state before the two `csel`. -/
theorem pre (off c : Nat) (input : Int → BitVec 64) (S0 : State (BitVec 64)) (hb : 64 * (off + c) ≤ 2 ^ 54)
    (k : Nat) (S : State (BitVec 64)) (hk : 2 * k < c) (hH : Head off c input S0 k S) :
    ∃ T' : State (BitVec 64),
      Arm.isa.run rodata prog 4 S = Arm.next (Arm.setFlags T' ((c : Int) - 2 * k) 2) ∧
      relocState (rho (off + 2 * k)) (cutOf GenSH.ctl1 GenSH.sc1) = cutOf GenSH.ctl1 T' ∧ SliceCert.Ok T' ∧
      T'.getGD 2 = gprWord ⟨0, (c : Int) - 2 * k⟩ ∧ T'.pc = 8 ∧ T'.mem = S.mem := by
  obtain ⟨hcut, hok, hcnt, hin, hpre, hdig⟩ := hH
  have hb' : 64 * (off + c) ≤ 18014398509481984 := by
    have : (2 : Nat) ^ 54 = 18014398509481984 := rfl
    omega
  have hρ := rho_ok (off + 2 * k)
  have hw : (rho (off + 2 * k)).within GenSH.B := rho_within _ (by omega)
  have hok' : SliceCert.Ok (norm S GenSH.sc0) := hok
  have sr := GenSH.seg_run _ hρ hw _ hcut hok'
  have fr := GenSH.seg_frame _ hρ hw _ hcut hok'
  have mv := GenSH.seg_moves _ hρ hw _ hcut hok' 258 258 (by simp)
  have fl : Arm.isa.run rodata prog GenSH.segLen S = (GenSH.segAt1 (norm S GenSH.sc0)).withFlags S.zf S.cf S.nf S.vf :=
    GenSH.seg_flags _ hρ hw _ hcut hok' S.zf S.cf S.nf S.vf
  rw [Reloc.var_lt _ 258 (by decide)] at mv
  generalize hT' : GenSH.segAt1 (norm S GenSH.sc0) = T' at sr fr mv fl
  obtain ⟨_, hokT, hcutT⟩ := sr
  have fT := cut_fields _ _ _ _ hcutT
  have hcntT : T'.getGD 2 = gprWord ⟨0, (c : Int) - 2 * k⟩ := by
    have e1 : envOf T' 258 = T'.getGD 2 := envOf_gdVar T' 2 (by decide)
    have e2 : envOf (norm S GenSH.sc0) 258 = (norm S GenSH.sc0).getGD 2 := envOf_gdVar _ 2 (by decide)
    rw [← e1, mv, e2]; exact hcnt
  have hpcT : T'.pc = 8 := fT.2.2.2.2.2.2.2.1.trans (by decide +kernel)
  have hhT : (T'.withFlags S.zf S.cf S.nf S.vf).halted = false := hokT.2.1
  have hcmp := Arm.exec_cmp_num rodata (T'.withFlags S.zf S.cf S.nf S.vf) 2 2 ((c : Int) - 2 * k) hhT hcntT
    (wf_num _ (by omega) (by omega))
  refine ⟨T', ?_, hcutT, hokT, hcntT, hpcT, funext fun r => funext fun q => fr r q rfl⟩
  have hl : GenSH.segLen = 3 := by decide +kernel
  rw [show 4 = GenSH.segLen + 1 by rw [hl], Isa.run_add, fl, Arm.run_one rodata prog _ hhT,
    show prog.getD (T'.withFlags S.zf S.cf S.nf S.vf).pc .nop = .cmp 2 2 by
      rw [show (T'.withFlags S.zf S.cf S.nf S.vf).pc = 8 from hpcT]; decide +kernel, hcmp]
  rfl

@ITERA@@ITERB@@ITERC@
/-- **One batch**: from the loop head before batch `k` (`2k < c`), `@IT@` steps reach the loop head
before batch `k + 1`, or the epilogue after the last batch. -/
theorem iter (off c : Nat) (input : Int → BitVec 64) (S0 : State (BitVec 64)) (hb : 64 * (off + c) ≤ 2 ^ 54)
    (k : Nat) (S : State (BitVec 64)) (hk : 2 * k < c) (hH : Head off c input S0 k S) :
    (2 * k + 2 < c → Head off c input S0 (k + 1) (Arm.isa.run rodata prog @IT@ S)) ∧
    (c ≤ 2 * k + 2 → ExitAt off c input S0 (off + 2 * k) (Arm.isa.run rodata prog @IT@ S)) := by
  refine ⟨fun h => iter_a off c input S0 hb k S (by omega) hH, fun h => ?_⟩
  rcases (by omega : c = 2 * k + 2 ∨ c = 2 * k + 1) with h2 | h1
  · exact iter_b off c input S0 hb k S h2 hH
  · exact iter_c off c input S0 hb k S h1 hH

/-- **The loop**: from the loop head before batch `k`, the remaining `d + 1` batches reach the epilogue
with every digest written. -/
theorem loop (off c : Nat) (input : Int → BitVec 64) (S0 : State (BitVec 64)) (hb : 64 * (off + c) ≤ 2 ^ 54) :
    ∀ d k (S : State (BitVec 64)), k + d + 1 = (c + 1) / 2 → Head off c input S0 k S →
      ExitAt off c input S0 (off + 2 * ((c + 1) / 2 - 1)) (Arm.isa.run rodata prog (@IT@ * (d + 1)) S) := by
  intro d
  induction d with
  | zero =>
    intro k S hk hH
    have := (iter off c input S0 hb k S (by omega) hH).2 (by omega)
    rw [show off + 2 * ((c + 1) / 2 - 1) = off + 2 * k by omega, show @IT@ * (0 + 1) = @IT@ from rfl]
    exact this
  | succ d ih =>
    intro k S hk hH
    have h1 := (iter off c input S0 hb k S (by omega) hH).1 (by omega)
    rw [show @IT@ * (d + 1 + 1) = @IT@ + @IT@ * (d + 1) by omega, Isa.run_add]
    exact ih (k + 1) _ (by omega) h1

@EPI@
@MAIN@
@LIB@
end Keccaktree.Kernels.@NS@.All
