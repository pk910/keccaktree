/-- **The loop**: from the head of batch `k`, the remaining batches. -/
theorem loop_access (off c : Nat) (input : Int → BitVec 64) (S0 : State (BitVec 64)) (hb : 64 * (off + c) ≤ 2 ^ 54)
    (hc : 3 ≤ c) (hc4 : c ≠ 4) :
    ∀ d k (S : State (BitVec 64)), k + d + 1 = nb c → Head off c input S0 k S →
      Arm.AccessRun rodata prog (4620 * (d + 1) - last c) (4 * ((off + 3 * k : Nat) : Int)) (4 * ((off + 3 * nb c : Nat) : Int)) S := by
  intro d
  induction d with
  | zero =>
    intro k S hk hH
    rw [show 4 * ((off + 3 * nb c : Nat) : Int) = 4 * ((off + 3 * k : Nat) : Int) + 12 by omega]
    rcases nb_eq c with ⟨h, h'⟩ | ⟨h, h'⟩
    · have hl : last c = 2 := by simp only [last, h, ↓reduceIte]
      rw [hl, show 4620 * (0 + 1) - 2 = 4618 from rfl]
      exact (batch_access off c input S0 hb k S (by omega) hH).2 (by omega)
    · have hl : last c = 0 := by simp only [last, h, ↓reduceIte]
      rw [hl, show 4620 * (0 + 1) - 0 = 4620 from rfl]
      exact (batch_access off c input S0 hb k S (by omega) hH).1 (by omega)
  | succ d ih =>
    intro k S hk hH
    have hlc : last c ≤ 2 := by unfold last; split <;> omega
    have h1 := iter_loop off c input S0 hb k S (by rcases nb_eq c with ⟨h, h'⟩ | ⟨h, h'⟩ <;> omega)
      (by rcases nb_eq c with ⟨h, h'⟩ | ⟨h, h'⟩ <;> omega) (by rcases nb_eq c with ⟨h, h'⟩ | ⟨h, h'⟩ <;> omega)
      (by rcases nb_eq c with ⟨h, h'⟩ | ⟨h, h'⟩ <;> omega) hH
    rw [show 4620 * (d + 1 + 1) - last c = 4620 + (4620 * (d + 1) - last c) by omega]
    apply Arm.accessRun_add rodata prog _ _ _ _ _ S ((batch_access off c input S0 hb k S
      (by rcases nb_eq c with ⟨h, h'⟩ | ⟨h, h'⟩ <;> omega) hH).1 (by rcases nb_eq c with ⟨h, h'⟩ | ⟨h, h'⟩ <;> omega))
    have := ih (k + 1) _ (by omega) h1
    rw [show ((off + 3 * (k + 1) : Nat) : Int) = (off + 3 * k : Nat) + 3 by omega] at this
    rw [show 4 * ((off + 3 * k : Nat) : Int) + 12 = 4 * (((off + 3 * k : Nat) : Int) + 3) by omega]
    exact this

