      rw [hTpc, prog_ret] at hcl; simp [Arm.reads] at hcl
    · have hTpc : T.pc = 4645 := by rw [← hT]; simp only [hr, ↓reduceIte, hpc]
      rw [hTpc, prog_tail] at hcl; simp [Arm.reads] at hcl
  · intro cl hcl
    by_cases hr : (c : Int) - 3 * nb c = 0
    · have hTpc : T.pc = 4646 := by rw [← hT]; simp only [hr, ↓reduceIte]
