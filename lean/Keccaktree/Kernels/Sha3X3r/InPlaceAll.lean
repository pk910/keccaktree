/-! ## The in-place library on `[sha3_x3r]` -/

/-- The access theorem (`LibArmAl.AccessThmArm`): the bound runs from `4·off` to `4·(off + 3·nb c)`;
at the hand-over the next kernel starts at node `off + 3·nb c`. -/
theorem access_thm : LibArmAl.AccessThmArm rodata prog 0 (fun _ c => steps c) := by
  intro off c input S hE hb hpc
  refine ⟨4 * ((off + 3 * nb c : Nat) : Int), access_all off c input S (Arm.entry_of_entryA hE hpc) hb, ?_⟩
  intro next done hdone ht hE'
  obtain ⟨-, -, -, ho⟩ := all off c input S (Arm.entry_of_entryA hE hpc) hb
  rcases ho with ⟨ht', -⟩ | ⟨-, -, hE0⟩
  · exact absurd (ht'.symm.trans ht) (by simp)
  · have hnb : 3 * nb c ≤ c := by rcases nb_eq c with ⟨h1, h2⟩ | ⟨h1, h2⟩ <;> omega
    have := LibArmAl.done_eq_of_x0 off done (3 * nb c) _ _ _ _ hE' hE0.x0 rfl (by omega) (by omega)
    omega

/-- `keccaktree_keccak256_sha3_x3r` as a kernel of the in-place library (rank 1: tail call to `keccaktree_keccak256_sha3_x2`; any flags at entry). -/
def kernelAl : Library.KernelThm Arm.alIsa.isaAl LibArmAl.EntryArmAl Digest :=
  LibArmAl.mkKernelArmAl "keccaktree_keccak256_sha3_x3r" 1 ["keccaktree_keccak256_sha3_x2"] rodata prog 0 (fun _ c => steps c)
    (Arm.flagAnn ArmFlags.sha3_x3r) ArmFlags.sha3_x3r_ok ArmFlags.entries.2.2.2.2.1 norm_thm access_thm

