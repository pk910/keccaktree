/-- **The access condition of a whole call**: from `4·off` to `4·(off + 3⌊c/3⌋)`. -/
theorem access_all (off c : Nat) (input : Int → BitVec 64) (S : State (BitVec 64))
    (hE : Entry off c input S) (hb : 64 * (off + c) ≤ 2 ^ 54) :
    Arm.AccessRun rodata prog (steps c) (4 * (off : Int)) (4 * ((off + 3 * nb c : Nat) : Int)) S := by
  have hρ := rho_ok off
  have hb54 : (2 : Nat) ^ 54 = 18014398509481984 := rfl
  have hhS : S.halted = false := hE.ok.2.1
  have hcmp := Arm.exec_cmp_num rodata S 2 3 c hhS hE.x2 (wf_num _ (by omega) (by omega))
  generalize hV0 : Arm.next (Arm.setFlags S c 3) = V0 at hcmp
  have hpc0 : S.pc = 0 := hE.ctrl.2.2.2.1
  have hhV0 : V0.halted = false := by rw [← hV0]; exact hhS
  have heV0 : V0.err = false := by rw [← hV0]; exact hE.ok.1
  have hpcV0 : V0.pc = 1 := by rw [← hV0]; show S.pc + 1 = 1; rw [hpc0]
  have hbcc := Arm.exec_bcond_eq rodata V0 .cc 4645 hhV0
  generalize hV1 : { V0 with pc := if Arm.condHolds V0 .cc then 4645 else V0.pc + 1 } = V1 at hbcc
  have hcc : Arm.condHolds V0 .cc = decide ((c : Int) < 3) := by
    rw [← hV0]; show (!decide (3 ≤ (c : Int))) = _
    by_cases h : (c : Int) < 3
    · rw [decide_eq_false (by omega), decide_eq_true h]; rfl
    · rw [decide_eq_true (by omega), decide_eq_false h]; rfl
  have hV1S : V1.mem = S.mem ∧ V1.gd = S.gd ∧ V1.g = S.g ∧ V1.k = S.k ∧ V1.vl = S.vl ∧ V1.depth = S.depth ∧
      V1.err = S.err ∧ V1.halted = false ∧ V1.tail = S.tail := by
    rw [← hV1, ← hV0]; exact ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, hhS, rfl⟩
  have hV1env : ∀ i, envOf V1 i = envOf S i := by intro i; rw [← hV1, ← hV0]; rfl
