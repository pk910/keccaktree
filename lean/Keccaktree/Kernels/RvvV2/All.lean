/-- **A batch of `2` node(s)** (`vl = 2`): from the loop head after `j` nodes with `min (c - j) 2 = 2`,
`5773` steps (head, body, back edge) hash nodes `off + j .. off + j + 1` and reach the loop head
after `j + 2` nodes, or the exit if none is left. -/
theorem batch2 (off c : Nat) (input : Int → BitVec 64) (S0 S : State (BitVec 64)) (j : Nat)
    (hb : 64 * (off + c) ≤ 2 ^ 54) (hM : Mid off c input S0 S j 7) (hj : j + 2 ≤ c) (hw : min (c - j) 2 = 2) :
    Mid off c input S0 (RV.run rodata prog 5773 S) (j + 2) (if c - j - 2 = 0 then 382 else 7) := by
  have hb' : 64 * (off + c) ≤ 18014398509481984 := by
    have : (2 : Nat) ^ 54 = 18014398509481984 := rfl
    omega
  have hr0 : 0 ≤ (c : Int) - j := by omega
  have hr1 : (c : Int) - j < 2 ^ 55 := by rw [show (2 : Int) ^ 55 = 36028797018963968 from rfl]; omega
  have hwf_in : (⟨rInput, 64 * ((off + j : Nat) : Int)⟩ : Addr).wf := by
    show 0 ≤ 64 * ((off + j : Nat) : Int) ∧ 64 * ((off + j : Nat) : Int) < 2 ^ 55
    rw [show (2 : Int) ^ 55 = 36028797018963968 from rfl]; constructor <;> omega
  have hwf_out : (⟨rOutput, 32 * ((off + j : Nat) : Int)⟩ : Addr).wf := by
    show 0 ≤ 32 * ((off + j : Nat) : Int) ∧ 32 * ((off + j : Nat) : Int) < 2 ^ 55
    rw [show (2 : Int) ^ 55 = 36028797018963968 from rfl]; constructor <;> omega
  -- head: `mv t3, a2; beqz a7; vsetvli; bnez a7`
  have hhd := run_head 2 rodata prog prog_7 prog_8 prog_12 prog_13 S ((c : Int) - j) hM.ok.2.1 hM.ctrl.2.2.2.2.2.2.1
    hM.a2 hM.a7 hr0 hr1
  have hf := H4_facts 2 S ((c : Int) - j)
  have hwn : min ((c : Int) - j).toNat 2 = 2 := by omega
  rw [hwn] at hf
  have hHenv : ∀ i, i ≠ 261 → i ≠ 284 → envOf (H4 2 S ((c : Int) - j)) i = envOf S i := fun i a b => H4_env _ _ _ i a b
  generalize hH : H4 2 S ((c : Int) - j) = H at hhd hf hHenv
  obtain ⟨hf14, hfvl, hf5, hfg, hfk, hfz, hfc, hfn, hfv, hfd, hfh, hfe, hft, hfm⟩ := hf
  have hHok : SliceCert.Ok H := ⟨hfe.trans hM.ok.1, hfh.trans hM.ok.2.1, hft.trans hM.ok.2.2⟩
  have hHin : ∀ q, H.mem rInput q = input q := fun q => by rw [hfm]; exact hM.inp q
  -- the body's start cut, at node `off + j`
  have hρ := rho_ok (off + j)
  have hc0 : relocState (rho (off + j)) (cutOf GenB2.ctl0 GenB2.sc0) = cutOf GenB2.ctl0 H := by
    apply relocState_cutOf
    · intro i hi
      simp only [GenB2.ctl0, List.mem_cons, List.mem_nil_iff, or_false] at hi
      rcases hi with rfl | rfl | rfl | rfl | rfl
      · -- t0 = vl
        rw [cutVar_const_of GenB2.ctl0 H 261 _ (by decide) ((envOf_gdVar H 5 (by decide)).trans hf5) (by decide +kernel),
          show cutVar GenB2.ctl0 GenB2.sc0 261 = .const (BitVec.ofNat 64 2) by decide +kernel, rho_const]
      · -- a0
        rw [cutVar_ptr_of GenB2.ctl0 H 266 ⟨rOutput, 32 * ((off + j : Nat) : Int)⟩ (by decide)
            ((hHenv 266 (by decide) (by decide)).trans ((envOf_gdVar S 10 (by decide)).trans hM.a0)) hwf_out (by show rOutput ≠ 0; decide),
          show cutVar GenB2.ctl0 GenB2.sc0 266 = .ptr ⟨rOutput, 0⟩ by decide +kernel, reloc_ptr_out, Int.zero_add]
      · -- a1
        rw [cutVar_ptr_of GenB2.ctl0 H 267 ⟨rInput, 64 * ((off + j : Nat) : Int)⟩ (by decide)
            ((hHenv 267 (by decide) (by decide)).trans ((envOf_gdVar S 11 (by decide)).trans hM.a1)) hwf_in (by show rInput ≠ 0; decide),
          show cutVar GenB2.ctl0 GenB2.sc0 267 = .ptr ⟨rInput, 0⟩ by decide +kernel, reloc_ptr_in, Int.zero_add]
      · -- a7 = 0
        rw [cutVar_const_of GenB2.ctl0 H 273 0#64 (by decide) ((hHenv 273 (by decide) (by decide)).trans ((envOf_gdVar S 17 (by decide)).trans hM.a7))
            (by decide +kernel),
          show cutVar GenB2.ctl0 GenB2.sc0 273 = .const 0#64 by decide +kernel, rho_const]
      · -- t5 = 1 << 63
        rw [cutVar_const_of GenB2.ctl0 H 286 0x8000000000000000#64 (by decide)
            ((hHenv 286 (by decide) (by decide)).trans ((envOf_gdVar S 30 (by decide)).trans hM.t5)) (by decide +kernel),
          show cutVar GenB2.ctl0 GenB2.sc0 286 = .const 0x8000000000000000#64 by decide +kernel, rho_const]
    · intro i hi h; simp only [GenB2.ctl0, List.mem_cons, List.mem_nil_iff, or_false] at hi; omega
    · obtain ⟨cg, ck, cz, cc, cn, cv, _, cd⟩ := hM.ctrl
      refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
      · rw [hfg, cg]; decide +kernel
      · rw [hfk, ck]; decide +kernel
      · rw [hfz, cz]; decide +kernel
      · rw [hfc, cc]; decide +kernel
      · rw [hfn, cn]; decide +kernel
      · rw [hfv, cv]; decide +kernel
      · rw [hfvl]; decide +kernel
      · rw [hf14]; decide +kernel
      · rw [hfd, cd]; decide +kernel
  -- the body
  have hw0 : (rho (off + j)).within GenB2.B := rho_within (off + j) (by omega)
  have sr := GenB2.seg_run (rho (off + j)) hρ hw0 H hc0 hHok
  have fr := GenB2.seg_frame (rho (off + j)) hρ hw0 H hc0 hHok
  have dat := GenB2.seg_data (rho (off + j)) hρ hw0 H hc0 hHok _ (inv0_2 input H (off + j) hHin)
  have mv := GenB2.seg_moves (rho (off + j)) hρ hw0 H hc0 hHok 268 268 (by simp)
  generalize hSb : GenB2.segAt25 H = Sb at sr fr dat mv
  obtain ⟨hrun, hokb, hcutb⟩ := sr
  have fb := cut_fields _ _ _ _ hcutb
  have word : ∀ v, v ∈ GenB2.ctl25 → v < 288 → cutVar GenB2.ctl25 Sb v = E.reloc (rho (off + j)) (cutVar GenB2.ctl25 GenB2.sc25 v) :=
    fun v _ hv => cut_word (rho (off + j)) hρ GenB2.ctl25 GenB2.sc25 Sb hcutb v (Or.inl hv)
  have hb5 : Sb.getGD 5 = BitVec.ofNat 64 2 := by
    have e1 := word 261 (by decide) (by decide)
    rw [show cutVar GenB2.ctl25 GenB2.sc25 261 = .const (BitVec.ofNat 64 2) by decide +kernel, rho_const] at e1
    rw [← envOf_gdVar Sb 5 (by decide)]; exact cut_const _ Sb 261 (by decide) _ e1
  have hb17 : Sb.getGD 17 = 0#64 := by
    have e1 := word 273 (by decide) (by decide)
    rw [show cutVar GenB2.ctl25 GenB2.sc25 273 = .const 0#64 by decide +kernel, rho_const] at e1
    rw [← envOf_gdVar Sb 17 (by decide)]; exact cut_const _ Sb 273 (by decide) _ e1
  have hb30 : Sb.getGD 30 = 0x8000000000000000#64 := by
    have e1 := word 286 (by decide) (by decide)
    rw [show cutVar GenB2.ctl25 GenB2.sc25 286 = .const 0x8000000000000000#64 by decide +kernel, rho_const] at e1
    rw [← envOf_gdVar Sb 30 (by decide)]; exact cut_const _ Sb 286 (by decide) _ e1
  have hb10 : Sb.getGD 10 = gprWord ⟨rOutput, 32 * ((off + (j + 2) : Nat) : Int)⟩ := by
    have e1 := word 266 (by decide) (by decide)
    rw [show cutVar GenB2.ctl25 GenB2.sc25 266 = .ptr ⟨rOutput, 64⟩ by decide +kernel, reloc_ptr_out] at e1
    rw [← envOf_gdVar Sb 10 (by decide), cut_ptr _ Sb 266 (by decide) _ e1]
    exact congrArg (fun z : Int => gprWord ⟨rOutput, z⟩) (by omega)
  have hb11 : Sb.getGD 11 = gprWord ⟨rInput, 64 * ((off + (j + 2) : Nat) : Int)⟩ := by
    have e1 := word 267 (by decide) (by decide)
    rw [show cutVar GenB2.ctl25 GenB2.sc25 267 = .ptr ⟨rInput, 128⟩ by decide +kernel, reloc_ptr_in] at e1
    rw [← envOf_gdVar Sb 11 (by decide), cut_ptr _ Sb 267 (by decide) _ e1]
    exact congrArg (fun z : Int => gprWord ⟨rInput, z⟩) (by omega)
  have hb12 : Sb.getGD 12 = gprWord ⟨0, (c : Int) - j⟩ := by
    rw [Reloc.var_lt _ 268 (by decide)] at mv
    rw [← envOf_gdVar Sb 12 (by decide), mv, hHenv 268 (by decide) (by decide), envOf_gdVar S 12 (by decide), hM.a2]
  have hpcb : Sb.pc = 380 := fb.2.2.2.2.2.2.2.1.trans (by decide +kernel)
  -- back edge: `sub a2, a2, t0; bnez a2, 7`
  have htl := run_tail 2 rodata prog 380 prog_380 prog_381 Sb ((c : Int) - j) 2 hokb.2.1 hpcb hb12 hb5 (by omega)
    (by rw [show (2 : Int) ^ 55 = 36028797018963968 from rfl]; omega)
  have hUf := T2_facts Sb ((c : Int) - j) 2
  have hUg : ∀ n, n ≠ 12 → (T2 Sb ((c : Int) - j) 2).getGD n = Sb.getGD n := fun n hn => T2_getGD _ _ _ n hn
  have hUpc := T2_pc Sb ((c : Int) - j) 2 380 hpcb
  generalize hU : T2 Sb ((c : Int) - j) 2 = U at htl hUf hUg hUpc
  obtain ⟨hU12, hUg', hUk, hUz, hUc, hUn, hUv, hUd, hUh, hUe, hUt, hUmem⟩ := hUf
  have hrunall : RV.run rodata prog 5773 S = U := by
    rw [show 5773 = 4 + GenB2.segLen + 2 by rw [body_len2], Isa.run_add, Isa.run_add, hhd, hrun, htl]
  rw [hrunall]
  obtain ⟨g1, k1, z1, c1, n1, v1, _, _, d1⟩ := fb
  refine ⟨⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩, ⟨hUe.trans hokb.1, hUh.trans hokb.2.1, hUt.trans hokb.2.2⟩,
    (hUg 10 (by decide)).trans hb10, (hUg 11 (by decide)).trans hb11, ?_, (hUg 17 (by decide)).trans hb17,
    (hUg 30 (by decide)).trans hb30, ?_, ?_, ?_⟩
  · rw [hUg', g1]; decide +kernel
  · rw [hUk, k1]; decide +kernel
  · rw [hUz, z1]; decide +kernel
  · rw [hUc, c1]; decide +kernel
  · rw [hUn, n1]; decide +kernel
  · rw [hUv, v1]; decide +kernel
  · rw [hUpc]
    by_cases hz : c - j - 2 = 0
    · rw [if_pos (by omega), if_pos hz]
    · rw [if_neg (by omega), if_neg hz]
  · rw [hUd, d1]; decide +kernel
  · rw [hU12]; exact congrArg (fun z : Int => gprWord ⟨0, z⟩) (by omega)
  · intro q; rw [hUmem, fr rInput q rfl]; exact hHin q
  · intro q hq
    rw [hUmem, fr rOutput q (by
      rw [rho_wshift_out]
      show (rOutput == 2 && decide (0 ≤ q - 4 * ((off + j : Nat) : Int)) && decide (q - 4 * ((off + j : Nat) : Int) < 8)) = false
      rw [show decide (0 ≤ q - 4 * ((off + j : Nat) : Int)) = false from decide_eq_false (by omega)]; rfl), hfm]
    exact hM.pre q hq
  · obtain ⟨o0, o1, o2, o3, o4, o5, o6, o7⟩ := dat
    have d0 : Digest input Sb (off + j + 0) := by
      apply digest_of
      intro t ht
      rcases (show t = 0 ∨ t = 1 ∨ t = 2 ∨ t = 3 by omega) with rfl | rfl | rfl | rfl
      · have := o0; dsimp only at this; rw [env_out Sb (off + j) 0 0] at this; simp only [specQuantity, specQuantity0, specQuantityCol, Nat.reduceLT, ↓reduceIte, Nat.reduceSub, Nat.reduceDiv, Nat.reduceMod, Nat.reduceAdd, Nat.reduceMul, rotl0] at this; rw [this]; exact congrArg (fun X => L X 0) (GenB2.aat_0 _)
      · have := o1; dsimp only at this; rw [env_out Sb (off + j) 0 1] at this; simp only [specQuantity, specQuantity0, specQuantityCol, Nat.reduceLT, ↓reduceIte, Nat.reduceSub, Nat.reduceDiv, Nat.reduceMod, Nat.reduceAdd, Nat.reduceMul, rotl0] at this; rw [this]; exact congrArg (fun X => L X 1) (GenB2.aat_0 _)
      · have := o2; dsimp only at this; rw [env_out Sb (off + j) 0 2] at this; simp only [specQuantity, specQuantity0, specQuantityCol, Nat.reduceLT, ↓reduceIte, Nat.reduceSub, Nat.reduceDiv, Nat.reduceMod, Nat.reduceAdd, Nat.reduceMul, rotl0] at this; rw [this]; exact congrArg (fun X => L X 2) (GenB2.aat_0 _)
      · have := o3; dsimp only at this; rw [env_out Sb (off + j) 0 3] at this; simp only [specQuantity, specQuantity0, specQuantityCol, Nat.reduceLT, ↓reduceIte, Nat.reduceSub, Nat.reduceDiv, Nat.reduceMod, Nat.reduceAdd, Nat.reduceMul, rotl0] at this; rw [this]; exact congrArg (fun X => L X 3) (GenB2.aat_0 _)
    have d1 : Digest input Sb (off + j + 1) := by
      apply digest_of
      intro t ht
      rcases (show t = 0 ∨ t = 1 ∨ t = 2 ∨ t = 3 by omega) with rfl | rfl | rfl | rfl
      · have := o4; dsimp only at this; rw [env_out Sb (off + j) 1 0] at this; simp only [specQuantity, specQuantity0, specQuantityCol, Nat.reduceLT, ↓reduceIte, Nat.reduceSub, Nat.reduceDiv, Nat.reduceMod, Nat.reduceAdd, Nat.reduceMul, rotl0] at this; rw [this]; exact congrArg (fun X => L X 0) (GenB2.aat_1 _)
      · have := o5; dsimp only at this; rw [env_out Sb (off + j) 1 1] at this; simp only [specQuantity, specQuantity0, specQuantityCol, Nat.reduceLT, ↓reduceIte, Nat.reduceSub, Nat.reduceDiv, Nat.reduceMod, Nat.reduceAdd, Nat.reduceMul, rotl0] at this; rw [this]; exact congrArg (fun X => L X 1) (GenB2.aat_1 _)
      · have := o6; dsimp only at this; rw [env_out Sb (off + j) 1 2] at this; simp only [specQuantity, specQuantity0, specQuantityCol, Nat.reduceLT, ↓reduceIte, Nat.reduceSub, Nat.reduceDiv, Nat.reduceMod, Nat.reduceAdd, Nat.reduceMul, rotl0] at this; rw [this]; exact congrArg (fun X => L X 2) (GenB2.aat_1 _)
      · have := o7; dsimp only at this; rw [env_out Sb (off + j) 1 3] at this; simp only [specQuantity, specQuantity0, specQuantityCol, Nat.reduceLT, ↓reduceIte, Nat.reduceSub, Nat.reduceDiv, Nat.reduceMod, Nat.reduceAdd, Nat.reduceMul, rotl0] at this; rw [this]; exact congrArg (fun X => L X 3) (GenB2.aat_1 _)
    intro n hn
    by_cases hnj : n < j
    · apply digest_congr input S U (off + n) _ (hM.dig n hnj)
      intro t ht
      rw [hUmem, fr rOutput _ (by
        rw [rho_wshift_out]
        show (rOutput == 2 && decide (0 ≤ (Int.ofNat (4 * (off + n) + t)) - 4 * ((off + j : Nat) : Int)) &&
          decide ((Int.ofNat (4 * (off + n) + t)) - 4 * ((off + j : Nat) : Int) < 8)) = false
        rw [show decide (0 ≤ (Int.ofNat (4 * (off + n) + t)) - 4 * ((off + j : Nat) : Int)) = false from
          decide_eq_false (by simp only [Int.ofNat_eq_coe]; omega)]; rfl), hfm]
    · rcases (show n - j = 0 ∨ n - j = 1 by omega) with h | h
      · have e : off + n = off + j + 0 := by omega
        rw [e]; exact digest_congr input Sb U _ (fun t _ => by rw [hUmem]) d0
      · have e : off + n = off + j + 1 := by omega
        rw [e]; exact digest_congr input Sb U _ (fun t _ => by rw [hUmem]) d1

/-! ## The loop -/

/-- A batch of any width `w = min (c - j) 2`. -/
theorem batch_any (off c : Nat) (input : Int → BitVec 64) (S0 S : State (BitVec 64)) (j w : Nat)
    (hb : 64 * (off + c) ≤ 2 ^ 54) (hM : Mid off c input S0 S j 7) (hj : j < c) (hw : w = min (c - j) 2) :
    Mid off c input S0 (RV.run rodata prog 5773 S) (j + w) (if c - j - w = 0 then 382 else 7) := by
  rcases (show w = 1 ∨ w = 2 by omega) with rfl | rfl
  · exact batch1 off c input S0 S j hb hM (by omega) (by omega)
  · exact batch2 off c input S0 S j hb hM (by omega) (by omega)

/-- **The loop**: from the loop head after `j` nodes with `2·d < c - j ≤ 2·(d+1)`, `d + 1` batches reach
the exit with every node done. -/
theorem loop (off c : Nat) (input : Int → BitVec 64) (S0 : State (BitVec 64)) (hb : 64 * (off + c) ≤ 2 ^ 54) :
    ∀ d j (S : State (BitVec 64)), Mid off c input S0 S j 7 → 2 * d < c - j → c - j ≤ 2 * (d + 1) →
      Mid off c input S0 (RV.run rodata prog (5773 * (d + 1)) S) c 382 := by
  intro d
  induction d with
  | zero =>
    intro j S hM h1 h2
    have h := batch_any off c input S0 S j (c - j) hb hM (by omega) (by omega)
    rw [show j + (c - j) = c by omega, if_pos (by omega)] at h
    rw [show 5773 * (0 + 1) = 5773 from rfl]; exact h
  | succ d ih =>
    intro j S hM h1 h2
    have h := batch_any off c input S0 S j 2 hb hM (by omega) (by omega)
    rw [if_neg (by omega)] at h
    rw [show 5773 * (d + 1 + 1) = 5773 + 5773 * (d + 1) by omega, Isa.run_add]
    exact ih (j + 2) _ h (by omega) (by omega)

/-! ## The whole call -/

set_option maxRecDepth 100000 in
set_option maxHeartbeats 4000000 in
/-- **The kernel on any number of nodes.** -/
theorem all (off c : Nat) (input : Int → BitVec 64) (S : State (BitVec 64)) (hE : Entry off c input S)
    (hb : 64 * (off + c) ≤ 2 ^ 54) :
    (RV.run rodata prog (8 + 5773 * ((c + 1) / 2)) S).halted = true ∧
    (RV.run rodata prog (8 + 5773 * ((c + 1) / 2)) S).err = false ∧
    (RV.run rodata prog (8 + 5773 * ((c + 1) / 2)) S).tail = none ∧
    (∀ q : Int, q < 4 * (off : Int) → (RV.run rodata prog (8 + 5773 * ((c + 1) / 2)) S).mem rOutput q = S.mem rOutput q) ∧
    ∀ n, n < c → Digest input (RV.run rodata prog (8 + 5773 * ((c + 1) / 2)) S) (off + n) := by
  rcases Nat.eq_zero_or_pos c with hc | hc
  · subst hc
    have h0 := entry_zero 2 rodata prog 380 prog_1 prog_383 off input S hE
    rw [show 8 + 5773 * ((0 + 1) / 2) = 2 + 6 by decide, Isa.run_add, h0, Isa.run_halted _ _ _ _ _ rfl]
    exact ⟨rfl, hE.ok.1, hE.ok.2.2, fun q _ => rfl, fun n hn => absurd hn (Nat.not_lt_zero _)⟩
  · have hM0 := entry_pos 2 rodata prog 380 prog_1 prog_2 prog_3 prog_4 prog_5 prog_6 off c input S hE hc hb
    have hl := loop off c input S hb ((c - 1) / 2) 0 _ hM0 (by omega) (by omega)
    generalize hX : RV.run rodata prog (5773 * ((c - 1) / 2 + 1)) (RV.run rodata prog 6 S) = X at hl
    have hx := run_exit 2 rodata prog 380 prog_382 prog_383 X hl.ok.2.1 hl.ctrl.2.2.2.2.2.2.1
    have hsteps : 8 + 5773 * ((c + 1) / 2) = 6 + 5773 * ((c - 1) / 2 + 1) + 2 := by omega
    rw [hsteps, Isa.run_add, Isa.run_add, hX, hx]
    refine ⟨rfl, ?_, ?_, ?_, ?_⟩
    · simp only [Riscv.next_err, Riscv.setR_err]; exact hl.ok.1
    · simp only [Riscv.next_tail, Riscv.setR_tail]; exact hl.ok.2.2
    · intro q hq; simp only [Riscv.next_mem, Riscv.setR_mem']; exact hl.pre q hq
    · intro n hn
      exact digest_congr input X _ _ (fun t _ => by simp only [Riscv.next_mem, Riscv.setR_mem']) (hl.dig n hn)

/-! ## In the library -/

/-- What the library needs (`LibRv.NormThmRv`): from the library's entry state (normalised control
part, `pc` at the entry), the run halts with every digest and no tail call. -/
theorem norm_thm : LibRv.NormThmRv 2 rodata prog 1 (fun _ c => 8 + 5773 * ((c + 1) / 2)) [] := by
  intro off count input S hE hb hpc
  obtain ⟨⟨g, k, z, cf, n, v, _, d⟩, hok, ha2, _, ha1, ha0, hin⟩ := hE
  have hE' : Entry off count input S := ⟨⟨g, k, z, cf, n, v, hpc, d⟩, hok, ha2, ha1, ha0, hin⟩
  obtain ⟨hh, he, ht, hp, hd⟩ := all off count input S hE' hb
  exact ⟨hh, he, hp, Or.inl ⟨ht, hd⟩⟩

/-- The kernel as a kernel of the RISC-V library at `vlmax = 2` (VLEN = 128; rank 0: it hands
nothing over; any `vl` at entry). -/
def kernel : Library.KernelThm RV LibTable.EntryRv Digest :=
  LibRv.mkKernelRv 2 (LibTable.sym "rvv") 0 [] rodata prog 1 (fun _ c => 8 + 5773 * ((c + 1) / 2))
    (Riscv.vlAnn RvVl.rvv) RvVl.rvv_ok RvVl.entries.2.2.1 norm_thm

end Keccaktree.Kernels.RvvV2.All
