/-- **`keccaktree_keccak256_rvv` at VLEN = 128 at any buffer alignment** (`LibRvU.NormThmRvU`). -/
theorem norm_thmU (mi mo : Nat) (hmi : mi < 8) (hmo : mo < 8) :
    LibRvU.NormThmRvU 2 mi mo rodata prog 1 (stepsU mi mo) := by
  unfold stepsU
  by_cases h0 : mi = 0 ∧ mo = 0
  · obtain ⟨rfl, rfl⟩ := h0
    rw [if_pos ⟨rfl, rfl⟩]
    exact LibRvU.normU_zero 2 rodata prog 1 _ All.norm_thm
  · rw [if_neg h0]
    intro off count input S hE hb hpc
    exact allM mprog mframe (by decide) (by decide) bodies mi mo off count input S hmi hmo (or_pos mi mo hmi hmo h0) hE hpc hb

/-- `keccaktree_keccak256_rvv` in the misaligned RISC-V library at VLEN = 128. -/
def kernelU (mi mo : Nat) (hmi : mi < 8) (hmo : mo < 8) :
    Library.KernelThm (Riscv.isa 2) (LibRvU.EntryRvU mi mo) (DigestB mi mo) :=
  LibRvU.mkKernelRvU 2 mi mo (LibTable.sym "rvv") 0 rodata prog 1 (stepsU mi mo) (Riscv.vlAnn RvVl.rvv)
    RvVl.rvv_ok RvVl.entries.2.2.1 (norm_thmU mi mo hmi hmo)

