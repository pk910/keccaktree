/-- The steps at byte offsets `mi`, `mo`: the aligned kernel's at `0, 0`, else the bounce path's. -/
def stepsU (mi mo : Nat) : Nat → Nat → Nat :=
  if mi = 0 ∧ mo = 0 then All.kernel.steps else fun _ c => 8 + stepsM 2 5759 c

