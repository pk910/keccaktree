/-- Exit `X2` (from instruction 1509): its segment, then `ret` at depth 0; every node is done. -/
theorem exit_X2 (off c : Nat) (input : Int → BitVec 64) (S0 U : State (BitVec 64)) (done m : Nat)
    (hcut : relocState (rho m) (cutOf GenX2.facts.ctl0 GenX2.facts.sc0) = cutOf GenX2.facts.ctl0 U)
    (hI : Inv off c input S0 U done) (hmd : off + done = m + 0) (hb : 64 * (off + c) ≤ 2 ^ 54) (hc : done + 7 = c) :
    DoneK off c input S0 U (GenX2.facts.len + 1) := by
  have hmb : 64 * m ≤ 2 ^ 54 := by omega
  obtain ⟨hok, hcutK⟩ := GenX2.facts.run (rho m) (rho_ok m) (rho_within m hmb) U hcut hI.ok
  have sr := GenX2.seg_run (rho m) (rho_ok m) (rho_within m hmb) U hcut hI.ok
  have dx := GenX2.seg_data (rho m) (rho_ok m) (rho_within m hmb) U hcut hI.ok _ (inv0_X2 input U m hI.inp)
  rw [← sr.1] at dx
  have dg := digest_X2 input _ m (fun n => absorbNode (nodeWords input (m + n.val))) (fun _ => rfl) (by exact dx)
  have hI' := hI.seg' GenX2.facts m 0 (by omega) hmb hcut (by wok_in) (by wok_out GenX2.facts)
  have hdig : ∀ n, n < done + 7 → Digest input (X86.isa.run rodata prog GenX2.facts.len U) (off + n) := by
    intro n hn
    by_cases hn' : n < done
    · exact hI'.dig n hn'
    · have := dg (n - done) (by omega)
      rw [show m + 0 + (n - done) = off + n by omega] at this
      exact this
  have fK := cut_fields _ _ _ _ hcutK
  have hr := run_ret0 rodata prog _ hok.2.1 (by rw [fK.2.2.2.2.2.2.2.1]; decide +kernel)
    (fK.2.2.2.2.2.2.2.2.trans (by decide +kernel))
  have hr2 : X86.isa.run rodata prog (GenX2.facts.len + 1) U =
      { X86.isa.run rodata prog GenX2.facts.len U with halted := true } := by rw [Isa.run_add, hr]
  apply Done.mono (k := GenX2.facts.len + 1 + 0) _ (by omega)
  apply Done.run hr2
  intro n _
  rw [Isa.run_halted _ _ _ _ _ rfl]
  exact ⟨rfl, hok.1, fun q hq => hI'.pre q hq, Or.inl ⟨hok.2.2, fun n hn => hdig n (by omega)⟩⟩


