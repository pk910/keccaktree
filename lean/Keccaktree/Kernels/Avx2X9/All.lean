/-- **One loop iteration** (flag variant `Baf`): from the loop head at node `off + done`, the body hashes
nodes `done .. done + 9` and stops before the loop control, the count register unchanged. -/
theorem body_Baf (off c : Nat) (input : Int → BitVec 64) (S0 S : State (BitVec 64)) (done : Nat)
    (hcut : relocState (rho (off + done)) (cutOf GenBaf.facts.ctl0 GenBaf.facts.sc0) = cutOf GenBaf.facts.ctl0 S)
    (hI : Inv off c input S0 S done) (hb : 64 * (off + done + 9) ≤ 2 ^ 54) :
    relocState (rho (off + done)) (cutOf GenBb.facts.ctlK GenBb.facts.scK) =
      cutOf GenBb.facts.ctlK (X86.isa.run rodata prog (GenBaf.facts.len + GenBb.facts.len) S) ∧
    Inv off c input S0 (X86.isa.run rodata prog (GenBaf.facts.len + GenBb.facts.len) S) (done + 9) ∧
    envOf (X86.isa.run rodata prog (GenBaf.facts.len + GenBb.facts.len) S) 258 = envOf S 258 := by
  have hmb : 64 * (off + done) ≤ 2 ^ 54 := by omega
  have hρ := rho_ok (off + done)
  have hw := rho_within (off + done) hmb
  obtain ⟨ok1, cut1⟩ := GenBaf.facts.run _ hρ hw S hcut hI.ok
  have sr1 := GenBaf.seg_run _ hρ hw S hcut hI.ok
  have da := GenBaf.seg_data _ hρ hw S hcut hI.ok _ (inv0_Baf input S (off + done) hI.inp)
  rw [← sr1.1] at da
  have cut2 := seg_chain GenBaf.facts GenBb.facts _ hρ _ cut1 (by decide +kernel) (by decide +kernel) (by decide +kernel)
  obtain ⟨ok2, cut3⟩ := GenBb.facts.run _ hρ hw _ cut2 ok1
  have sr2 := GenBb.seg_run _ hρ hw _ cut2 ok1
  have db := GenBb.seg_data _ hρ hw _ cut2 ok1 (GenBaf.AAt (fun n => absorbNode (nodeWords input (off + done + n.val))) 3) (by exact da)
  rw [← sr2.1] at db
  have dg := digest_Bb input _ (off + done) (fun n => absorbNode (nodeWords input (off + done + n.val)))
    (GenBaf.AAt (fun n => absorbNode (nodeWords input (off + done + n.val))) 3) (fun _ => rfl) (fun n => match n with
    | ⟨0, _⟩ => fun _ _ => GenBaf.aat_0 _
    | ⟨1, _⟩ => fun _ _ => GenBaf.aat_1 _
    | ⟨2, _⟩ => fun _ _ => GenBaf.aat_2 _
    | ⟨3, _⟩ => fun _ _ => GenBaf.aat_3 _
    | ⟨4, _⟩ => fun _ _ => GenBaf.aat_4 _
    | ⟨5, _⟩ => fun _ _ => GenBaf.aat_5 _
    | ⟨6, _⟩ => fun _ _ => GenBaf.aat_6 _
    | ⟨7, _⟩ => fun _ _ => GenBaf.aat_7 _
    | ⟨8, _⟩ => fun _ _ => GenBaf.aat_8 _
    | ⟨n + 9, _⟩ => fun h1 _ => absurd h1 (by simp only [Fin.val_mk]; omega)) (by exact db)
  have I1 := hI.seg GenBaf.facts (off + done) (by omega) hmb hcut (by wok_in) (by wok_out GenBaf.facts)
  have I2 := I1.seg GenBb.facts (off + done) (by omega) hmb cut2 (by wok_in) (by wok_out GenBb.facts)
  rw [Isa.run_add]
  refine ⟨cut3, ⟨I2.ok, I2.inp, I2.pre, fun n hn => ?_⟩, ?_⟩
  · by_cases hn' : n < done
    · exact I2.dig n hn'
    · have := dg (n - done) (by omega)
      rw [show off + done + 0 + (n - done) = off + n by omega] at this
      exact this
  · exact (GenBb.facts_rdx _ hρ hw _ cut2 ok1).trans (GenBaf.facts_rdx _ hρ hw _ hcut hI.ok)


