theorem body_Bat (off c : Nat) (input : Int → BitVec 64) (S0 S : State (BitVec 64)) (done : Nat)
    (hcut : relocState (rho (off + done)) (cutOf GenBat.facts.ctl0 GenBat.facts.sc0) = cutOf GenBat.facts.ctl0 S)
