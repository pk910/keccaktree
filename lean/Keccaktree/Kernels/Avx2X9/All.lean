    relocState (rho (off + done)) (cutOf GenBb.facts.ctlK GenBb.facts.scK) =
      cutOf GenBb.facts.ctlK (X86.isa.run rodata prog (GenBat.facts.len + GenBb.facts.len) S) ∧
    Inv off c input S0 (X86.isa.run rodata prog (GenBat.facts.len + GenBb.facts.len) S) (done + 9) ∧
    envOf (X86.isa.run rodata prog (GenBat.facts.len + GenBb.facts.len) S) 258 = envOf S 258 := by
  have hmb : 64 * (off + done) ≤ 2 ^ 54 := by omega
  have hρ := rho_ok (off + done)
  have hw := rho_within (off + done) hmb
  obtain ⟨ok1, cut1⟩ := GenBat.facts.run _ hρ hw S hcut hI.ok
  have sr1 := GenBat.seg_run _ hρ hw S hcut hI.ok
  have da := GenBat.seg_data _ hρ hw S hcut hI.ok _ (inv0_Bat input S (off + done) hI.inp)
  rw [← sr1.1] at da
  have cut2 := seg_chain GenBat.facts GenBb.facts _ hρ _ cut1 (by decide +kernel) (by decide +kernel) (by decide +kernel)
  obtain ⟨ok2, cut3⟩ := GenBb.facts.run _ hρ hw _ cut2 ok1
  have sr2 := GenBb.seg_run _ hρ hw _ cut2 ok1
  have db := GenBb.seg_data _ hρ hw _ cut2 ok1 (GenBat.AAt (fun n => absorbNode (nodeWords input (off + done + n.val))) 3) (by exact da)
  rw [← sr2.1] at db
