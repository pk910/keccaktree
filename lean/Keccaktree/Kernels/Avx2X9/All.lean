  have I1 := hI.seg GenBat.facts (off + done) (by omega) hmb hcut (by wok_in) (by wok_out GenBat.facts)
  have I2 := I1.seg GenBb.facts (off + done) (by omega) hmb cut2 (by wok_in) (by wok_out GenBb.facts)
  rw [Isa.run_add]
