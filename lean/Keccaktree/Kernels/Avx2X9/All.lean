    (GenBat.AAt (fun n => absorbNode (nodeWords input (off + done + n.val))) 3) (fun _ => rfl) (fun n => match n with
    | ⟨0, _⟩ => fun _ _ => GenBat.aat_0 _
    | ⟨1, _⟩ => fun _ _ => GenBat.aat_1 _
    | ⟨2, _⟩ => fun _ _ => GenBat.aat_2 _
    | ⟨3, _⟩ => fun _ _ => GenBat.aat_3 _
    | ⟨4, _⟩ => fun _ _ => GenBat.aat_4 _
    | ⟨5, _⟩ => fun _ _ => GenBat.aat_5 _
    | ⟨6, _⟩ => fun _ _ => GenBat.aat_6 _
    | ⟨7, _⟩ => fun _ _ => GenBat.aat_7 _
