  have hlen : 4529 = GenSB.segLen + 1 + 1 + 1 := by decide +kernel
  rw [hlen, Isa.run_add, Isa.run_add, Isa.run_add, fl, hrunVs, hrunVc, hrunU]
  have hcs : Arm.condHolds Vc .cs = decide (3 ≤ (c : Int) - 3 * k - 3) := by rw [← hVc]; rfl
  have hUmem : U.mem = Sb'.mem := by rw [← hU, ← hVc, ← hVs, ← hSb]; rfl
  have hUpc : U.pc = if decide (3 ≤ (c : Int) - 3 * k - 3) then 12 else 4541 := by
    rw [← hU]; show (if Arm.condHolds Vc .cs then 12 else Vc.pc + 1) = _
