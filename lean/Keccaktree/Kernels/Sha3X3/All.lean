/-- The batch's write condition is false outside its nodes' output words and the stack. -/
theorem wok_out (q : Int) (h : q < 0 ∨ 12 ≤ q) :
    ((rOutput == 3) || (rOutput == 2 && decide (0 ≤ q) && decide (q < 4 * 3))) = false := by
  rcases h with h | h
  · rw [show decide (0 ≤ q) = false from decide_eq_false (by omega)]; rfl
  · rw [show decide (q < 4 * 3) = false from decide_eq_false (by omega)]
    cases decide (0 ≤ q) <;> rfl

/-- The loop head before batch `k`: with the recorded flags, the batch's start cut relocated by
`off + 3k`; the count `c - 3k` in `x2`, the message, the earlier output words, the digests done. -/
@[reducible] def Head (off c : Nat) (input : Int → BitVec 64) (S0 : State (BitVec 64)) (k : Nat) (S : State (BitVec 64)) : Prop :=
  relocState (rho (off + 3 * k)) (cutOf GenSB.ctl0 GenSB.sc0) = cutOf GenSB.ctl0 (norm S GenSB.sc0) ∧ SliceCert.Ok S ∧
  S.getGD 2 = gprWord ⟨0, (c : Int) - 3 * k⟩ ∧ (∀ q, S.mem rInput q = input q) ∧
  (∀ q : Int, q < 4 * (off : Int) → S.mem rOutput q = S0.mem rOutput q) ∧
  (∀ n, n < 3 * k → Digest input S (off + n))

/-- The epilogue after the last batch (relocation `m` of the recorded epilogue): the count `c mod 3`
left, the message, the earlier output words, the digests of the `3⌊c/3⌋` nodes done. -/
@[reducible] def ExitAt (off c : Nat) (input : Int → BitVec 64) (S0 : State (BitVec 64)) (m : Nat) (S : State (BitVec 64)) : Prop :=
  relocState (rho m) (cutOf GenSX.ctl0 GenSX.sc0) = cutOf GenSX.ctl0 (norm S GenSX.sc0) ∧ SliceCert.Ok S ∧
  S.getGD 2 = gprWord ⟨0, (c : Int) - 3 * (c / 3)⟩ ∧ (∀ q, S.mem rInput q = input q) ∧
  (∀ q : Int, q < 4 * (off : Int) → S.mem rOutput q = S0.mem rOutput q) ∧
  (∀ n, n < 3 * (c / 3) → Digest input S (off + n))

