    intro i hi
    rw [← hSbenv i, ← Arm.envOf_setGD_other Sb 2 i (gprWord ⟨0, (c : Int) - 3 * k - 3⟩) (by omega), ← hU, ← hVc, ← hVs]; rfl
  have hUcnt : U.getGD 2 = gprWord ⟨0, (c : Int) - 3 * k - 3⟩ := by rw [← hU, ← hVc]; exact hVsx2
  have hUg : U.g = Sb'.g.setIfInBounds 2 ⟨0, 0⟩ := by rw [← hU, ← hVc, ← hVs, ← hSb]; rfl
  have hUc : U.k = Sb'.k ∧ U.vl = Sb'.vl ∧ U.depth = Sb'.depth := by
    rw [← hU, ← hVc, ← hVs, ← hSb]; exact ⟨rfl, rfl, rfl⟩
  have hUok : SliceCert.Ok U := by rw [← hU, ← hVc, ← hVs, ← hSb]; exact hokb
  have hUo : ∀ q, U.mem rOutput q = Sb'.mem rOutput q := by intro q; rw [hUmem]
  have hbi : ∀ q, U.mem rInput q = input q := by intro q; rw [hUmem, fr rInput q rfl]; exact hin q
  have hbo : ∀ q : Int, q - 4 * ((off + 3 * k : Nat) : Int) < 0 → Sb'.mem rOutput q = S.mem rOutput q := by
    intro q hq
    apply fr rOutput q
    rw [rho_wshift_out]
    exact wok_out _ (Or.inl hq)
  have hpre' : ∀ q : Int, q < 4 * (off : Int) → U.mem rOutput q = S0.mem rOutput q := by
    intro q hq; rw [hUo, hbo q (by omega)]; exact hpre q hq
  have hdig' : ∀ n, n < 3 * k + 3 → Digest input U (off + n) := by
    intro n hn
    by_cases hnk : n < 3 * k
    · apply digest_congr input S U (off + n) _ (hdig n hnk)
      intro w hw; rw [hUo]; exact hbo _ (by simp only [Int.ofNat_eq_coe]; omega)
    · rcases (by omega : n = 3 * k + 0 ∨ n = 3 * k + 1 ∨ n = 3 * k + 2) with rfl | rfl | rfl
      · rw [show off + (3 * k + 0) = (off + 3 * k) + 0 by omega]
        exact digest_congr input Sb' U _ (fun w _ => hUo _) (dig0 input Sb' (off + 3 * k) dat)
      · rw [show off + (3 * k + 1) = (off + 3 * k) + 1 by omega]
        exact digest_congr input Sb' U _ (fun w _ => hUo _) (dig1 input Sb' (off + 3 * k) dat)
      · rw [show off + (3 * k + 2) = (off + 3 * k) + 2 by omega]
        exact digest_congr input Sb' U _ (fun w _ => hUo _) (dig2 input Sb' (off + 3 * k) dat)
  have hL : ∀ (sc : State (BitVec 64)) (L' : List Nat), (L'.all fun i => decide (i ≠ 258)) = true →
      ∀ i ∈ L', envOf (norm U sc) i = envOf Sb' i := by
    intro sc L' hL' i hi
    have hne : i ≠ 258 := by have := List.all_eq_true.mp hL' i hi; simpa using this
    exact hUenv i hne
  refine ⟨fun hk1 => ?_, fun hk1 => ?_⟩
  · -- back to the loop head, three nodes further
    have hz : decide (3 ≤ (c : Int) - 3 * k - 3) = true := decide_eq_true (by omega)
    refine ⟨?_, hUok, ?_, hbi, hpre', fun n hn => hdig' n (by omega)⟩
    · rw [show off + 3 * (k + 1) = (off + 3 * k) + 3 by omega, ← rho_add]
      apply cut_transfer (rho (off + 3 * k)) _ hρ (Reloc.add_ok _ _ hρ (rho_ok 3)) GenSB.ctl24 GenSB.ctl0 GenSB.sc24 GenSB.sc0 Sb'
        (norm U GenSB.sc0) hcutb (hL_dec _ _ (by decide +kernel)) (hL GenSB.sc0 _ (by decide +kernel))
        (hval_succ _ _ hρ (rho_ok 3) _ _ _ _ (by decide +kernel))
      refine ⟨?_, ?_, rfl, rfl, rfl, rfl, ?_, ?_, ?_⟩
      · show U.g = _; rw [hUg, fb.1]; decide +kernel
      · show U.k = _; rw [hUc.1, fb.2.1]; decide +kernel
      · show U.vl = _; rw [hUc.2.1, fb.2.2.2.2.2.2.1]; decide +kernel
      · show U.pc = _; rw [hUpc, hz]; decide +kernel
      · show U.depth = _; rw [hUc.2.2, fb.2.2.2.2.2.2.2.2]; decide +kernel
    · rw [hUcnt]; exact congrArg (fun z : Int => gprWord ⟨0, z⟩) (by omega)
  · -- the last batch: on to the epilogue
    have hz : decide (3 ≤ (c : Int) - 3 * k - 3) = false := decide_eq_false (by omega)
    have hk3 : c / 3 = k + 1 := by omega
    refine ⟨?_, hUok, ?_, hbi, hpre', fun n hn => hdig' n (by omega)⟩
    · apply cut_transfer (rho (off + 3 * k)) _ hρ hρ GenSB.ctl24 GenSX.ctl0 GenSB.sc24 GenSX.sc0 Sb' (norm U GenSX.sc0) hcutb
        (hL_dec _ _ (by decide +kernel)) (hL GenSX.sc0 _ (by decide +kernel)) (hval_same _ _ _ _ _ (by decide +kernel))
      refine ⟨?_, ?_, rfl, rfl, rfl, rfl, ?_, ?_, ?_⟩
      · show U.g = _; rw [hUg, fb.1]; decide +kernel
      · show U.k = _; rw [hUc.1, fb.2.1]; decide +kernel
      · show U.vl = _; rw [hUc.2.1, fb.2.2.2.2.2.2.1]; decide +kernel
      · show U.pc = _; rw [hUpc, hz]; decide +kernel
      · show U.depth = _; rw [hUc.2.2, fb.2.2.2.2.2.2.2.2]; decide +kernel
    · rw [hUcnt]; exact congrArg (fun z : Int => gprWord ⟨0, z⟩) (by omega)

/-- **The loop**: from the loop head before batch `k`, the remaining `d + 1` batches reach the epilogue. -/
theorem loop (off c : Nat) (input : Int → BitVec 64) (S0 : State (BitVec 64)) (hb : 64 * (off + c) ≤ 2 ^ 54) :
    ∀ d k (S : State (BitVec 64)), k + d + 1 = c / 3 → Head off c input S0 k S →
      ExitAt off c input S0 (off + 3 * (c / 3 - 1)) (Arm.isa.run rodata prog (4529 * (d + 1)) S) := by
  intro d
  induction d with
  | zero =>
    intro k S hk hH
    have := (iter off c input S0 hb k S (by omega) hH).2 (by omega)
    rw [show off + 3 * (c / 3 - 1) = off + 3 * k by omega, show 4529 * (0 + 1) = 4529 from rfl]
    exact this
  | succ d ih =>
    intro k S hk hH
    have h1 := (iter off c input S0 hb k S (by omega) hH).1 (by omega)
    rw [show 4529 * (d + 1 + 1) = 4529 + 4529 * (d + 1) by omega, Isa.run_add]
    exact ih (k + 1) _ (by omega) h1

/-- What a call ends in: every node done (`ret`), or the tail call to `keccaktree_keccak256_scalar_x1` from its entry state at
node `off + done` with the `count - done` remaining nodes (`done = 3⌊count/3⌋`). -/
@[reducible] def Outcome (off c : Nat) (input : Int → BitVec 64) (S Sf : State (BitVec 64)) : Prop :=
  Sf.halted = true ∧ Sf.err = false ∧ (∀ q : Int, q < 4 * (off : Int) → Sf.mem rOutput q = S.mem rOutput q) ∧
  ((Sf.tail = none ∧ ∀ n, n < c → Digest input Sf (off + n)) ∨
   (Sf.tail = some "keccaktree_keccak256_scalar_x1" ∧ (∀ n, n < 3 * (c / 3) → Digest input Sf (off + n)) ∧
     Arm.Entry (off + 3 * (c / 3)) (c - 3 * (c / 3)) input { Sf with halted := false, tail := none, pc := 0 }))

theorem prog_cbz : prog.getD 4551 .nop = .cbz 2 4553 := by decide +kernel
theorem prog_tail : prog.getD 4552 .nop = .tailcall "keccaktree_keccak256_scalar_x1" := by decide +kernel
theorem prog_ret : prog.getD 4553 .nop = .ret := by decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 40000000 in
/-- **The epilogue**: the `ldp` restores, then `cbz x2`: `ret` (no node left) or the tail call with the
pointers advanced past the batches and `sp` restored. -/
theorem epilogue (off c : Nat) (input : Int → BitVec 64) (S0 : State (BitVec 64)) (hb : 64 * (off + c) ≤ 2 ^ 54) (hc : 3 ≤ c)
    (U : State (BitVec 64)) (hX : ExitAt off c input S0 (off + 3 * (c / 3 - 1)) U) :
    Outcome off c input S0 (Arm.isa.run rodata prog 12 U) := by
  obtain ⟨hcut, hok, hcnt, hin, hpre, hdig⟩ := hX
  have hb' : 64 * (off + c) ≤ 18014398509481984 := by
    have : (2 : Nat) ^ 54 = 18014398509481984 := rfl
    omega
  have hρ := rho_ok (off + 3 * (c / 3 - 1))
  have hw : (rho (off + 3 * (c / 3 - 1))).within GenSX.B := rho_within _ (by omega)
  have hok' : SliceCert.Ok (norm U GenSX.sc0) := hok
  have sr := GenSX.seg_run _ hρ hw _ hcut hok'
  have fr := GenSX.seg_frame _ hρ hw _ hcut hok'
  have mv := GenSX.seg_moves _ hρ hw _ hcut hok' 258 258 (by simp)
  have fl : Arm.isa.run rodata prog GenSX.segLen U = (GenSX.segAt1 (norm U GenSX.sc0)).withFlags U.zf U.cf U.nf U.vf :=
    GenSX.seg_flags _ hρ hw _ hcut hok' U.zf U.cf U.nf U.vf
  rw [Reloc.var_lt _ 258 (by decide)] at mv
  generalize hSx' : GenSX.segAt1 (norm U GenSX.sc0) = Sx' at sr fr mv fl
  obtain ⟨_, hokx, hcutx⟩ := sr
  have fx := cut_fields _ _ _ _ hcutx
  generalize hSx : Sx'.withFlags U.zf U.cf U.nf U.vf = Sx at fl
  have hpc : Sx.pc = 4551 := by rw [← hSx]; exact fx.2.2.2.2.2.2.2.1.trans (by decide +kernel)
  have hhx : Sx.halted = false := by rw [← hSx]; exact hokx.2.1
  have hmem : ∀ r q, Sx.mem r q = U.mem r q := by intro r q; rw [← hSx]; exact fr r q rfl
  have hx2 : Sx.getGD 2 = gprWord ⟨0, (c : Int) - 3 * (c / 3)⟩ := by
    have e1 : envOf Sx' 258 = Sx'.getGD 2 := envOf_gdVar Sx' 2 (by decide)
    have e2 : envOf (norm U GenSX.sc0) 258 = (norm U GenSX.sc0).getGD 2 := envOf_gdVar _ 2 (by decide)
    rw [← hSx]; show Sx'.getGD 2 = _
    rw [← e1, mv, e2]; exact hcnt
  -- the hand-over registers at the end of the epilogue (closed control words, relocated)
  have hptr : ∀ (v n : Nat) (a : Addr), v < 288 → v = 256 + n → n < 32 → v ∈ GenSX.ctl1 →
      E.reloc (rho (off + 3 * (c / 3 - 1))) (cutVar GenSX.ctl1 GenSX.sc1 v) = .ptr a → Sx.getGD n = gprWord a := by
    intro v n a hv hvn hn hmemv h
    have e1 := cut_word _ hρ GenSX.ctl1 GenSX.sc1 Sx' hcutx v (Or.inl hv)
    rw [h] at e1
    rw [← hSx]; show Sx'.getGD n = _
    rw [← envOf_gdVar Sx' n hn, ← hvn]
    exact cut_ptr GenSX.ctl1 Sx' v hmemv a e1
  have hsp : Sx.getGD 31 = gprWord ⟨rStack, 1048576⟩ :=
    hptr 287 31 _ (by decide) rfl (by decide) (by decide +kernel)
      (by rw [show cutVar GenSX.ctl1 GenSX.sc1 287 = .ptr ⟨rStack, 1048576⟩ by decide +kernel, reloc_ptr_stack])
  have hx0 : Sx.getGD 0 = gprWord ⟨rOutput, 32 * ((off + 3 * (c / 3) : Nat) : Int)⟩ :=
    hptr 256 0 _ (by decide) rfl (by decide) (by decide +kernel)
      (by rw [show cutVar GenSX.ctl1 GenSX.sc1 256 = .ptr ⟨rOutput, 96⟩ by decide +kernel, reloc_ptr_out]
          exact congrArg (fun z : Int => E.ptr ⟨rOutput, z⟩) (by omega))
  have hx1 : Sx.getGD 1 = gprWord ⟨rInput, 64 * ((off + 3 * (c / 3) : Nat) : Int)⟩ :=
    hptr 257 1 _ (by decide) rfl (by decide) (by decide +kernel)
      (by rw [show cutVar GenSX.ctl1 GenSX.sc1 257 = .ptr ⟨rInput, 192⟩ by decide +kernel, reloc_ptr_in]
          exact congrArg (fun z : Int => E.ptr ⟨rInput, z⟩) (by omega))
  -- cbz x2
  have hcbz := Arm.exec_cbz_num rodata Sx 2 4553 ((c : Int) - 3 * (c / 3)) hhx hx2 (wf_num _ (by omega) (by omega))
  have hl : GenSX.segLen = 10 := by decide +kernel
  generalize hT : { Sx with pc := if (c : Int) - 3 * (c / 3) = 0 then 4553 else Sx.pc + 1 } = T at hcbz
  have hrunT : Arm.isa.run rodata prog (10 + 1) U = T := by
    rw [show 10 + 1 = GenSX.segLen + 1 by rw [hl], Isa.run_add, fl, Arm.run_one rodata prog Sx hhx,
      show prog.getD Sx.pc .nop = .cbz 2 4553 by rw [hpc]; exact prog_cbz, hcbz]
  have hhT : T.halted = false := by rw [← hT]; exact hhx
  rw [show 12 = (10 + 1) + 1 by rfl, Isa.run_add, hrunT, Arm.run_one rodata prog T hhT]
  have hokT : T.err = false := by rw [← hT, ← hSx]; exact hokx.1
  by_cases hr : (c : Int) - 3 * (c / 3) = 0
  · -- every node done: ret
    have hTpc : T.pc = 4553 := by rw [← hT]; simp only [hr, ↓reduceIte]
    rw [show prog.getD T.pc .nop = .ret by rw [hTpc]; exact prog_ret, Arm.exec_ret_eq rodata T hhT]
    refine ⟨rfl, hokT, fun q hq => ?_, Or.inl ⟨?_, fun n hn => ?_⟩⟩
    · show T.mem rOutput q = _; rw [← hT, hmem]; exact hpre q hq
    · show T.tail = none; rw [← hT, ← hSx]; exact hokx.2.2
    · show Digest input T (off + n)
      rw [← hT]
      exact digest_congr input U _ _ (fun w _ => hmem _ _) (hdig n (by omega))
  · -- the remaining nodes: the tail call
    have hTpc : T.pc = 4552 := by rw [← hT]; simp only [hr, ↓reduceIte, hpc]
    rw [show prog.getD T.pc .nop = .tailcall "keccaktree_keccak256_scalar_x1" by rw [hTpc]; exact prog_tail, Arm.exec_tailcall_eq rodata T _ hhT]
    refine ⟨rfl, hokT, fun q hq => ?_, Or.inr ⟨rfl, fun n hn => ?_, ?_⟩⟩
    · show T.mem rOutput q = _; rw [← hT, hmem]; exact hpre q hq
    · show Digest input T (off + n)
      rw [← hT]
      exact digest_congr input U _ _ (fun w _ => hmem _ _) (hdig n hn)
    · refine ⟨⟨?_, ?_, ?_, rfl, ?_⟩, ⟨hokT, rfl, rfl⟩, ?_, ?_, ?_, ?_, ?_⟩
      · show T.g = _; rw [← hT, ← hSx]; show Sx'.g = _; rw [fx.1]; decide +kernel
      · show T.k = _; rw [← hT, ← hSx]; show Sx'.k = _; rw [fx.2.1]; decide +kernel
      · show T.vl = _; rw [← hT, ← hSx]; show Sx'.vl = _; rw [fx.2.2.2.2.2.2.1]; decide +kernel
      · show T.depth = _; rw [← hT, ← hSx]; show Sx'.depth = _; rw [fx.2.2.2.2.2.2.2.2]; decide +kernel
      · show T.getGD 2 = _; rw [← hT]; show Sx.getGD 2 = _; rw [hx2]; exact congrArg (fun z : Int => gprWord ⟨0, z⟩) (by omega)
      · show T.getGD 31 = _; rw [← hT]; exact hsp
      · show T.getGD 1 = _; rw [← hT]; exact hx1
      · show T.getGD 0 = _; rw [← hT]; exact hx0
      · intro q; show T.mem rInput q = _; rw [← hT, hmem]; exact hin q

theorem prog_0 : prog.getD 0 .nop = .cmp 2 3 := by decide +kernel
theorem prog_1 : prog.getD 1 .nop = .bcond .cc 4552 := by decide +kernel

/-- The number of steps of a call on `c` nodes. -/
def steps (c : Nat) : Nat := (if c < 3 then 3 else 24 + 4529 * (c / 3))

set_option maxRecDepth 100000 in
set_option maxHeartbeats 40000000 in
/-- **`keccaktree_keccak256_sha3_x3` on any number of nodes.** -/
theorem all (off c : Nat) (input : Int → BitVec 64) (S : State (BitVec 64))
    (hE : Entry off c input S) (hb : 64 * (off + c) ≤ 2 ^ 54) :
    Outcome off c input S (Arm.isa.run rodata prog (steps c) S) := by
  have hρ := rho_ok off
  have hb54 : (2 : Nat) ^ 54 = 18014398509481984 := rfl
  have hhS : S.halted = false := hE.ok.2.1
  -- cmp x2, #3 ; b.cc tail
  have hcmp := Arm.exec_cmp_num rodata S 2 3 c hhS hE.x2 (wf_num _ (by omega) (by omega))
  generalize hV0 : Arm.next (Arm.setFlags S c 3) = V0 at hcmp
  have hpc0 : S.pc = 0 := hE.ctrl.2.2.2.1
  have hrun0 : Arm.isa.run rodata prog 1 S = V0 := by
    rw [Arm.run_one rodata prog S hhS, show prog.getD S.pc .nop = .cmp 2 3 by rw [hpc0]; exact prog_0, hcmp]
  have hhV0 : V0.halted = false := by rw [← hV0]; exact hhS
  have hpcV0 : V0.pc = 1 := by rw [← hV0]; show S.pc + 1 = 1; rw [hpc0]
  have hrun1 : Arm.isa.run rodata prog 1 V0 = { V0 with pc := if Arm.condHolds V0 .cc then 4552 else V0.pc + 1 } := by
    rw [Arm.run_one rodata prog V0 hhV0, show prog.getD V0.pc .nop = .bcond .cc 4552 by rw [hpcV0]; exact prog_1]
    exact Arm.exec_bcond_eq rodata V0 .cc 4552 hhV0
  generalize hV1 : { V0 with pc := if Arm.condHolds V0 .cc then 4552 else V0.pc + 1 } = V1 at hrun1
  have hcc : Arm.condHolds V0 .cc = decide ((c : Int) < 3) := by
    rw [← hV0]; show (!decide (3 ≤ (c : Int))) = _
    by_cases h : (c : Int) < 3
    · rw [decide_eq_false (by omega), decide_eq_true h]; rfl
    · rw [decide_eq_true (by omega), decide_eq_false h]; rfl
  have h2 : Arm.isa.run rodata prog 2 S = V1 := by rw [show 2 = 1 + 1 from rfl, Isa.run_add, hrun0, hrun1]
  have hV1S : V1.mem = S.mem ∧ V1.gd = S.gd ∧ V1.g = S.g ∧ V1.k = S.k ∧ V1.vl = S.vl ∧ V1.depth = S.depth ∧
      V1.err = S.err ∧ V1.halted = false ∧ V1.tail = S.tail := by
    rw [← hV1, ← hV0]; exact ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, hhS, rfl⟩
  have hV1env : ∀ i, envOf V1 i = envOf S i := by intro i; rw [← hV1, ← hV0]; rfl
  have hV1gd : ∀ n, V1.getGD n = S.getGD n := by intro n; rw [← hV1, ← hV0]; rfl
  by_cases hc3 : c < 3
  · -- fewer than three nodes: the tail call with the call's registers
    have hpcV1 : V1.pc = 4552 := by
      rw [← hV1]; show (if Arm.condHolds V0 .cc then 4552 else V0.pc + 1) = _
      rw [hcc, decide_eq_true (by omega)]; rfl
    have hsteps : steps c = 2 + 1 := by simp only [steps, hc3, ↓reduceIte]
    rw [hsteps, Isa.run_add, h2, Arm.run_one rodata prog V1 hV1S.2.2.2.2.2.2.2.1,
      show prog.getD V1.pc .nop = .tailcall "keccaktree_keccak256_scalar_x1" by rw [hpcV1]; exact prog_tail,
      Arm.exec_tailcall_eq rodata V1 _ hV1S.2.2.2.2.2.2.2.1]
    have hc0 : c / 3 = 0 := by omega
    refine ⟨rfl, by show V1.err = false; rw [hV1S.2.2.2.2.2.2.1]; exact hE.ok.1,
      fun q _ => by show V1.mem rOutput q = _; rw [hV1S.1], Or.inr ⟨rfl, fun n hn => by omega, ?_⟩⟩
    rw [hc0]
    simp only [Nat.mul_zero, Nat.add_zero, Nat.sub_zero]
    obtain ⟨g, k, l, p, d⟩ := hE.ctrl
    refine ⟨⟨?_, ?_, ?_, rfl, ?_⟩, ⟨?_, rfl, rfl⟩, ?_, ?_, ?_, ?_, ?_⟩
    · show V1.g = _; rw [hV1S.2.2.1, g]
    · show V1.k = _; rw [hV1S.2.2.2.1, k]
    · show V1.vl = _; rw [hV1S.2.2.2.2.1, l]
    · show V1.depth = _; rw [hV1S.2.2.2.2.2.1, d]
    · show V1.err = _; rw [hV1S.2.2.2.2.2.2.1]; exact hE.ok.1
    · show V1.getGD 2 = _; rw [hV1gd]; exact hE.x2
    · show V1.getGD 31 = _; rw [hV1gd]; exact hE.sp
    · show V1.getGD 1 = _; rw [hV1gd]; exact hE.x1
    · show V1.getGD 0 = _; rw [hV1gd]; exact hE.x0
    · intro q; show V1.mem rInput q = _; rw [hV1S.1]; exact hE.inp q
  · -- the frame, the batches, the epilogue
    have hpcV1 : V1.pc = 2 := by
      rw [← hV1]; show (if Arm.condHolds V0 .cc then 4552 else V0.pc + 1) = _
      rw [hcc, decide_eq_false (by omega), hpcV0]; rfl
    have hwf_in : (⟨rInput, 64 * (off : Int)⟩ : Addr).wf := by
      show 0 ≤ 64 * (off : Int) ∧ 64 * (off : Int) < 2 ^ 55
      rw [show (2 : Int) ^ 55 = 36028797018963968 from rfl]; constructor <;> omega
    have hwf_out : (⟨rOutput, 32 * (off : Int)⟩ : Addr).wf := by
      show 0 ≤ 32 * (off : Int) ∧ 32 * (off : Int) < 2 ^ 55
      rw [show (2 : Int) ^ 55 = 36028797018963968 from rfl]; constructor <;> omega
    have hc1 : relocState (rho off) (cutOf GenSE1.ctl0 GenSE1.sc0) = cutOf GenSE1.ctl0 (norm V1 GenSE1.sc0) := by
      apply relocState_cutOf (rho off) GenSE1.ctl0 GenSE1.sc0 (norm V1 GenSE1.sc0)
      · intro i hi
        simp only [GenSE1.ctl0, List.mem_cons, List.mem_nil_iff, or_false] at hi
        rcases hi with rfl | rfl | rfl
        · rw [cutVar_ptr_of GenSE1.ctl0 (norm V1 GenSE1.sc0) 256 ⟨rOutput, 32 * (off : Int)⟩ (by decide)
            ((envOf_gdVar (norm V1 GenSE1.sc0) 0 (by decide)).trans ((hV1gd 0).trans hE.x0)) hwf_out (by show rOutput ≠ 0; decide),
            show cutVar GenSE1.ctl0 GenSE1.sc0 256 = .ptr ⟨rOutput, 0⟩ by decide +kernel, reloc_ptr_out, Int.zero_add]
        · rw [cutVar_ptr_of GenSE1.ctl0 (norm V1 GenSE1.sc0) 257 ⟨rInput, 64 * (off : Int)⟩ (by decide)
            ((envOf_gdVar (norm V1 GenSE1.sc0) 1 (by decide)).trans ((hV1gd 1).trans hE.x1)) hwf_in (by show rInput ≠ 0; decide),
            show cutVar GenSE1.ctl0 GenSE1.sc0 257 = .ptr ⟨rInput, 0⟩ by decide +kernel, reloc_ptr_in, Int.zero_add]
        · rw [cutVar_ptr_of GenSE1.ctl0 (norm V1 GenSE1.sc0) 287 ⟨rStack, 1048576⟩ (by decide)
            ((envOf_gdVar (norm V1 GenSE1.sc0) 31 (by decide)).trans ((hV1gd 31).trans hE.sp)) (by decide) (by decide),
            show cutVar GenSE1.ctl0 GenSE1.sc0 287 = .ptr ⟨rStack, 1048576⟩ by decide +kernel, reloc_ptr_stack]
      · intro i hi h; simp only [GenSE1.ctl0, List.mem_cons, List.mem_nil_iff, or_false] at hi; omega
      · obtain ⟨g, k, l, p, d⟩ := hE.ctrl
        refine ⟨?_, ?_, rfl, rfl, rfl, rfl, ?_, ?_, ?_⟩
        · show V1.g = _; rw [hV1S.2.2.1, g]; decide +kernel
        · show V1.k = _; rw [hV1S.2.2.2.1, k]; decide +kernel
        · show V1.vl = _; rw [hV1S.2.2.2.2.1, l]; decide +kernel
        · show V1.pc = _; rw [hpcV1]; decide +kernel
        · show V1.depth = _; rw [hV1S.2.2.2.2.2.1, d]; decide +kernel
    have hw0 : (rho off).within (2 ^ 54) := rho_within off (by omega)
    have hok1 : SliceCert.Ok (norm V1 GenSE1.sc0) := ⟨by show V1.err = false; rw [hV1S.2.2.2.2.2.2.1]; exact hE.ok.1,
      hV1S.2.2.2.2.2.2.2.1, by show V1.tail = none; rw [hV1S.2.2.2.2.2.2.2.2]; exact hE.ok.2.2⟩
    have s1 := GenSE1.seg_run (rho off) hρ hw0 _ hc1 hok1
