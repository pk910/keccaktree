/-- **A batch of `3` node(s)** (`vl = 3`): from the loop head after `j` nodes with `min (c - j) 4 = 3`,
`5773` steps (head, body, back edge) hash nodes `off + j .. off + j + 2` and reach the loop head
after `j + 3` nodes, or the exit if none is left. -/
theorem batch3 (ch : Nat → Nat) (off c : Nat) (input : Int → BitVec 64) (S0 S : State (BitVec 64)) (j : Nat)
    (hb : 64 * (off + c) ≤ 2 ^ 54) (hM : Mid off c input S0 S j 7) (hj : j + 3 ≤ c) (hw : ch (c - j) = 3) :
    Mid off c input S0 ((RVc ch).run rodata prog 5773 S) (j + 3) (if c - j - 3 = 0 then 382 else 7) := by
  have hb' : 64 * (off + c) ≤ 18014398509481984 := by
    have : (2 : Nat) ^ 54 = 18014398509481984 := rfl
    omega
  have hr0 : 0 ≤ (c : Int) - j := by omega
