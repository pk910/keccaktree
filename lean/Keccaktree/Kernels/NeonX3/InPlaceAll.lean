/-- **The access condition of a whole call**: from `4·off` to `4·(off + 3⌊c/3⌋)`. -/
theorem access_all (off c : Nat) (input : Int → BitVec 64) (S : State (BitVec 64))
    (hE : Entry off c input S) (hb : 64 * (off + c) ≤ 2 ^ 54) :
    Arm.AccessRun rodata prog (steps c) (4 * (off : Int)) (4 * ((off + 3 * (c / 3) : Nat) : Int)) S := by
  have hρ := rho_ok off
  have hb54 : (2 : Nat) ^ 54 = 18014398509481984 := rfl
  have hhS : S.halted = false := hE.ok.2.1
  have hcmp := Arm.exec_cmp_num rodata S 2 3 c hhS hE.x2 (wf_num _ (by omega) (by omega))
  generalize hV0 : Arm.next (Arm.setFlags S c 3) = V0 at hcmp
  have hpc0 : S.pc = 0 := hE.ctrl.2.2.2.1
  have hhV0 : V0.halted = false := by rw [← hV0]; exact hhS
  have heV0 : V0.err = false := by rw [← hV0]; exact hE.ok.1
  have hpcV0 : V0.pc = 1 := by rw [← hV0]; show S.pc + 1 = 1; rw [hpc0]
  have hbcc := Arm.exec_bcond_eq rodata V0 .cc 6236 hhV0
  generalize hV1 : { V0 with pc := if Arm.condHolds V0 .cc then 6236 else V0.pc + 1 } = V1 at hbcc
  have hcc : Arm.condHolds V0 .cc = decide ((c : Int) < 3) := by
    rw [← hV0]; show (!decide (3 ≤ (c : Int))) = _
    by_cases h : (c : Int) < 3
    · rw [decide_eq_false (by omega), decide_eq_true h]; rfl
    · rw [decide_eq_true (by omega), decide_eq_false h]; rfl
  have hV1S : V1.mem = S.mem ∧ V1.gd = S.gd ∧ V1.g = S.g ∧ V1.k = S.k ∧ V1.vl = S.vl ∧ V1.depth = S.depth ∧
      V1.err = S.err ∧ V1.halted = false ∧ V1.tail = S.tail := by
    rw [← hV1, ← hV0]; exact ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, hhS, rfl⟩
  have hV1env : ∀ i, envOf V1 i = envOf S i := by intro i; rw [← hV1, ← hV0]; rfl
  have hV1gd : ∀ n, V1.getGD n = S.getGD n := by intro n; rw [← hV1, ← hV0]; rfl
  have heV1 : V1.err = false := hV1S.2.2.2.2.2.2.1.trans hE.ok.1
  -- `cmp`, `b.cc`: no memory
  have a2 : ∀ (m : Nat) (bf : Int), Arm.AccessRun rodata prog m (4 * (off : Int)) bf V1 →
      Arm.AccessRun rodata prog (m + 1 + 1) (4 * (off : Int)) bf S := by
    intro m bf hrest
    apply Arm.accessRun_step rodata prog _ _ _ S hhS
    · rw [hpc0, prog_0, hcmp]; exact heV0
    · intro cl hc; rw [hpc0, prog_0] at hc; simp [Arm.reads] at hc
    · intro cl hc; rw [hpc0, prog_0] at hc; simp [Arm.writes] at hc
    rw [hpc0, prog_0, hcmp]
    apply Arm.accessRun_step rodata prog _ _ _ V0 hhV0
    · rw [hpcV0, prog_1, hbcc]; exact heV1
    · intro cl hc; rw [hpcV0, prog_1] at hc; simp [Arm.reads] at hc
    · intro cl hc; rw [hpcV0, prog_1] at hc; simp [Arm.writes] at hc
    rw [hpcV0, prog_1, hbcc]; exact hrest
  by_cases hc3 : c < 3
  · -- the tail call with the call's registers
    have hpcV1 : V1.pc = 6236 := by
      rw [← hV1]; show (if Arm.condHolds V0 .cc then 6236 else V0.pc + 1) = _
      rw [hcc, decide_eq_true (by omega)]; rfl
    have hsteps : steps c = 0 + 1 + 1 + 1 := by simp only [steps, hc3, ↓reduceIte]
    rw [hsteps, show ((off + 3 * (c / 3) : Nat) : Int) = (off : Int) by
      have : c / 3 = 0 := by omega
      rw [this]; simp]
    apply a2
    apply Arm.accessRun_step rodata prog _ _ _ V1 hV1S.2.2.2.2.2.2.2.1
    · rw [hpcV1, prog_tail, Arm.exec_tailcall_eq rodata V1 _ hV1S.2.2.2.2.2.2.2.1]; exact heV1
    · intro cl hc; rw [hpcV1, prog_tail] at hc; simp [Arm.reads] at hc
    · intro cl hc; rw [hpcV1, prog_tail] at hc; simp [Arm.writes] at hc
    · exact Int.le_refl _
  · have hpcV1 : V1.pc = 2 := by
      rw [← hV1]; show (if Arm.condHolds V0 .cc then 6236 else V0.pc + 1) = _
      rw [hcc, decide_eq_false (by omega), hpcV0]; rfl
    have hwf_in : (⟨rInput, 64 * (off : Int)⟩ : Addr).wf := by
      show 0 ≤ 64 * (off : Int) ∧ 64 * (off : Int) < 2 ^ 55
      rw [show (2 : Int) ^ 55 = 36028797018963968 from rfl]; constructor <;> omega
    have hwf_out : (⟨rOutput, 32 * (off : Int)⟩ : Addr).wf := by
      show 0 ≤ 32 * (off : Int) ∧ 32 * (off : Int) < 2 ^ 55
      rw [show (2 : Int) ^ 55 = 36028797018963968 from rfl]; constructor <;> omega
    have hc1 : relocState (rho off) (cutOf GenSE1.ctl0 GenSE1.sc0) = cutOf GenSE1.ctl0 (norm V1 GenSE1.sc0) := by
      apply relocState_cutOf (rho off) GenSE1.ctl0 GenSE1.sc0 (norm V1 GenSE1.sc0)
      · intro i hi
        simp only [GenSE1.ctl0, List.mem_cons, List.mem_nil_iff, or_false] at hi
        rcases hi with rfl | rfl | rfl
        · rw [cutVar_ptr_of GenSE1.ctl0 (norm V1 GenSE1.sc0) 256 ⟨rOutput, 32 * (off : Int)⟩ (by decide)
            ((envOf_gdVar (norm V1 GenSE1.sc0) 0 (by decide)).trans ((hV1gd 0).trans hE.x0)) hwf_out (by show rOutput ≠ 0; decide),
            show cutVar GenSE1.ctl0 GenSE1.sc0 256 = .ptr ⟨rOutput, 0⟩ by decide +kernel, reloc_ptr_out, Int.zero_add]
        · rw [cutVar_ptr_of GenSE1.ctl0 (norm V1 GenSE1.sc0) 257 ⟨rInput, 64 * (off : Int)⟩ (by decide)
            ((envOf_gdVar (norm V1 GenSE1.sc0) 1 (by decide)).trans ((hV1gd 1).trans hE.x1)) hwf_in (by show rInput ≠ 0; decide),
            show cutVar GenSE1.ctl0 GenSE1.sc0 257 = .ptr ⟨rInput, 0⟩ by decide +kernel, reloc_ptr_in, Int.zero_add]
        · rw [cutVar_ptr_of GenSE1.ctl0 (norm V1 GenSE1.sc0) 287 ⟨rStack, 1048576⟩ (by decide)
            ((envOf_gdVar (norm V1 GenSE1.sc0) 31 (by decide)).trans ((hV1gd 31).trans hE.sp)) (by decide) (by decide),
            show cutVar GenSE1.ctl0 GenSE1.sc0 287 = .ptr ⟨rStack, 1048576⟩ by decide +kernel, reloc_ptr_stack]
      · intro i hi h; simp only [GenSE1.ctl0, List.mem_cons, List.mem_nil_iff, or_false] at hi; omega
      · obtain ⟨g, k, l, p, d⟩ := hE.ctrl
        refine ⟨?_, ?_, rfl, rfl, rfl, rfl, ?_, ?_, ?_⟩
        · show V1.g = _; rw [hV1S.2.2.1, g]; decide +kernel
