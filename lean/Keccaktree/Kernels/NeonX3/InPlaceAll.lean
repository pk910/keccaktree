/-- The epilogue (`ldp` restores, `cbz`, `ret` or the tail call) touches neither input nor output. -/
theorem exit_access (off c : Nat) (input : Int → BitVec 64) (S0 : State (BitVec 64)) (hb : 64 * (off + c) ≤ 2 ^ 54) (hc : 3 ≤ c)
    (U : State (BitVec 64)) (hX : ExitAt off c input S0 (off + 3 * (c / 3 - 1)) U) (b : Int) :
    Arm.AccessRun rodata prog 12 b b U := by
  obtain ⟨hcut, hok, hcnt, hin, hpre, hdig⟩ := hX
  have hb' : 64 * (off + c) ≤ 18014398509481984 := by
    have : (2 : Nat) ^ 54 = 18014398509481984 := rfl
    omega
  have hρ := rho_ok (off + 3 * (c / 3 - 1))
  have hw : (rho (off + 3 * (c / 3 - 1))).within GenSX.B := rho_within _ (by omega)
  have hok' : SliceCert.Ok (norm U GenSX.sc0) := hok
  have sr := GenSX.seg_run _ hρ hw _ hcut hok'
  have ft0 := cut_fields _ _ _ _ hcut
  have hseg : Arm.AccessRun rodata prog GenSX.segLen b b U :=
    Arm.accessRun_ann rodata prog annIP annIP_ok _ _ _ U (norm U GenSX.sc0) (Arm.ovr_all_flags U _ _ _ _)
      (by rw [ft0.2.2.2.2.2.2.2.1]; decide +kernel) (by rw [sr.1]; exact sr.2.1.1)
      (by have := Arm.alIsa.seg1_access GenSX.cert0 _ hρ hw _ hcut hok' InPlace.GenSX.sum0 b; exact this)
  have mv := GenSX.seg_moves _ hρ hw _ hcut hok' 258 258 (by simp)
  have fl : Arm.isa.run rodata prog GenSX.segLen U = (GenSX.segAt1 (norm U GenSX.sc0)).withFlags U.zf U.cf U.nf U.vf :=
    GenSX.seg_flags _ hρ hw _ hcut hok' U.zf U.cf U.nf U.vf
  rw [Reloc.var_lt _ 258 (by decide)] at mv
  generalize hSx' : GenSX.segAt1 (norm U GenSX.sc0) = Sx' at sr mv fl
  obtain ⟨_, hokx, hcutx⟩ := sr
  have fx := cut_fields _ _ _ _ hcutx
  generalize hSx : Sx'.withFlags U.zf U.cf U.nf U.vf = Sx at fl
  have hpc : Sx.pc = 6235 := by rw [← hSx]; exact fx.2.2.2.2.2.2.2.1.trans (by decide +kernel)
  have hhx : Sx.halted = false := by rw [← hSx]; exact hokx.2.1
  have hex : Sx.err = false := by rw [← hSx]; exact hokx.1
  have hx2 : Sx.getGD 2 = gprWord ⟨0, (c : Int) - 3 * (c / 3)⟩ := by
    have e1 : envOf Sx' 258 = Sx'.getGD 2 := envOf_gdVar Sx' 2 (by decide)
    have e2 : envOf (norm U GenSX.sc0) 258 = (norm U GenSX.sc0).getGD 2 := envOf_gdVar _ 2 (by decide)
    rw [← hSx]; show Sx'.getGD 2 = _
    rw [← e1, mv, e2]; exact hcnt
  have hcbz := Arm.exec_cbz_num rodata Sx 2 6237 ((c : Int) - 3 * (c / 3)) hhx hx2 (wf_num _ (by omega) (by omega))
  generalize hT : { Sx with pc := if (c : Int) - 3 * (c / 3) = 0 then 6237 else Sx.pc + 1 } = T at hcbz
  have hhT : T.halted = false := by rw [← hT]; exact hhx
  have heT : T.err = false := by rw [← hT]; exact hex
  rw [show 12 = GenSX.segLen + ((0 + 1) + 1) by decide +kernel]
  apply Arm.accessRun_add rodata prog _ _ _ _ _ U hseg
  rw [fl]
  apply Arm.accessRun_step rodata prog _ _ _ Sx hhx
  · rw [hpc, prog_cbz, hcbz]; exact heT
  · intro cl hc; rw [hpc, prog_cbz] at hc; simp [Arm.reads] at hc
  · intro cl hc; rw [hpc, prog_cbz] at hc; simp [Arm.writes] at hc
  rw [hpc, prog_cbz, hcbz]
  apply Arm.accessRun_step rodata prog _ _ _ T hhT
  · by_cases hr : (c : Int) - 3 * (c / 3) = 0
    · have hTpc : T.pc = 6237 := by rw [← hT]; simp only [hr, ↓reduceIte]
      rw [hTpc, prog_ret, Arm.exec_ret_eq rodata T hhT]; exact heT
    · have hTpc : T.pc = 6236 := by rw [← hT]; simp only [hr, ↓reduceIte, hpc]
      rw [hTpc, prog_tail, Arm.exec_tailcall_eq rodata T _ hhT]; exact heT
  · intro cl hcl
    by_cases hr : (c : Int) - 3 * (c / 3) = 0
    · have hTpc : T.pc = 6237 := by rw [← hT]; simp only [hr, ↓reduceIte]
      rw [hTpc, prog_ret] at hcl; simp [Arm.reads] at hcl
    · have hTpc : T.pc = 6236 := by rw [← hT]; simp only [hr, ↓reduceIte, hpc]
      rw [hTpc, prog_tail] at hcl; simp [Arm.reads] at hcl
  · intro cl hcl
    by_cases hr : (c : Int) - 3 * (c / 3) = 0
    · have hTpc : T.pc = 6237 := by rw [← hT]; simp only [hr, ↓reduceIte]
      rw [hTpc, prog_ret] at hcl; simp [Arm.writes] at hcl
    · have hTpc : T.pc = 6236 := by rw [← hT]; simp only [hr, ↓reduceIte, hpc]
      rw [hTpc, prog_tail] at hcl; simp [Arm.writes] at hcl
  · exact Int.le_refl _

