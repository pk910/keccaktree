/-- Flags dirty everywhere except at the flag readers (`b.cc` at 1, `b.cs` at 6224). -/
abbrev annIP : Nat → Dom := Arm.flagAnn [(0, 1), (2, 6224), (6225, 6238)]

theorem annIP_ok : Arm.AnnOk prog annIP := Arm.flagAnnOk_sound _ _ (by decide +kernel)

