/-- **One batch** at node `m = off + 3k`: inputs at or above `8m`, outputs below `4m + 12`; then `sub`,
`cmp`, `b.cs` (no memory). -/
theorem batch_access (off c : Nat) (input : Int → BitVec 64) (S0 : State (BitVec 64)) (hb : 64 * (off + c) ≤ 2 ^ 54)
    (k : Nat) (S : State (BitVec 64)) (hk : 3 * k + 3 ≤ c) (hH : Head off c input S0 k S) :
    Arm.AccessRun rodata prog 6213 (4 * ((off + 3 * k : Nat) : Int)) (4 * ((off + 3 * k : Nat) : Int) + 12) S := by
  obtain ⟨hcut, hok, hcnt, hin, hpre, hdig⟩ := hH
  have hb' : 64 * (off + c) ≤ 18014398509481984 := by
    have : (2 : Nat) ^ 54 = 18014398509481984 := rfl
    omega
  have hρ := rho_ok (off + 3 * k)
  have hw : (rho (off + 3 * k)).within GenSB.B := rho_within (off + 3 * k) (by omega)
  have hok' : SliceCert.Ok (norm S GenSB.sc0) := hok
  have sr := GenSB.seg_run (rho (off + 3 * k)) hρ hw _ hcut hok'
  have ft0 := cut_fields _ _ _ _ hcut
  have aBN : Arm.AccessRun rodata prog GenSB.segLen (4 * ((off + 3 * k : Nat) : Int)) (4 * ((off + 3 * k : Nat) : Int) + 12)
      (norm S GenSB.sc0) := by
    rw [← InPlace.GenSB.len]
    apply Arm.alIsa.chain_access (rho (off + 3 * k)) hρ hw InPlace.GenSB.certs _ _ _ InPlace.GenSB.chain
      (by intro C hC; simp only [InPlace.GenSB.certs, List.head?_cons, Option.mem_def, Option.some.injEq] at hC; subst hC; exact hcut)
      hok'
    rw [InPlace.GenSB.sums, rho_wshift_in, rho_wshift_out]
    simp only [SummOk, nextB]
    simp [SummOk, nextB] <;> omega
  have aB : Arm.AccessRun rodata prog GenSB.segLen (4 * ((off + 3 * k : Nat) : Int)) (4 * ((off + 3 * k : Nat) : Int) + 12) S :=
    Arm.accessRun_ann rodata prog annIP annIP_ok _ _ _ S (norm S GenSB.sc0) (Arm.ovr_all_flags S _ _ _ _)
      (by rw [ft0.2.2.2.2.2.2.2.1]; decide +kernel) (by rw [sr.1]; exact sr.2.1.1) aBN
  have mv := GenSB.seg_moves (rho (off + 3 * k)) hρ hw _ hcut hok' 258 258 (by simp)
  have fl : Arm.isa.run rodata prog GenSB.segLen S =
      (GenSB.segAt24 (norm S GenSB.sc0)).withFlags S.zf S.cf S.nf S.vf :=
    GenSB.seg_flags (rho (off + 3 * k)) hρ hw _ hcut hok' S.zf S.cf S.nf S.vf
  rw [Reloc.var_lt _ 258 (by decide)] at mv
  generalize hSb' : GenSB.segAt24 (norm S GenSB.sc0) = Sb' at sr mv fl
  obtain ⟨_, hokb, hcutb⟩ := sr
  have fb := cut_fields _ _ _ _ hcutb
  generalize hSb : Sb'.withFlags S.zf S.cf S.nf S.vf = Sb at fl
  have hSbenv : ∀ i, envOf Sb i = envOf Sb' i := by intro i; rw [← hSb]; rfl
  have hhb : Sb.halted = false := by rw [← hSb]; exact hokb.2.1
  have heb : Sb.err = false := by rw [← hSb]; exact hokb.1
  have hpcb : Sb.pc = 6222 := by rw [← hSb]; exact fb.2.2.2.2.2.2.2.1.trans (by decide +kernel)
  have hcntb : Sb.getGD 2 = gprWord ⟨0, (c : Int) - 3 * k⟩ := by
    have e1 : envOf Sb 258 = Sb.getGD 2 := envOf_gdVar Sb 2 (by decide)
    have e2 : envOf (norm S GenSB.sc0) 258 = (norm S GenSB.sc0).getGD 2 := envOf_gdVar _ 2 (by decide)
    rw [← e1, hSbenv, mv, e2]; exact hcnt
  have hsub := Arm.exec_sub_num rodata Sb 2 2 3 ((c : Int) - 3 * k) hhb hcntb (wf_num _ (by omega) (by omega))
  generalize hVs : Arm.next (Sb.setGD 2 (gprWord ⟨0, (c : Int) - 3 * k - 3⟩)) = Vs at hsub
  have hpcVs : Vs.pc = 6223 := by rw [← hVs]; show Sb.pc + 1 = 6223; rw [hpcb]
  have hhVs : Vs.halted = false := by rw [← hVs]; exact hhb
  have heVs : Vs.err = false := by rw [← hVs]; exact heb
  have hVsx2 : Vs.getGD 2 = gprWord ⟨0, (c : Int) - 3 * k - 3⟩ := by
    rw [← hVs]; exact Arm.getGD_setGD_same Sb 2 _ (by decide)
  have hcmp := Arm.exec_cmp_num rodata Vs 2 3 ((c : Int) - 3 * k - 3) hhVs hVsx2 (wf_num _ (by omega) (by omega))
  generalize hVc : Arm.next (Arm.setFlags Vs ((c : Int) - 3 * k - 3) 3) = Vc at hcmp
  have hpcVc : Vc.pc = 6224 := by rw [← hVc]; show Vs.pc + 1 = 6224; rw [hpcVs]
  have hhVc : Vc.halted = false := by rw [← hVc]; exact hhVs
  have heVc : Vc.err = false := by rw [← hVc]; exact heVs
  rw [show 6213 = GenSB.segLen + (0 + 1 + 1 + 1) by decide +kernel]
  apply Arm.accessRun_add rodata prog _ _ _ _ _ S aB
  rw [fl]
  apply Arm.accessRun_step rodata prog _ _ _ Sb hhb
  · rw [hpcb, show prog.getD 6222 .nop = .sub 2 2 3 by decide +kernel, hsub]; exact heVs
  · intro cl hc; rw [hpcb, show prog.getD 6222 .nop = .sub 2 2 3 by decide +kernel] at hc; simp [Arm.reads] at hc
  · intro cl hc; rw [hpcb, show prog.getD 6222 .nop = .sub 2 2 3 by decide +kernel] at hc; simp [Arm.writes] at hc
  rw [hpcb, show prog.getD 6222 .nop = .sub 2 2 3 by decide +kernel, hsub]
  apply Arm.accessRun_step rodata prog _ _ _ Vs hhVs
  · rw [hpcVs, show prog.getD 6223 .nop = .cmp 2 3 by decide +kernel, hcmp]; exact heVc
  · intro cl hc; rw [hpcVs, show prog.getD 6223 .nop = .cmp 2 3 by decide +kernel] at hc; simp [Arm.reads] at hc
  · intro cl hc; rw [hpcVs, show prog.getD 6223 .nop = .cmp 2 3 by decide +kernel] at hc; simp [Arm.writes] at hc
  rw [hpcVs, show prog.getD 6223 .nop = .cmp 2 3 by decide +kernel, hcmp]
  apply Arm.accessRun_step rodata prog _ _ _ Vc hhVc
  · rw [hpcVc, show prog.getD 6224 .nop = .bcond .cs 12 by decide +kernel, Arm.exec_bcond_eq rodata Vc .cs 12 hhVc]; exact heVc
  · intro cl hc; rw [hpcVc, show prog.getD 6224 .nop = .bcond .cs 12 by decide +kernel] at hc; simp [Arm.reads] at hc
  · intro cl hc; rw [hpcVc, show prog.getD 6224 .nop = .bcond .cs 12 by decide +kernel] at hc; simp [Arm.writes] at hc
  exact Int.le_refl _

/-- **The loop**: from the head of batch `k`, the remaining batches. -/
theorem loop_access (off c : Nat) (input : Int → BitVec 64) (S0 : State (BitVec 64)) (hb : 64 * (off + c) ≤ 2 ^ 54) :
    ∀ d k (S : State (BitVec 64)), k + d + 1 = c / 3 → Head off c input S0 k S →
      Arm.AccessRun rodata prog (6213 * (d + 1)) (4 * ((off + 3 * k : Nat) : Int)) (4 * ((off + 3 * (c / 3) : Nat) : Int)) S := by
  intro d
  induction d with
  | zero =>
    intro k S hk hH
    have := batch_access off c input S0 hb k S (by omega) hH
    rw [show 6213 * (0 + 1) = 6213 from rfl, show 4 * ((off + 3 * (c / 3) : Nat) : Int) = 4 * ((off + 3 * k : Nat) : Int) + 12 by omega]
    exact this
  | succ d ih =>
    intro k S hk hH
    have h1 := (iter off c input S0 hb k S (by omega) hH).1 (by omega)
    rw [show 6213 * (d + 1 + 1) = 6213 + 6213 * (d + 1) by omega]
    apply Arm.accessRun_add rodata prog _ _ _ _ _ S (batch_access off c input S0 hb k S (by omega) hH)
    have := ih (k + 1) _ (by omega) h1
    rw [show ((off + 3 * (k + 1) : Nat) : Int) = (off + 3 * k : Nat) + 3 by omega] at this
    rw [show 4 * ((off + 3 * k : Nat) : Int) + 12 = 4 * (((off + 3 * k : Nat) : Int) + 3) by omega]
    exact this

