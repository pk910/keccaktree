/-- The access theorem (`LibArmAl.AccessThmArm`): the bound runs from `4·off` to `4·(off + 3⌊c/3⌋)`;
at the hand-over the next kernel starts at node `off + 3⌊c/3⌋`. -/
theorem access_thm : LibArmAl.AccessThmArm rodata prog 0 (fun _ c => steps c) := by
  intro off c input S hE hb hpc
  refine ⟨4 * ((off + 3 * (c / 3) : Nat) : Int), access_all off c input S (Arm.entry_of_entryA hE hpc) hb, ?_⟩
  intro next done hdone ht hE'
  obtain ⟨-, -, -, ho⟩ := all off c input S (Arm.entry_of_entryA hE hpc) hb
  rcases ho with ⟨ht', -⟩ | ⟨-, -, hE0⟩
  · exact absurd (ht'.symm.trans ht) (by simp)
  · have := LibArmAl.done_eq_of_x0 off done (3 * (c / 3)) _ _ _ _ hE' hE0.x0 rfl (by omega) (by omega)
    omega

