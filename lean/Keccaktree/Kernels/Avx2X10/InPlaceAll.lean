/-- **The loop in place**: from the loop control after `k + 1` iterations. -/
theorem afterBA (off c : Nat) (input : Int → BitVec 64) (S0 : State (BitVec 64)) (hb : 64 * (off + c) ≤ 2 ^ 54) :
    ∀ j k (T : State (BitVec 64)), c - 10 * (k + 1) ≤ j → 10 * (k + 1) ≤ c →
      relocState (rho (off + 10 * k)) (cutOf GenBb.facts.ctlK GenBb.facts.scK) = cutOf GenBb.facts.ctlK T →
      Inv off c input S0 T (10 * (k + 1)) → T.getGD 2 = BitVec.ofInt 64 ((c : Int) - 10 * (k : Int)) → (c ≠ 12 ∧ c ≠ 16) →
      DoneAK off c input T (LI * (c - 10 * (k + 1)) + XM) (4 * ((off + 10 * (k + 1) : Nat) : Int)) := by
  intro j
  induction j with
  | zero =>
    intro k T hj hk hcut hI hrdx hE
    exact afterBA_step off c input S0 hb k T hk hcut hI hrdx hE (fun hcont => absurd hcont (by omega))
  | succ j ih =>
    intro k T hj hk hcut hI hrdx hE
    exact afterBA_step off c input S0 hb k T hk hcut hI hrdx hE (fun hcont T' hcut' hI' hrdx' hE' =>
      ih (k + 1) T' (by omega) (by omega) hcut' hI' hrdx' hE')

