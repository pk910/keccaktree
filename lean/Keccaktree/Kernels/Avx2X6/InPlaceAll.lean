  have a1 : AccessRun rodata prog GenBaf.facts.len (4 * ((off + done : Nat) : Int)) (4 * ((off + done : Nat) : Int)) S :=
    seg_acc GenBaf.facts InPlace.GenBaf.certs InPlace.GenBaf.len InPlace.GenBaf.chain (by hd_tac InPlace.GenBaf.certs) (off + done) hw S hcut hI.ok (4 * ((off + done : Nat) : Int)) (4 * ((off + done : Nat) : Int))
        (by sum_tac InPlace.GenBaf.sums)
  have a2 : AccessRun rodata prog GenBb.facts.len (4 * ((off + done : Nat) : Int)) (4 * ((off + done : Nat) : Int) + 24) (X86.isa.run rodata prog GenBaf.facts.len S) :=
