    relocState (rho (off + done)) (cutOf GenBb.facts.ctlK GenBb.facts.scK) =
      cutOf GenBb.facts.ctlK (X86.isa.run rodata prog (GenBatm.facts.len + GenBb.facts.len) S) ∧
    Inv off c input S0 (X86.isa.run rodata prog (GenBatm.facts.len + GenBb.facts.len) S) (done + 8) ∧
    envOf (X86.isa.run rodata prog (GenBatm.facts.len + GenBb.facts.len) S) 258 = envOf S 258 := by
  have hmb : 64 * (off + done) ≤ 2 ^ 54 := by omega
  have hρ := rho_ok (off + done)
  have hw := rho_within (off + done) hmb
  obtain ⟨ok1, cut1⟩ := GenBatm.facts.run _ hρ hw S hcut hI.ok
  have sr1 := GenBatm.seg_run _ hρ hw S hcut hI.ok
  have da := GenBatm.seg_data _ hρ hw S hcut hI.ok _ (inv0_Batm input S (off + done) hI.inp)
  rw [← sr1.1] at da
  have cut2 := seg_chain GenBatm.facts GenBb.facts _ hρ _ cut1 (by decide +kernel) (by decide +kernel) (by decide +kernel)
  obtain ⟨ok2, cut3⟩ := GenBb.facts.run _ hρ hw _ cut2 ok1
  have sr2 := GenBb.seg_run _ hρ hw _ cut2 ok1
  have db := GenBb.seg_data _ hρ hw _ cut2 ok1 (GenBatm.AAt (fun n => absorbNode (nodeWords input (off + done + n.val))) 6) (by exact da)
  rw [← sr2.1] at db
  have dg := digest_Bb input _ (off + done) (fun n => absorbNode (nodeWords input (off + done + n.val)))
    (GenBatm.AAt (fun n => absorbNode (nodeWords input (off + done + n.val))) 6) (fun _ => rfl) (fun n => match n with
    | ⟨0, _⟩ => fun _ _ => GenBatm.aat_0 _
    | ⟨1, _⟩ => fun _ _ => GenBatm.aat_1 _
    | ⟨2, _⟩ => fun _ _ => GenBatm.aat_2 _
    | ⟨3, _⟩ => fun _ _ => GenBatm.aat_3 _
    | ⟨4, _⟩ => fun _ _ => GenBatm.aat_4 _
    | ⟨5, _⟩ => fun _ _ => GenBatm.aat_5 _
    | ⟨6, _⟩ => fun _ _ => GenBatm.aat_6 _
    | ⟨7, _⟩ => fun _ _ => GenBatm.aat_7 _
