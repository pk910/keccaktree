  have I1 := hI.seg GenBatm.facts (off + done) (by omega) hmb hcut (by wok_in) (by wok_out GenBatm.facts)
  have I2 := I1.seg GenBb.facts (off + done) (by omega) hmb cut2 (by wok_in) (by wok_out GenBb.facts)
  rw [Isa.run_add]
  refine ⟨cut3, ⟨I2.ok, I2.inp, I2.pre, fun n hn => ?_⟩, ?_⟩
  · by_cases hn' : n < done
    · exact I2.dig n hn'
    · have := dg (n - done) (by omega)
      rw [show off + done + 0 + (n - done) = off + n by omega] at this
      exact this
  · exact (GenBb.facts_rdx _ hρ hw _ cut2 ok1).trans (GenBatm.facts_rdx _ hρ hw _ hcut hI.ok)


