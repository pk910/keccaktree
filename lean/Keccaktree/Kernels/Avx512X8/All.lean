theorem body_Batm (off c : Nat) (input : Int → BitVec 64) (S0 S : State (BitVec 64)) (done : Nat)
    (hcut : relocState (rho (off + done)) (cutOf GenBatm.facts.ctl0 GenBatm.facts.sc0) = cutOf GenBatm.facts.ctl0 S)
