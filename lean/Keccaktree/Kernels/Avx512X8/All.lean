/-- **The loop**: from the loop control after `k + 1` iterations (count register `c - 8k`), every run of
`LI · (c - 8(k+1)) + XM` steps is an outcome. -/
theorem afterB (off c : Nat) (input : Int → BitVec 64) (S0 : State (BitVec 64)) (hb : 64 * (off + c) ≤ 2 ^ 54) :
    ∀ j k (T : State (BitVec 64)), c - 8 * (k + 1) ≤ j → 8 * (k + 1) ≤ c →
      relocState (rho (off + 8 * k)) (cutOf GenBb.facts.ctlK GenBb.facts.scK) = cutOf GenBb.facts.ctlK T →
      Inv off c input S0 T (8 * (k + 1)) → T.getGD 2 = BitVec.ofInt 64 ((c : Int) - 8 * (k : Int)) →
      DoneK off c input S0 T (LI * (c - 8 * (k + 1)) + XM) := by
  intro j
  induction j with
  | zero =>
    intro k T hj hk hcut hI hrdx
    exact afterB_step off c input S0 hb k T hk hcut hI hrdx (fun hcont => absurd hcont (by omega))
  | succ j ih =>
    intro k T hj hk hcut hI hrdx
    exact afterB_step off c input S0 hb k T hk hcut hI hrdx (fun hcont T' hcut' hI' hrdx' =>
      ih (k + 1) T' (by omega) (by omega) hcut' hI' hrdx')

