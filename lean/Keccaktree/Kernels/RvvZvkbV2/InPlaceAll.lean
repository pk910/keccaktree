/-- The access condition in the deterministic model (`vl = min(avl, 2)`). -/
abbrev AR := Riscv.AccessRun 2 rodata prog

theorem runCH (n : Nat) (S : State (BitVec 64)) :
    (RVc (fun a => min a 2)).run rodata prog n S = RV.run rodata prog n S :=
  Riscv.run_min 2 rodata prog n S


