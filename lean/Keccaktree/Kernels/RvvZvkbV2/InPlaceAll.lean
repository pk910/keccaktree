/-- A batch of any width `w = min (c - j) 2`. -/
theorem batchA_any (ch : Nat → Nat) (hch : ch = fun a => min a 2) (off c : Nat) (input : Int → BitVec 64)
    (S0 S : State (BitVec 64)) (j w : Nat) (hb : 64 * (off + c) ≤ 2 ^ 54) (hM : Mid off c input S0 S j 7)
    (hw1 : 1 ≤ w) (hw2 : w ≤ 2) (hj : j + w ≤ c) (hwc : ch (c - j) = w) :
    AR 3166 (4 * ((off + j : Nat) : Int)) (4 * ((off + j : Nat) : Int) + 4 * w) S := by
  rcases (show w = 1 ∨ w = 2 by omega) with rfl | rfl
  · exact batchA1 ch hch off c input S0 S j hb hM (by omega) hwc
  · exact batchA2 ch hch off c input S0 S j hb hM (by omega) hwc

/-- **The loop in place**: from the loop head after `j < c` nodes, the remaining batches, from the bound
`4(off + j)` to `4(off + c)`. -/
theorem loopA (off c : Nat) (input : Int → BitVec 64) (S0 : State (BitVec 64)) (hb : 64 * (off + c) ≤ 2 ^ 54) :
    ∀ f j (S : State (BitVec 64)), Mid off c input S0 S j 7 → j < c → c - j ≤ f →
      AR (3166 * nb (fun a => min a 2) f (c - j)) (4 * ((off + j : Nat) : Int)) (4 * ((off + c : Nat) : Int)) S := by
  intro f
  induction f with
  | zero => intro j S hM h1 h2; omega
  | succ f ih =>
    intro j S hM h1 h2
    obtain ⟨b1, b2, b3⟩ := (Riscv.legal_min 2).bounds (by decide) (c - j) (by omega)
    have hstep := batch_any (fun a => min a 2) off c input S0 S j _ hb hM b1 b3 (by omega) rfl
    have hacc := batchA_any (fun a => min a 2) rfl off c input S0 S j _ hb hM b1 b3 (by omega) rfl
    have hnb : nb (fun a => min a 2) (f + 1) (c - j) = 1 + nb (fun a => min a 2) f (c - j - min (c - j) 2) := by
      show (if c - j = 0 then 0 else 1 + nb (fun a => min a 2) f (c - j - min (c - j) 2)) = _
      rw [if_neg (by omega)]
    rw [hnb, show 3166 * (1 + nb (fun a => min a 2) f (c - j - min (c - j) 2)) =
      3166 + 3166 * nb (fun a => min a 2) f (c - j - min (c - j) 2) by omega]
    apply Riscv.accessRun_add 2 rodata prog _ _ _ _ _ S hacc
    rw [← runCH]
    by_cases hz : c - j - min (c - j) 2 = 0
    · rw [hz, nb_zero, Nat.mul_zero]
      show (4 * ((off + j : Nat) : Int) + 4 * min (c - j) 2) ≤ 4 * ((off + c : Nat) : Int)
      omega
    · rw [if_neg hz] at hstep
      have := ih (j + min (c - j) 2) _ hstep (by omega) (by omega)
      rw [show c - (j + min (c - j) 2) = c - j - min (c - j) 2 by omega,
        show 4 * ((off + (j + min (c - j) 2) : Nat) : Int) = 4 * ((off + j : Nat) : Int) + 4 * min (c - j) 2 by omega] at this
      exact this

