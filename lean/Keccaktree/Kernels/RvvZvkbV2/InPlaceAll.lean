/-- **A batch of `1` node(s) in place**: input loads of nodes `off + j ..` at or above the bound
`4(off + j)`, which ends at `4(off + j + 1)`. -/
theorem batchA1 (ch : Nat → Nat) (hch : ch = fun a => min a 2) (off c : Nat) (input : Int → BitVec 64)
    (S0 S : State (BitVec 64)) (j : Nat) (hb : 64 * (off + c) ≤ 2 ^ 54) (hM : Mid off c input S0 S j 7) (hj : j + 1 ≤ c)
    (hw : ch (c - j) = 1) :
    AR 3166 (4 * ((off + j : Nat) : Int)) (4 * ((off + j : Nat) : Int) + 4) S := by
  have hM' := batch1 ch off c input S0 S j hb hM hj hw
  have hb' : 64 * (off + c) ≤ 18014398509481984 := by
    have : (2 : Nat) ^ 54 = 18014398509481984 := rfl
    omega
  have hr0 : 0 ≤ (c : Int) - j := by omega
  have hr1 : (c : Int) - j < 2 ^ 55 := by rw [show (2 : Int) ^ 55 = 36028797018963968 from rfl]; omega
  have hwf_in : (⟨rInput, 64 * ((off + j : Nat) : Int)⟩ : Addr).wf := by
    show 0 ≤ 64 * ((off + j : Nat) : Int) ∧ 64 * ((off + j : Nat) : Int) < 2 ^ 55
    rw [show (2 : Int) ^ 55 = 36028797018963968 from rfl]; constructor <;> omega
  have hwf_out : (⟨rOutput, 32 * ((off + j : Nat) : Int)⟩ : Addr).wf := by
    show 0 ≤ 32 * ((off + j : Nat) : Int) ∧ 32 * ((off + j : Nat) : Int) < 2 ^ 55
    rw [show (2 : Int) ^ 55 = 36028797018963968 from rfl]; constructor <;> omega
  have ht : ((c : Int) - j).toNat = c - j := by omega
  have hhd := run_head 2 ch rodata prog prog_7 prog_8 prog_12 prog_13 S ((c : Int) - j) hM.ok.2.1 hM.ctrl.2.2.2.2.2.2.1
    hM.a2 hM.a7 hr0 hr1 (by rw [ht, hw]; omega)
  rw [ht, hw] at hhd
  have hf := H4_facts 1 S ((c : Int) - j)
  have hHenv : ∀ i, i ≠ 261 → i ≠ 284 → envOf (H4 1 S ((c : Int) - j)) i = envOf S i := fun i a b => H4_env _ _ _ i a b
  generalize hH : H4 1 S ((c : Int) - j) = H at hhd hf hHenv
  obtain ⟨hf14, hfvl, hf5, hfg, hfk, hfz, hfc, hfn, hfv, hfd, hfh, hfe, hft, hfm⟩ := hf
  have hHok : SliceCert.Ok H := ⟨hfe.trans hM.ok.1, hfh.trans hM.ok.2.1, hft.trans hM.ok.2.2⟩
  have hρ := rho_ok (off + j)
  have hc0 : relocState (rho (off + j)) (cutOf GenB1.ctl0 GenB1.sc0) = cutOf GenB1.ctl0 H := by
    apply relocState_cutOf
    · intro i hi
      simp only [GenB1.ctl0, List.mem_cons, List.mem_nil_iff, or_false] at hi
      rcases hi with rfl | rfl | rfl | rfl | rfl
      · -- t0 = vl
        rw [cutVar_const_of GenB1.ctl0 H 261 _ (by decide) ((envOf_gdVar H 5 (by decide)).trans hf5) (by decide +kernel),
          show cutVar GenB1.ctl0 GenB1.sc0 261 = .const (BitVec.ofNat 64 1) by decide +kernel, rho_const]
      · -- a0
        rw [cutVar_ptr_of GenB1.ctl0 H 266 ⟨rOutput, 32 * ((off + j : Nat) : Int)⟩ (by decide)
            ((hHenv 266 (by decide) (by decide)).trans ((envOf_gdVar S 10 (by decide)).trans hM.a0)) hwf_out (by show rOutput ≠ 0; decide),
          show cutVar GenB1.ctl0 GenB1.sc0 266 = .ptr ⟨rOutput, 0⟩ by decide +kernel, reloc_ptr_out, Int.zero_add]
      · -- a1
        rw [cutVar_ptr_of GenB1.ctl0 H 267 ⟨rInput, 64 * ((off + j : Nat) : Int)⟩ (by decide)
            ((hHenv 267 (by decide) (by decide)).trans ((envOf_gdVar S 11 (by decide)).trans hM.a1)) hwf_in (by show rInput ≠ 0; decide),
          show cutVar GenB1.ctl0 GenB1.sc0 267 = .ptr ⟨rInput, 0⟩ by decide +kernel, reloc_ptr_in, Int.zero_add]
      · -- a7 = 0
        rw [cutVar_const_of GenB1.ctl0 H 273 0#64 (by decide) ((hHenv 273 (by decide) (by decide)).trans ((envOf_gdVar S 17 (by decide)).trans hM.a7))
            (by decide +kernel),
          show cutVar GenB1.ctl0 GenB1.sc0 273 = .const 0#64 by decide +kernel, rho_const]
      · -- t5 = 1 << 63
        rw [cutVar_const_of GenB1.ctl0 H 286 0x8000000000000000#64 (by decide)
            ((hHenv 286 (by decide) (by decide)).trans ((envOf_gdVar S 30 (by decide)).trans hM.t5)) (by decide +kernel),
          show cutVar GenB1.ctl0 GenB1.sc0 286 = .const 0x8000000000000000#64 by decide +kernel, rho_const]
    · intro i hi h; simp only [GenB1.ctl0, List.mem_cons, List.mem_nil_iff, or_false] at hi; omega
    · obtain ⟨cg, ck, cz, cc, cn, cv, _, cd⟩ := hM.ctrl
      refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
      · rw [hfg, cg]; decide +kernel
      · rw [hfk, ck]; decide +kernel
      · rw [hfz, cz]; decide +kernel
      · rw [hfc, cc]; decide +kernel
      · rw [hfn, cn]; decide +kernel
      · rw [hfv, cv]; decide +kernel
      · rw [hfvl]; decide +kernel
      · rw [hf14]; decide +kernel
      · rw [hfd, cd]; decide +kernel
  have hw0 : (rho (off + j)).within GenB1.B := rho_within (off + j) (by omega)
  have hrun4 : RV.run rodata prog 4 S = H := by rw [← runCH, ← hch]; exact hhd
  -- the head: no memory cells
  have aH : AR 4 (4 * ((off + j : Nat) : Int)) (4 * ((off + j : Nat) : Int)) S :=
    acc_quietWithin 2 rodata prog 4 [7] S _ (by simp [hM.ctrl.2.2.2.2.2.2.1]) (by decide +kernel)
      (by rw [hrun4]; exact hHok.1)
  -- the body: from its footprint summaries
  have aB : AR GenB1.segLen (4 * ((off + j : Nat) : Int)) (4 * ((off + j : Nat) : Int) + 4) H := by
    rw [← InPlace.GenB1.len]
    apply (Riscv.alIsa 2).chain_access (rho (off + j)) hρ hw0 InPlace.GenB1.certs _ _ _ InPlace.GenB1.chain
      (by intro C hC; simp only [InPlace.GenB1.certs, List.head?_cons, Option.mem_def, Option.some.injEq] at hC; subst hC; exact hc0)
      hHok
    rw [InPlace.GenB1.sums, rho_wshift_in, rho_wshift_out]
    simp [SummOk, nextB] <;> omega
  have sr := GenB1.seg_run (rho (off + j)) hρ hw0 H hc0 hHok
  generalize hSb : GenB1.segAt25 H = Sb at sr
  obtain ⟨hrun, hokb, hcutb⟩ := sr
  have hpcb : Sb.pc = 237 := (cut_fields _ _ _ _ hcutb).2.2.2.2.2.2.2.1.trans (by decide +kernel)
  have hrunB : RV.run rodata prog GenB1.segLen H = Sb := hrun
  have herr : (RV.run rodata prog 2 Sb).err = false := by
    have := hM'.ok.1
    rw [hch, runCH, show 3166 = 4 + GenB1.segLen + 2 by rw [body_len1], Isa.run_add, Isa.run_add, hrun4, hrunB] at this
    exact this
  -- the back edge: no memory cells
  have aT := acc_quietWithin 2 rodata prog 2 [237] Sb (4 * ((off + j : Nat) : Int) + 4) (by simp [hpcb])
    (by decide +kernel) herr
  rw [show 3166 = 4 + GenB1.segLen + 2 by rw [body_len1]]
  apply Riscv.accessRun_add 2 rodata prog _ _ _ _ _ S
    (Riscv.accessRun_add 2 rodata prog _ _ _ _ _ S aH (by rw [hrun4]; exact aB))
  rw [Isa.run_add, hrun4, hrunB]; exact aT


