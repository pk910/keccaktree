/-- **The access condition of a whole call** (`c` nodes at node offset `off`): the bound starts at `4·off`
and ends at `4·(off + c)`. -/
theorem access_all (off c : Nat) (input : Int → BitVec 64) (S : State (BitVec 64)) (hE : Entry off c input S)
    (hb : 64 * (off + c) ≤ 2 ^ 54) :
    AR (8 + 3166 * nb (fun a => min a 2) c c) (4 * (off : Int)) (4 * ((off + c : Nat) : Int)) S := by
  rcases Nat.eq_zero_or_pos c with hc | hc
  · subst hc
    have h0 := entry_zero 2 (fun a => min a 2) rodata prog 237 prog_1 prog_240 off input S hE
    rw [runCH] at h0
    rw [nb_zero, Nat.mul_zero, show 8 + 0 = 2 + 6 from rfl]
    apply Riscv.accessRun_add 2 rodata prog 2 6 _ _ _ S
    · exact acc_quietWithin 2 rodata prog 2 [1] S _ (by simp [hE.ctrl.2.2.2.2.2.2.1]) (by decide +kernel)
        (by rw [h0]; exact hE.ok.1)
    · rw [h0]
      exact accessRun_bf 2 rodata prog 6 _ _ _ _ (accessRun_of_halted' 2 rodata prog 6 _ _ rfl) (by omega)
  · have hM0 := entry_pos 2 (fun a => min a 2) rodata prog 237 prog_1 prog_2 prog_3 prog_4 prog_5 prog_6 off c input S hE hc hb
    rw [runCH] at hM0
    have a6 := acc_quietWithin 2 rodata prog 6 [1] S (4 * (off : Int)) (by simp [hE.ctrl.2.2.2.2.2.2.1]) (by decide +kernel)
      hM0.ok.1
    have al := loopA off c input S hb c 0 _ hM0 hc (by omega)
    rw [Nat.sub_zero, show ((off + 0 : Nat) : Int) = (off : Int) by simp] at al
    have hl := loop (fun a => min a 2) (Riscv.legal_min 2) off c input S hb c 0 _ hM0 hc (by omega)
    rw [Nat.sub_zero] at hl
    generalize hX : (RVc (fun a => min a 2)).run rodata prog (3166 * nb (fun a => min a 2) c c) (RV.run rodata prog 6 S) = X at hl
    have hX' : RV.run rodata prog (3166 * nb (fun a => min a 2) c c) (RV.run rodata prog 6 S) = X := by rw [← runCH]; exact hX
    have hx := run_exit 2 (fun a => min a 2) rodata prog 237 prog_239 prog_240 X hl.ok.2.1 hl.ctrl.2.2.2.2.2.2.1
    rw [runCH] at hx
    have ax := acc_quietWithin 2 rodata prog 2 [239] X (4 * ((off + c : Nat) : Int)) (by simp [hl.ctrl.2.2.2.2.2.2.1])
      (by decide +kernel) (by rw [hx]; simp only [Riscv.next_err, Riscv.setR_err]; exact hl.ok.1)
    rw [show 8 + 3166 * nb (fun a => min a 2) c c = 6 + 3166 * nb (fun a => min a 2) c c + 2 by omega]
    apply Riscv.accessRun_add 2 rodata prog _ 2 _ _ _ S (Riscv.accessRun_add 2 rodata prog 6 _ _ _ _ S a6 al)
    rw [Isa.run_add, hX']; exact ax

/-! ## In the in-place library -/

/-- The access theorem (`LibRvAl.AccessThmRv`). -/
theorem access_thm : LibRvAl.AccessThmRv 2 rodata prog 1 (fun _ c => 8 + 3166 * ((c + 1) / 2)) := by
  intro off count input S hE hb hpc
  have hnorm := norm_thm off count input S hE hb hpc
  obtain ⟨⟨g, k, z, cf, n, v, _, d⟩, hok, ha2, _, ha1, ha0, hin⟩ := hE
  have hE' : Entry off count input S := ⟨⟨g, k, z, cf, n, v, hpc, d⟩, hok, ha2, ha1, ha0, hin⟩
  have h := access_all off count input S hE' hb
  rw [nb_min count count (Nat.le_refl count)] at h
  refine ⟨4 * ((off + count : Nat) : Int), h, ?_⟩
  intro next done _ ht _
  obtain ⟨-, -, -, hout⟩ := hnorm
  rcases hout with ⟨ht', -⟩ | ⟨nx, dn, -, hmem, -⟩
  · exact absurd (ht'.symm.trans ht) (by simp)
  · simp at hmem

/-- The kernel of the in-place RISC-V library (any `vl` at entry). -/
def kernelAl : Library.KernelThm (Riscv.alIsa 2).isaAl LibRvAl.EntryRvAl Digest :=
  LibRvAl.mkKernelRvAl 2 (LibTable.sym "rvv_zvkb") 0 [] rodata prog 1 (fun _ c => 8 + 3166 * ((c + 1) / 2))
    (Riscv.vlAnn RvVl.rvv_zvkb) RvVl.rvv_zvkb_ok RvVl.entries.2.2.2 norm_thm access_thm

end Keccaktree.Kernels.RvvZvkbV2.InPlaceAll
