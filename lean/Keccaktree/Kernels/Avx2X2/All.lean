/-- **`keccaktree_keccak256_avx2_x2` on any number of nodes**, from a fresh call. -/
theorem norm_thm : NormThm rodata prog 582 steps targets := by
  intro off c input S hE hb hpc
  have I0 : Inv off c input S S 0 := ⟨hE.ok, hE.inp, fun _ _ => rfl, fun n hn => absurd hn (Nat.not_lt_zero _)⟩
  have hc55 : (c : Int) < 36028797018963968 := by
    have : (2 : Nat) ^ 54 = 18014398509481984 := rfl
    omega
  have hmb : 64 * off ≤ 2 ^ 54 := by omega
  have f0 := (X86K.Fr.entry rodata prog off c input S hE).pc_congr (pc' := 582) hpc
  have hx := Fr.cut (rho_ok off) (rho_ok 0) entryCtl GenPff.facts.ctl0 entrySc GenPff.facts.sc0
    (PreCut.entry off c input S hE hb) f0 [] (by simp [setVal]) (by decide +kernel) (by decide +kernel) (hE.ctrl.2.2.1.trans (by decide +kernel)) (hE.ctrl.2.2.2.1.trans (by decide +kernel)) (by decide +kernel)
  rw [rho_add, Nat.add_zero] at hx
  obtain ⟨ok1, cut1⟩ := GenPff.facts.run (rho off) (rho_ok off) (rho_within off hmb) _ hx (I0.fr f0).ok
  have I1 := (I0.fr f0).seg GenPff.facts off (by omega) hmb hx (by wok_in) (by wok_out GenPff.facts)
  have e2 : (X86.isa.run rodata prog GenPff.facts.len (X86.isa.run rodata prog 0 S)).getGD 2 =
      (X86.isa.run rodata prog 0 S).getGD 2 := by
    rw [← envOf_gdVar _ 2 (by decide), ← envOf_gdVar _ 2 (by decide)]
    exact GenPff.facts_rdx _ (rho_ok off) (rho_within off hmb) _ hx (I0.fr f0).ok
  have hd := afterP_Pff off c input S _ hb cut1 I1 (by
    rw [e2, f0.vals (2, (c : Int)) (by simp [setVal])]
    try rfl) (by omega)
  rw [len_Pff] at hd
  exact (Done.run rfl (Done.run rfl hd)) (steps off c) (by unfold steps; omega)

