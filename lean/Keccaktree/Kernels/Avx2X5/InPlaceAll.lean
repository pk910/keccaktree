/-- **The loop in place**: from the loop control after `k + 1` iterations. -/
theorem afterBA (off c : Nat) (input : Int → BitVec 64) (S0 : State (BitVec 64)) (hb : 64 * (off + c) ≤ 2 ^ 54) :
    ∀ j k (T : State (BitVec 64)), c - 5 * (k + 1) ≤ j → 5 * (k + 1) ≤ c →
      relocState (rho (off + 5 * k)) (cutOf GenBb.facts.ctlK GenBb.facts.scK) = cutOf GenBb.facts.ctlK T →
      Inv off c input S0 T (5 * (k + 1)) → T.getGD 2 = BitVec.ofInt 64 ((c : Int) - 5 * (k : Int)) →
      DoneAK off c input T (LI * (c - 5 * (k + 1)) + XM) (4 * ((off + 5 * (k + 1) : Nat) : Int)) := by
  intro j
  induction j with
  | zero =>
    intro k T hj hk hcut hI hrdx
    exact afterBA_step off c input S0 hb k T hk hcut hI hrdx (fun hcont => absurd hcont (by omega))
  | succ j ih =>
    intro k T hj hk hcut hI hrdx
    exact afterBA_step off c input S0 hb k T hk hcut hI hrdx (fun hcont T' hcut' hI' hrdx' =>
      ih (k + 1) T' (by omega) (by omega) hcut' hI' hrdx')

