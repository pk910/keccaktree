/-- **One batch**: from the loop head before batch `k` (`2k < c`), `1594` steps reach the loop head
before batch `k + 1`, or the epilogue after the last batch. -/
theorem iter (off c : Nat) (input : Int → BitVec 64) (S0 : State (BitVec 64)) (hb : 64 * (off + c) ≤ 2 ^ 54)
    (k : Nat) (S : State (BitVec 64)) (hk : 2 * k < c) (hH : Head off c input S0 k S) :
    (2 * k + 2 < c → Head off c input S0 (k + 1) (Arm.isa.run rodata prog 1594 S)) ∧
    (c ≤ 2 * k + 2 → ExitAt off c input S0 (off + 2 * k) (Arm.isa.run rodata prog 1594 S)) := by
  refine ⟨fun h => iter_a off c input S0 hb k S (by omega) hH, fun h => ?_⟩
  rcases (by omega : c = 2 * k + 2 ∨ c = 2 * k + 1) with h2 | h1
  · exact iter_b off c input S0 hb k S h2 hH
  · exact iter_c off c input S0 hb k S h1 hH

/-- **The loop**: from the loop head before batch `k`, the remaining `d + 1` batches reach the epilogue
with every digest written. -/
theorem loop (off c : Nat) (input : Int → BitVec 64) (S0 : State (BitVec 64)) (hb : 64 * (off + c) ≤ 2 ^ 54) :
    ∀ d k (S : State (BitVec 64)), k + d + 1 = (c + 1) / 2 → Head off c input S0 k S →
      ExitAt off c input S0 (off + 2 * ((c + 1) / 2 - 1)) (Arm.isa.run rodata prog (1594 * (d + 1)) S) := by
  intro d
  induction d with
  | zero =>
    intro k S hk hH
    have := (iter off c input S0 hb k S (by omega) hH).2 (by omega)
    rw [show off + 2 * ((c + 1) / 2 - 1) = off + 2 * k by omega, show 1594 * (0 + 1) = 1594 from rfl]
    exact this
  | succ d ih =>
    intro k S hk hH
    have h1 := (iter off c input S0 hb k S (by omega) hH).1 (by omega)
    rw [show 1594 * (d + 1 + 1) = 1594 + 1594 * (d + 1) by omega, Isa.run_add]
    exact ih (k + 1) _ (by omega) h1

