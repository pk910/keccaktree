/-- The loop head and `cmp x2, #2`: four steps to the state before the two `csel`. -/
theorem pre (off c : Nat) (input : Int → BitVec 64) (S0 : State (BitVec 64)) (hb : 64 * (off + c) ≤ 2 ^ 54)
    (k : Nat) (S : State (BitVec 64)) (hk : 2 * k < c) (hH : Head off c input S0 k S) :
    ∃ T' : State (BitVec 64),
      Arm.isa.run rodata prog 4 S = Arm.next (Arm.setFlags T' ((c : Int) - 2 * k) 2) ∧
      relocState (rho (off + 2 * k)) (cutOf GenSH.ctl1 GenSH.sc1) = cutOf GenSH.ctl1 T' ∧ SliceCert.Ok T' ∧
      T'.getGD 2 = gprWord ⟨0, (c : Int) - 2 * k⟩ ∧ T'.pc = 8 ∧ T'.mem = S.mem := by
  obtain ⟨hcut, hok, hcnt, hin, hpre, hdig⟩ := hH
  have hb' : 64 * (off + c) ≤ 18014398509481984 := by
    have : (2 : Nat) ^ 54 = 18014398509481984 := rfl
    omega
  have hρ := rho_ok (off + 2 * k)
  have hw : (rho (off + 2 * k)).within GenSH.B := rho_within _ (by omega)
  have hok' : SliceCert.Ok (norm S GenSH.sc0) := hok
  have sr := GenSH.seg_run _ hρ hw _ hcut hok'
  have fr := GenSH.seg_frame _ hρ hw _ hcut hok'
  have mv := GenSH.seg_moves _ hρ hw _ hcut hok' 258 258 (by simp)
  have fl : Arm.isa.run rodata prog GenSH.segLen S = (GenSH.segAt1 (norm S GenSH.sc0)).withFlags S.zf S.cf S.nf S.vf :=
    GenSH.seg_flags _ hρ hw _ hcut hok' S.zf S.cf S.nf S.vf
  rw [Reloc.var_lt _ 258 (by decide)] at mv
  generalize hT' : GenSH.segAt1 (norm S GenSH.sc0) = T' at sr fr mv fl
  obtain ⟨_, hokT, hcutT⟩ := sr
  have fT := cut_fields _ _ _ _ hcutT
  have hcntT : T'.getGD 2 = gprWord ⟨0, (c : Int) - 2 * k⟩ := by
    have e1 : envOf T' 258 = T'.getGD 2 := envOf_gdVar T' 2 (by decide)
    have e2 : envOf (norm S GenSH.sc0) 258 = (norm S GenSH.sc0).getGD 2 := envOf_gdVar _ 2 (by decide)
    rw [← e1, mv, e2]; exact hcnt
  have hpcT : T'.pc = 8 := fT.2.2.2.2.2.2.2.1.trans (by decide +kernel)
  have hhT : (T'.withFlags S.zf S.cf S.nf S.vf).halted = false := hokT.2.1
  have hcmp := Arm.exec_cmp_num rodata (T'.withFlags S.zf S.cf S.nf S.vf) 2 2 ((c : Int) - 2 * k) hhT hcntT
    (wf_num _ (by omega) (by omega))
  refine ⟨T', ?_, hcutT, hokT, hcntT, hpcT, funext fun r => funext fun q => fr r q rfl⟩
  have hl : GenSH.segLen = 3 := by decide +kernel
  rw [show 4 = GenSH.segLen + 1 by rw [hl], Isa.run_add, fl, Arm.run_one rodata prog _ hhT,
    show prog.getD (T'.withFlags S.zf S.cf S.nf S.vf).pc .nop = .cmp 2 2 by
      rw [show (T'.withFlags S.zf S.cf S.nf S.vf).pc = 8 from hpcT]; decide +kernel, hcmp]
  rfl

