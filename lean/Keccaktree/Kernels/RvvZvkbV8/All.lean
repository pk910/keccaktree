/-! ## The loop -/

/-- A batch of any width `w = ch (c - j)`. -/
theorem batch_any (ch : Nat → Nat) (off c : Nat) (input : Int → BitVec 64) (S0 S : State (BitVec 64)) (j w : Nat)
    (hb : 64 * (off + c) ≤ 2 ^ 54) (hM : Mid off c input S0 S j 7) (hw1 : 1 ≤ w) (hw2 : w ≤ 8) (hj : j + w ≤ c)
    (hwc : ch (c - j) = w) :
    Mid off c input S0 ((RVc ch).run rodata prog 3166 S) (j + w) (if c - j - w = 0 then 239 else 7) := by
  rcases (show w = 1 ∨ w = 2 ∨ w = 3 ∨ w = 4 ∨ w = 5 ∨ w = 6 ∨ w = 7 ∨ w = 8 by omega) with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact batch1 ch off c input S0 S j hb hM (by omega) hwc
  · exact batch2 ch off c input S0 S j hb hM (by omega) hwc
  · exact batch3 ch off c input S0 S j hb hM (by omega) hwc
  · exact batch4 ch off c input S0 S j hb hM (by omega) hwc
  · exact batch5 ch off c input S0 S j hb hM (by omega) hwc
  · exact batch6 ch off c input S0 S j hb hM (by omega) hwc
  · exact batch7 ch off c input S0 S j hb hM (by omega) hwc
  · exact batch8 ch off c input S0 S j hb hM (by omega) hwc

/-- The number of batches for `r` nodes left under the choice `ch` (fuel `f ≥ r`). -/
def nb (ch : Nat → Nat) : Nat → Nat → Nat
  | 0, _ => 0
  | f + 1, r => if r = 0 then 0 else 1 + nb ch f (r - ch r)

theorem nb_zero (ch : Nat → Nat) (f : Nat) : nb ch f 0 = 0 := by cases f <;> rfl

/-- **The loop under any legal choice**: from the loop head after `j < c` nodes, `nb ch f (c - j)` batches
(fuel `f ≥ c - j`) reach the exit with every node done. -/
theorem loop (ch : Nat → Nat) (hch : Riscv.LegalVl 8 ch) (off c : Nat) (input : Int → BitVec 64) (S0 : State (BitVec 64))
    (hb : 64 * (off + c) ≤ 2 ^ 54) :
    ∀ f j (S : State (BitVec 64)), Mid off c input S0 S j 7 → j < c → c - j ≤ f →
      Mid off c input S0 ((RVc ch).run rodata prog (3166 * nb ch f (c - j)) S) c 239 := by
  intro f
  induction f with
  | zero => intro j S hM h1 h2; omega
  | succ f ih =>
    intro j S hM h1 h2
    obtain ⟨b1, b2, b3⟩ := hch.bounds (by decide) (c - j) (by omega)
    have hstep := batch_any ch off c input S0 S j (ch (c - j)) hb hM b1 b3 (by omega) rfl
    have hnb : nb ch (f + 1) (c - j) = 1 + nb ch f (c - j - ch (c - j)) := by
      show (if c - j = 0 then 0 else 1 + nb ch f (c - j - ch (c - j))) = _
      rw [if_neg (by omega)]
    rw [hnb, show 3166 * (1 + nb ch f (c - j - ch (c - j))) = 3166 + 3166 * nb ch f (c - j - ch (c - j)) by omega, Isa.run_add]
    by_cases hz : c - j - ch (c - j) = 0
    · rw [if_pos hz, show j + ch (c - j) = c by omega] at hstep
      rw [hz, nb_zero, Nat.mul_zero, show (RVc ch).run rodata prog 0 _ = _ from rfl]
      exact hstep
    · rw [if_neg hz] at hstep
      rw [show c - j - ch (c - j) = c - (j + ch (c - j)) by omega]
      exact ih (j + ch (c - j)) _ hstep (by omega) (by omega)

theorem nb_min : ∀ f r, r ≤ f → nb (fun a => min a 8) f r = (r + 7) / 8 := by
  intro f
  induction f with
  | zero => intro r h; rw [show r = 0 by omega]; rfl
  | succ f ih =>
    intro r h
    show (if r = 0 then 0 else 1 + nb (fun a => min a 8) f (r - min r 8)) = _
    by_cases hr : r = 0
    · rw [if_pos hr, hr]
    · rw [if_neg hr, ih _ (by omega)]
      omega

/-! ## The whole call -/

set_option maxRecDepth 100000 in
set_option maxHeartbeats 4000000 in
/-- **The kernel on any number of nodes, under any legal vector-length choice** (RVV 1.0 §6.3). -/
theorem all_ch (ch : Nat → Nat) (hch : Riscv.LegalVl 8 ch) (off c : Nat) (input : Int → BitVec 64) (S : State (BitVec 64))
    (hE : Entry off c input S) (hb : 64 * (off + c) ≤ 2 ^ 54) :
    ((RVc ch).run rodata prog (8 + 3166 * nb ch c c) S).halted = true ∧
    ((RVc ch).run rodata prog (8 + 3166 * nb ch c c) S).err = false ∧
    ((RVc ch).run rodata prog (8 + 3166 * nb ch c c) S).tail = none ∧
    (∀ q : Int, q < 4 * (off : Int) → ((RVc ch).run rodata prog (8 + 3166 * nb ch c c) S).mem rOutput q = S.mem rOutput q) ∧
    ∀ n, n < c → Digest input ((RVc ch).run rodata prog (8 + 3166 * nb ch c c) S) (off + n) := by
  rcases Nat.eq_zero_or_pos c with hc | hc
  · subst hc
    have h0 := entry_zero 8 ch rodata prog 237 prog_1 prog_240 off input S hE
    rw [nb_zero, Nat.mul_zero, show 8 + 0 = 2 + 6 from rfl, Isa.run_add, h0, Isa.run_halted _ _ _ _ _ rfl]
    exact ⟨rfl, hE.ok.1, hE.ok.2.2, fun q _ => rfl, fun n hn => absurd hn (Nat.not_lt_zero _)⟩
  · have hM0 := entry_pos 8 ch rodata prog 237 prog_1 prog_2 prog_3 prog_4 prog_5 prog_6 off c input S hE hc hb
    have hl := loop ch hch off c input S hb c 0 _ hM0 hc (by omega)
    rw [Nat.sub_zero] at hl
    generalize hX : (RVc ch).run rodata prog (3166 * nb ch c c) ((RVc ch).run rodata prog 6 S) = X at hl
    have hx := run_exit 8 ch rodata prog 237 prog_239 prog_240 X hl.ok.2.1 hl.ctrl.2.2.2.2.2.2.1
    rw [show 8 + 3166 * nb ch c c = 6 + 3166 * nb ch c c + 2 by omega, Isa.run_add, Isa.run_add, hX, hx]
    refine ⟨rfl, ?_, ?_, ?_, ?_⟩
    · simp only [Riscv.next_err, Riscv.setR_err]; exact hl.ok.1
    · simp only [Riscv.next_tail, Riscv.setR_tail]; exact hl.ok.2.2
    · intro q hq; simp only [Riscv.next_mem, Riscv.setR_mem']; exact hl.pre q hq
    · intro n hn
      exact digest_congr input X _ _ (fun t _ => by simp only [Riscv.next_mem, Riscv.setR_mem']) (hl.dig n hn)

/-- **The kernel on any number of nodes** (the deterministic model `Riscv.isa 8`: `vl = min(avl, 8)`),
`8 + 3166·⌈c/8⌉` steps. -/
theorem all (off c : Nat) (input : Int → BitVec 64) (S : State (BitVec 64)) (hE : Entry off c input S)
    (hb : 64 * (off + c) ≤ 2 ^ 54) :
    (RV.run rodata prog (8 + 3166 * ((c + 7) / 8)) S).halted = true ∧
    (RV.run rodata prog (8 + 3166 * ((c + 7) / 8)) S).err = false ∧
    (RV.run rodata prog (8 + 3166 * ((c + 7) / 8)) S).tail = none ∧
    (∀ q : Int, q < 4 * (off : Int) → (RV.run rodata prog (8 + 3166 * ((c + 7) / 8)) S).mem rOutput q = S.mem rOutput q) ∧
    ∀ n, n < c → Digest input (RV.run rodata prog (8 + 3166 * ((c + 7) / 8)) S) (off + n) := by
  have h := all_ch (fun a => min a 8) (Riscv.legal_min 8) off c input S hE hb
  rw [nb_min c c (Nat.le_refl c), Riscv.run_min] at h
  exact h

/-! ## In the library -/

/-- What the library needs (`LibRv.NormThmRv`), deterministic model. -/
theorem norm_thm : LibRv.NormThmRv 8 rodata prog 1 (fun _ c => 8 + 3166 * ((c + 7) / 8)) [] := by
  intro off count input S hE hb hpc
  obtain ⟨⟨g, k, z, cf, n, v, _, d⟩, hok, ha2, _, ha1, ha0, hin⟩ := hE
  have hE' : Entry off count input S := ⟨⟨g, k, z, cf, n, v, hpc, d⟩, hok, ha2, ha1, ha0, hin⟩
  obtain ⟨hh, he, ht, hp, hd⟩ := all off count input S hE' hb
  exact ⟨hh, he, hp, Or.inl ⟨ht, hd⟩⟩

/-- What the library needs under any legal choice (`LibRv.NormThmRvCh`). -/
theorem norm_thm_ch (ch : Nat → Nat) (hch : Riscv.LegalVl 8 ch) :
    LibRv.NormThmRvCh 8 ch rodata prog 1 (fun _ c => 8 + 3166 * nb ch c c) [] := by
  intro off count input S hE hb hpc
  obtain ⟨⟨g, k, z, cf, n, v, _, d⟩, hok, ha2, _, ha1, ha0, hin⟩ := hE
  have hE' : Entry off count input S := ⟨⟨g, k, z, cf, n, v, hpc, d⟩, hok, ha2, ha1, ha0, hin⟩
  obtain ⟨hh, he, ht, hp, hd⟩ := all_ch ch hch off count input S hE' hb
  exact ⟨hh, he, hp, Or.inl ⟨ht, hd⟩⟩

/-- The kernel as a kernel of the RISC-V library at `vlmax = 8` (VLEN = 512; rank 0: it hands
nothing over; any `vl` at entry), deterministic model. -/
def kernel : Library.KernelThm RV LibTable.EntryRv Digest :=
  LibRv.mkKernelRv 8 (LibTable.sym "rvv_zvkb") 0 [] rodata prog 1 (fun _ c => 8 + 3166 * ((c + 7) / 8))
    (Riscv.vlAnn RvVl.rvv_zvkb) RvVl.rvv_zvkb_ok RvVl.entries.2.2.2 norm_thm

/-- The kernel in the RISC-V library under the legal vector-length choice `ch`. -/
def kernel_ch (ch : Nat → Nat) (hch : Riscv.LegalVl 8 ch) : Library.KernelThm (RVc ch) LibTable.EntryRv Digest :=
  LibRv.mkKernelRvCh 8 ch (LibTable.sym "rvv_zvkb") 0 [] rodata prog 1 (fun _ c => 8 + 3166 * nb ch c c)
    (Riscv.vlAnn RvVl.rvv_zvkb) RvVl.rvv_zvkb_ok RvVl.entries.2.2.2 (norm_thm_ch ch hch)

end Keccaktree.Kernels.RvvZvkbV8.All
