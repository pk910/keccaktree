theorem body_len7 : GenB7.segLen = 3160 := by decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 40000000 in
/-- **A batch of `7` node(s)** (`vl = 7`): from the loop head after `j` nodes with `min (c - j) 8 = 7`,
`3166` steps (head, body, back edge) hash nodes `off + j .. off + j + 6` and reach the loop head
after `j + 7` nodes, or the exit if none is left. -/
theorem batch7 (ch : Nat → Nat) (off c : Nat) (input : Int → BitVec 64) (S0 S : State (BitVec 64)) (j : Nat)
    (hb : 64 * (off + c) ≤ 2 ^ 54) (hM : Mid off c input S0 S j 7) (hj : j + 7 ≤ c) (hw : ch (c - j) = 7) :
    Mid off c input S0 ((RVc ch).run rodata prog 3166 S) (j + 7) (if c - j - 7 = 0 then 239 else 7) := by
  have hb' : 64 * (off + c) ≤ 18014398509481984 := by
    have : (2 : Nat) ^ 54 = 18014398509481984 := rfl
    omega
  have hr0 : 0 ≤ (c : Int) - j := by omega
  have hr1 : (c : Int) - j < 2 ^ 55 := by rw [show (2 : Int) ^ 55 = 36028797018963968 from rfl]; omega
  have hwf_in : (⟨rInput, 64 * ((off + j : Nat) : Int)⟩ : Addr).wf := by
    show 0 ≤ 64 * ((off + j : Nat) : Int) ∧ 64 * ((off + j : Nat) : Int) < 2 ^ 55
    rw [show (2 : Int) ^ 55 = 36028797018963968 from rfl]; constructor <;> omega
  have hwf_out : (⟨rOutput, 32 * ((off + j : Nat) : Int)⟩ : Addr).wf := by
    show 0 ≤ 32 * ((off + j : Nat) : Int) ∧ 32 * ((off + j : Nat) : Int) < 2 ^ 55
    rw [show (2 : Int) ^ 55 = 36028797018963968 from rfl]; constructor <;> omega
  -- head: `mv t3, a2; beqz a7; vsetvli; bnez a7`
  have ht : ((c : Int) - j).toNat = c - j := by omega
  have hhd := run_head 8 ch rodata prog prog_7 prog_8 prog_12 prog_13 S ((c : Int) - j) hM.ok.2.1 hM.ctrl.2.2.2.2.2.2.1
    hM.a2 hM.a7 hr0 hr1 (by rw [ht, hw]; omega)
  rw [ht, hw] at hhd
  have hf := H4_facts 7 S ((c : Int) - j)
  have hHenv : ∀ i, i ≠ 261 → i ≠ 284 → envOf (H4 7 S ((c : Int) - j)) i = envOf S i := fun i a b => H4_env _ _ _ i a b
  generalize hH : H4 7 S ((c : Int) - j) = H at hhd hf hHenv
  obtain ⟨hf14, hfvl, hf5, hfg, hfk, hfz, hfc, hfn, hfv, hfd, hfh, hfe, hft, hfm⟩ := hf
  have hHok : SliceCert.Ok H := ⟨hfe.trans hM.ok.1, hfh.trans hM.ok.2.1, hft.trans hM.ok.2.2⟩
  have hHin : ∀ q, H.mem rInput q = input q := fun q => by rw [hfm]; exact hM.inp q
  -- the body's start cut, at node `off + j`
  have hρ := rho_ok (off + j)
  have hc0 : relocState (rho (off + j)) (cutOf GenB7.ctl0 GenB7.sc0) = cutOf GenB7.ctl0 H := by
    apply relocState_cutOf
    · intro i hi
      simp only [GenB7.ctl0, List.mem_cons, List.mem_nil_iff, or_false] at hi
      rcases hi with rfl | rfl | rfl | rfl | rfl
      · -- t0 = vl
        rw [cutVar_const_of GenB7.ctl0 H 261 _ (by decide) ((envOf_gdVar H 5 (by decide)).trans hf5) (by decide +kernel),
          show cutVar GenB7.ctl0 GenB7.sc0 261 = .const (BitVec.ofNat 64 7) by decide +kernel, rho_const]
      · -- a0
        rw [cutVar_ptr_of GenB7.ctl0 H 266 ⟨rOutput, 32 * ((off + j : Nat) : Int)⟩ (by decide)
            ((hHenv 266 (by decide) (by decide)).trans ((envOf_gdVar S 10 (by decide)).trans hM.a0)) hwf_out (by show rOutput ≠ 0; decide),
          show cutVar GenB7.ctl0 GenB7.sc0 266 = .ptr ⟨rOutput, 0⟩ by decide +kernel, reloc_ptr_out, Int.zero_add]
      · -- a1
        rw [cutVar_ptr_of GenB7.ctl0 H 267 ⟨rInput, 64 * ((off + j : Nat) : Int)⟩ (by decide)
            ((hHenv 267 (by decide) (by decide)).trans ((envOf_gdVar S 11 (by decide)).trans hM.a1)) hwf_in (by show rInput ≠ 0; decide),
          show cutVar GenB7.ctl0 GenB7.sc0 267 = .ptr ⟨rInput, 0⟩ by decide +kernel, reloc_ptr_in, Int.zero_add]
      · -- a7 = 0
        rw [cutVar_const_of GenB7.ctl0 H 273 0#64 (by decide) ((hHenv 273 (by decide) (by decide)).trans ((envOf_gdVar S 17 (by decide)).trans hM.a7))
            (by decide +kernel),
          show cutVar GenB7.ctl0 GenB7.sc0 273 = .const 0#64 by decide +kernel, rho_const]
      · -- t5 = 1 << 63
        rw [cutVar_const_of GenB7.ctl0 H 286 0x8000000000000000#64 (by decide)
            ((hHenv 286 (by decide) (by decide)).trans ((envOf_gdVar S 30 (by decide)).trans hM.t5)) (by decide +kernel),
          show cutVar GenB7.ctl0 GenB7.sc0 286 = .const 0x8000000000000000#64 by decide +kernel, rho_const]
    · intro i hi h; simp only [GenB7.ctl0, List.mem_cons, List.mem_nil_iff, or_false] at hi; omega
    · obtain ⟨cg, ck, cz, cc, cn, cv, _, cd⟩ := hM.ctrl
      refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
      · rw [hfg, cg]; decide +kernel
      · rw [hfk, ck]; decide +kernel
      · rw [hfz, cz]; decide +kernel
      · rw [hfc, cc]; decide +kernel
      · rw [hfn, cn]; decide +kernel
      · rw [hfv, cv]; decide +kernel
      · rw [hfvl]; decide +kernel
      · rw [hf14]; decide +kernel
      · rw [hfd, cd]; decide +kernel
  -- the body
  have hw0 : (rho (off + j)).within GenB7.B := rho_within (off + j) (by omega)
  have sr := GenB7.seg_run (rho (off + j)) hρ hw0 H hc0 hHok
  have fr := GenB7.seg_frame (rho (off + j)) hρ hw0 H hc0 hHok
  have dat := GenB7.seg_data (rho (off + j)) hρ hw0 H hc0 hHok _ (inv0_7 input H (off + j) hHin)
  have mv := GenB7.seg_moves (rho (off + j)) hρ hw0 H hc0 hHok 268 268 (by simp)
  -- the body under the choice `ch`: the same run (no `vsetvli` on its path)
  have hrunch : (RVc ch).run rodata prog GenB7.segLen H = GenB7.segAt25 H := by
    have s0 := (GenB7.cert0).step (rho (off + j)) hρ hw0 H hc0 hHok
    have s1 := (GenB7.cert1).step (rho (off + j)) hρ hw0 (GenB7.segAt1 H) s0.2.2.2 s0.2.2.1
