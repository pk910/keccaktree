    have s15 := (GenB6.cert15).step (rho (off + j)) hρ hw0 (GenB6.segAt15 H) s14.2.2.2 s14.2.2.1
    have s16 := (GenB6.cert16).step (rho (off + j)) hρ hw0 (GenB6.segAt16 H) s15.2.2.2 s15.2.2.1
    have s17 := (GenB6.cert17).step (rho (off + j)) hρ hw0 (GenB6.segAt17 H) s16.2.2.2 s16.2.2.1
    have s18 := (GenB6.cert18).step (rho (off + j)) hρ hw0 (GenB6.segAt18 H) s17.2.2.2 s17.2.2.1
