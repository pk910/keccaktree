    have s8 := (GenB6.cert8).step (rho (off + j)) hρ hw0 (GenB6.segAt8 H) s7.2.2.2 s7.2.2.1
    have s9 := (GenB6.cert9).step (rho (off + j)) hρ hw0 (GenB6.segAt9 H) s8.2.2.2 s8.2.2.1
    have s10 := (GenB6.cert10).step (rho (off + j)) hρ hw0 (GenB6.segAt10 H) s9.2.2.2 s9.2.2.1
