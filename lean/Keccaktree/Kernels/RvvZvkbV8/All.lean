    have s1 := (GenB6.cert1).step (rho (off + j)) hρ hw0 (GenB6.segAt1 H) s0.2.2.2 s0.2.2.1
    have s2 := (GenB6.cert2).step (rho (off + j)) hρ hw0 (GenB6.segAt2 H) s1.2.2.2 s1.2.2.1
    have s3 := (GenB6.cert3).step (rho (off + j)) hρ hw0 (GenB6.segAt3 H) s2.2.2.2 s2.2.2.1
    have s4 := (GenB6.cert4).step (rho (off + j)) hρ hw0 (GenB6.segAt4 H) s3.2.2.2 s3.2.2.1
    have s5 := (GenB6.cert5).step (rho (off + j)) hρ hw0 (GenB6.segAt5 H) s4.2.2.2 s4.2.2.1
