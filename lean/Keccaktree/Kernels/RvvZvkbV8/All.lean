  have sr := GenB6.seg_run (rho (off + j)) hρ hw0 H hc0 hHok
  have fr := GenB6.seg_frame (rho (off + j)) hρ hw0 H hc0 hHok
  have dat := GenB6.seg_data (rho (off + j)) hρ hw0 H hc0 hHok _ (inv0_6 input H (off + j) hHin)
  have mv := GenB6.seg_moves (rho (off + j)) hρ hw0 H hc0 hHok 268 268 (by simp)
