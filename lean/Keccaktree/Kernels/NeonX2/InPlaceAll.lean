  have mv := GenSH.seg_moves _ hρ hw _ hcut hok' 258 258 (by simp)
  have fl : Arm.isa.run rodata prog GenSH.segLen S = (GenSH.segAt1 (norm S GenSH.sc0)).withFlags S.zf S.cf S.nf S.vf :=
    GenSH.seg_flags _ hρ hw _ hcut hok' S.zf S.cf S.nf S.vf
  rw [Reloc.var_lt _ 258 (by decide)] at mv
  generalize hT' : GenSH.segAt1 (norm S GenSH.sc0) = T' at sr mv fl
  obtain ⟨_, hokT, hcutT⟩ := sr
  have fT := cut_fields _ _ _ _ hcutT
  have hcntT : T'.getGD 2 = gprWord ⟨0, (c : Int) - 2 * k⟩ := by
    have e1 : envOf T' 258 = T'.getGD 2 := envOf_gdVar T' 2 (by decide)
