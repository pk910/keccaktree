    apply Arm.alIsa.chain_access (rho (off + 2 * k)) hρ hwB InPlace.GenSBo.certs _ _ _ InPlace.GenSBo.chain
      (by intro C hC; simp only [InPlace.GenSBo.certs, List.head?_cons, Option.mem_def, Option.some.injEq] at hC; subst hC; exact hcB)
      hokW'
    rw [InPlace.GenSBo.sums, rho_wshift_in, rho_wshift_out]
    simp only [SummOk, nextB]
    simp [SummOk, nextB] <;> omega
  have aB : Arm.AccessRun rodata prog GenSBo.segLen (4 * ((off + 2 * k : Nat) : Int)) (4 * ((off + 2 * k : Nat) : Int) + 4) W :=
    Arm.accessRun_ann rodata prog annIP annIP_ok _ _ _ W (norm W GenSBo.sc0) (Arm.ovr_all_flags W _ _ _ _)
      (by rw [show (norm W GenSBo.sc0).pc = W.pc from rfl, fW.2.2.2.2.2.2.2.1]; decide +kernel) (by rw [sB.1]; exact sB.2.1.1) aBN
  have mvB := GenSBo.seg_moves _ hρ hw _ hcB hokW' 258 258 (by simp)
