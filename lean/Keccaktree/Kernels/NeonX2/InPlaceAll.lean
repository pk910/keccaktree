/-- The access condition of a batch with one node left (node 0 duplicated). -/
theorem batch_c (off c : Nat) (input : Int → BitVec 64) (S0 : State (BitVec 64)) (hb : 64 * (off + c) ≤ 2 ^ 54)
    (k : Nat) (S : State (BitVec 64)) (hr : c = 2 * k + 1) (hH : Head off c input S0 k S) :
