/-- **The loop**: from the head of batch `k`, the remaining batches. -/
theorem loop_access (off c : Nat) (input : Int → BitVec 64) (S0 : State (BitVec 64)) (hb : 64 * (off + c) ≤ 2 ^ 54) :
    ∀ d k (S : State (BitVec 64)), k + d + 1 = (c + 1) / 2 → Head off c input S0 k S →
      Arm.AccessRun rodata prog (3783 * (d + 1)) (4 * ((off + 2 * k : Nat) : Int)) (4 * ((off + c : Nat) : Int)) S := by
  intro d
  induction d with
  | zero =>
    intro k S hk hH
    rw [show 3783 * (0 + 1) = 3783 from rfl]
    rcases (by omega : c = 2 * k + 2 ∨ c = 2 * k + 1) with h2 | h1
    · have := batch_b off c input S0 hb k S h2 hH
      rw [show 4 * ((off + c : Nat) : Int) = 4 * ((off + 2 * k : Nat) : Int) + 8 by omega]; exact this
    · have := batch_c off c input S0 hb k S h1 hH
      rw [show 4 * ((off + c : Nat) : Int) = 4 * ((off + 2 * k : Nat) : Int) + 4 by omega]; exact this
  | succ d ih =>
    intro k S hk hH
    have h1 := (iter off c input S0 hb k S (by omega) hH).1 (by omega)
    rw [show 3783 * (d + 1 + 1) = 3783 + 3783 * (d + 1) by omega]
    apply Arm.accessRun_add rodata prog _ _ _ _ _ S (batch_a off c input S0 hb k S (by omega) hH)
    have := ih (k + 1) _ (by omega) h1
    rw [show ((off + 2 * (k + 1) : Nat) : Int) = (off + 2 * k : Nat) + 2 by omega] at this
    rw [show 4 * ((off + 2 * k : Nat) : Int) + 8 = 4 * (((off + 2 * k : Nat) : Int) + 2) by omega]
    exact this

