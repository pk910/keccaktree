  have hcmpV : Arm.exec rodata (.cmp 2 2) (T'.withFlags S.zf S.cf S.nf S.vf) = Arm.next (Arm.setFlags T' ((c : Int) - 2 * k) 2) := by
    rw [hcmp]; rfl
  have hz : decide ((c : Int) - 2 * k = 2) = false := decide_eq_false (by omega)
  have hcf : decide (2 ≤ (c : Int) - 2 * k) = false := decide_eq_false (by omega)
