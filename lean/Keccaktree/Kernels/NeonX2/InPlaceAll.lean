    simp [SummOk, nextB] <;> omega
  have aB : Arm.AccessRun rodata prog GenSBe.segLen (4 * ((off + 2 * k : Nat) : Int)) (4 * ((off + 2 * k : Nat) : Int) + 8) W :=
