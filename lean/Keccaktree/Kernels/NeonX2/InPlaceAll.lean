  have hcB : relocState (rho (off + 2 * k)) (cutOf GenSBo.ctl0 GenSBo.sc0) = cutOf GenSBo.ctl0 (norm W GenSBo.sc0) := by
    apply cut_transfer (rho (off + 2 * k)) _ hρ hρ GenSHc.ctl1 GenSBo.ctl0 GenSHc.sc1 GenSBo.sc0 W (norm W GenSBo.sc0) hcutW
      (hL_dec _ _ (by decide +kernel)) (fun i _ => rfl) (hval_same _ _ _ _ _ (by decide +kernel))
