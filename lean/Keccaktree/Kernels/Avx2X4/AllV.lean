/-- The step bound of a call on `c` nodes. -/
def steps (off c : Nat) : Nat := 87 + LI * c + XM

set_option maxRecDepth 100000 in
set_option maxHeartbeats 40000000 in
/-- **`keccaktree_keccak256_avx2_x4` on any number of nodes**, from a fresh call. -/
theorem norm_thm (v : Nat) (hv64 : v < 2 ^ 64) : NormThm (setWord rodata 112 v) prog 736 steps targets := by
  intro off c input S hE hb hpc
  have I0 : Inv off c input S S 0 := ⟨hE.ok, hE.inp, fun _ _ => rfl, fun n hn => absurd hn (Nat.not_lt_zero _)⟩
  have hc55 : (c : Int) < 36028797018963968 := by
    have : (2 : Nat) ^ 54 = 18014398509481984 := rfl
    omega
  have hmb : 64 * off ≤ 2 ^ 54 := by omega
  have f0 := (X86K.Fr.entry (setWord rodata 112 v) prog off c input S hE).pc_congr (pc' := 736) hpc
  have hcs : c = 0 ∨ c = 1 ∨ 2 ≤ c := by omega
  rcases hcs with rfl | rfl | hM
  · -- c = 0
    have f1 := f0.cmpi 2 (1) (((0 : Nat)) : Int) (by decide +kernel : prog.getD 736 .nop = .cmpi 2 (1)) (by simp [setVal]) (by fr_lo) (by fr_hi)
    have hr := f1.jcct_taken .be "keccaktree_keccak256_x86_x1" (by decide +kernel : prog.getD 737 .nop = .jcct .be "keccaktree_keccak256_x86_x1") (by fr_cond)
    rw [show steps off 0 = (1 + 1) + (steps off 0 - (1 + 1)) by unfold steps; omega, Isa.run_add, hr,
      Isa.run_halted _ _ _ _ _ rfl]
    refine ⟨rfl, f1.err, fun q _ => by rw [f1.near.2.2.2.2.2.2.1], Or.inr ⟨"keccaktree_keccak256_x86_x1", 0, rfl, by decide, by omega,
      fun n hn => absurd hn (Nat.not_lt_zero _), ?_⟩⟩
    simp only [Nat.add_zero, Nat.sub_zero]
    exact ⟨handover_fr hE f1 (by decide) _ ⟨rfl, rfl, rfl, rfl, f1.err, rfl, rfl⟩, hb⟩
  · -- c = 1
    have f1 := f0.cmpi 2 (1) (((1 : Nat)) : Int) (by decide +kernel : prog.getD 736 .nop = .cmpi 2 (1)) (by simp [setVal]) (by fr_lo) (by fr_hi)
    have hr := f1.jcct_taken .be "keccaktree_keccak256_x86_x1" (by decide +kernel : prog.getD 737 .nop = .jcct .be "keccaktree_keccak256_x86_x1") (by fr_cond)
    rw [show steps off 1 = (1 + 1) + (steps off 1 - (1 + 1)) by unfold steps; omega, Isa.run_add, hr,
      Isa.run_halted _ _ _ _ _ rfl]
    refine ⟨rfl, f1.err, fun q _ => by rw [f1.near.2.2.2.2.2.2.1], Or.inr ⟨"keccaktree_keccak256_x86_x1", 0, rfl, by decide, by omega,
      fun n hn => absurd hn (Nat.not_lt_zero _), ?_⟩⟩
    simp only [Nat.add_zero, Nat.sub_zero]
    exact ⟨handover_fr hE f1 (by decide) _ ⟨rfl, rfl, rfl, rfl, f1.err, rfl, rfl⟩, hb⟩
  · -- 2 ≤ c
    have f1 := f0.cmpi 2 (1) (c : Int) (by decide +kernel : prog.getD 736 .nop = .cmpi 2 (1)) (by simp [setVal]) (by fr_lo) (by fr_hi)
    have f2 := f1.jcct_not .be "keccaktree_keccak256_x86_x1" (by decide +kernel : prog.getD 737 .nop = .jcct .be "keccaktree_keccak256_x86_x1") (by fr_cond)
    have hx := Fr.cut (rho_ok off) (rho_ok 0) entryCtl GenPff.facts.ctl0 entrySc GenPff.facts.sc0
      (PreCut.entry off c input S hE hb) f2 [] (by simp [setVal]) (by decide +kernel) (by decide +kernel) (by fr_eq) (by fr_eq) (by decide +kernel)
    rw [rho_add, Nat.add_zero] at hx
    obtain ⟨ok1, cut1⟩ := (GenPff.factsV v).run (rho off) (rho_ok off) (rho_within off hmb) _ hx (I0.fr f2).ok
    simp only [GenPff.factsV_ctlK, GenPff.factsV_scK, GenPff.factsV_len] at ok1 cut1
    have I1 := (I0.fr f2).seg (GenPff.factsV v) off (by omega) hmb hx (by wok_in) (by wok_out2 GenPff.factsV GenPff.facts)
    simp only [GenPff.factsV_len] at I1
    have e2 : (X86.isa.run (setWord rodata 112 v) prog GenPff.facts.len (X86.isa.run (setWord rodata 112 v) prog 2 S)).getGD 2 =
        (X86.isa.run (setWord rodata 112 v) prog 2 S).getGD 2 := by
      rw [← envOf_gdVar _ 2 (by decide), ← envOf_gdVar _ 2 (by decide)]
      exact GenPff.factsV_rdx v _ (rho_ok off) (rho_within off hmb) _ hx (I0.fr f2).ok
    have hd := afterP_Pff v hv64 off c input S _ hb cut1 I1 (by
      rw [e2, f2.vals (2, (c : Int)) (by simp [setVal])]
      try rfl) (by omega)
    rw [len_Pff] at hd
    exact (Done.run rfl (Done.run rfl hd)) (steps off c) (by unfold steps; omega)

