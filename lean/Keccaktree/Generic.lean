  let e12 := ib2_3 ^^^ (in3_1 &&& ib4_3)
  let e13 := in3_1 ^^^ (ib4_3 ||| ib0_3)
  let e14 := ib4_3 ^^^ (ib0_3 &&& ib1_3)
  let ib0_4 := (ROL (a[4]^^^id4_1) 27)
  let ib1_4 := (ROL (a[5]^^^id0_1) 36)
  let ib2_4 := (ROL (a[11]^^^id1_1) 10)
  let ib3_4 := (ROL (a[17]^^^id2_1) 15)
  let ib4_4 := (ROL (a[23]^^^id3_1) 56)
  let in3_2 := ~~~ib3_4
  let e15 := ib0_4 ^^^ (ib1_4 &&& ib2_4)
  let e16 := ib1_4 ^^^ (ib2_4 ||| ib3_4)
  let e17 := ib2_4 ^^^ (in3_2 ||| ib4_4)
  let e18 := in3_2 ^^^ (ib4_4 &&& ib0_4)
  let e19 := ib4_4 ^^^ (ib0_4 ||| ib1_4)
  let ib0_5 := (ROL (a[2]^^^id2_1) 62)
  let ib1_5 := (ROL (a[8]^^^id3_1) 55)
  let ib2_5 := (ROL (a[14]^^^id4_1) 39)
  let ib3_5 := (ROL (a[15]^^^id0_1) 41)
  let ib4_5 := (ROL (a[21]^^^id1_1) 2)
  let in1_1 := ~~~ib1_5
  let e20 := ib0_5 ^^^ (in1_1 &&& ib2_5)
  let e21 := in1_1 ^^^ (ib2_5 ||| ib3_5)
  let e22 := ib2_5 ^^^ (ib3_5 &&& ib4_5)
  let e23 := ib3_5 ^^^ (ib4_5 ||| ib0_5)
  let e24 := ib4_5 ^^^ (ib0_5 &&& ib1_5)
  #v[e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, e13, e14, e15, e16, e17, e18, e19, e20, e21, e22, e23, e24]

/-- `for rc := 1; rc < 23; rc += 2 { ... }` -/
def loopGo (rc : Nat) (e : Lanes) : Nat → Lanes
  | 0 => e
  | k + 1 => loopGo (rc + 2) (roundGoAE (roundGoEA e (RC rc)) (RC (rc + 1))) k

/-- Round 23 as written in the Go source: only the squeezed row (`A0..A4`) from `E0..E24`. -/
def round23Go (e : Lanes) : Vector W 5 :=
  let jc0_1 := e[0] ^^^ e[5] ^^^ e[10] ^^^ e[15] ^^^ e[20]
  let jc1_1 := e[1] ^^^ e[6] ^^^ e[11] ^^^ e[16] ^^^ e[21]
  let jc2_1 := e[2] ^^^ e[7] ^^^ e[12] ^^^ e[17] ^^^ e[22]
  let jc3_1 := e[3] ^^^ e[8] ^^^ e[13] ^^^ e[18] ^^^ e[23]
  let jc4_1 := e[4] ^^^ e[9] ^^^ e[14] ^^^ e[19] ^^^ e[24]
  let jd0_1 := jc4_1 ^^^ (ROL (jc1_1) 1)
  let jd1_1 := jc0_1 ^^^ (ROL (jc2_1) 1)
  let jd2_1 := jc1_1 ^^^ (ROL (jc3_1) 1)
  let jd3_1 := jc2_1 ^^^ (ROL (jc4_1) 1)
  let jd4_1 := jc3_1 ^^^ (ROL (jc0_1) 1)
  let jb0_1 := e[0] ^^^ jd0_1
  let jb1_1 := (ROL (e[6]^^^jd1_1) 44)
  let jb2_1 := (ROL (e[12]^^^jd2_1) 43)
  let jb3_1 := (ROL (e[18]^^^jd3_1) 21)
  let jb4_1 := (ROL (e[24]^^^jd4_1) 14)
  let jn2_1 := ~~~jb2_1
  let e0 := jb0_1 ^^^ (jb1_1 ||| jb2_1) ^^^ 0x8000000080008008#64
  let e1 := jb1_1 ^^^ (jn2_1 ||| jb3_1)
  let e2 := jb2_1 ^^^ (jb3_1 &&& jb4_1)
  let e3 := jb3_1 ^^^ (jb4_1 ||| jb0_1)
  let e4 := jb4_1 ^^^ (jb0_1 &&& jb1_1)
  #v[e0, e1, e2, e3, e4]

/-- One pair of chunks (64 bytes) to its digest, as the Go loop body computes it. -/
def nodeGo (l r : Nat → BitVec 8) : Vector (BitVec 8) 32 :=
  let e := round0Go (absorbGo l r)
  let e := loopGo 1 e 11
  let a := round23Go e
  Vector.ofFn fun j : Fin 32 =>
    match j.val / 8 with
    | 0 => st64 a[0] (j.val % 8)
    | 1 => st64 (~~~a[1]) (j.val % 8)
    | 2 => st64 (~~~a[2]) (j.val % 8)
    | _ => st64 a[3] (j.val % 8)

/-- `keccak256_1_generic(digests, chunks)`: `digests[i] = keccak256(chunks[2i] || chunks[2i+1])`. -/
def hashGo (chunks : Nat → Nat → BitVec 8) (i : Nat) : Vector (BitVec 8) 32 :=
  nodeGo (chunks (2 * i)) (chunks (2 * i + 1))

end Keccaktree.Generic
