import Keccaktree.Asm.X86Kernel
import Keccaktree.Asm.LibAlias
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
/-!
# The access condition along a generated x86 kernel proof (count steps, outcomes)

The in-place theorem of an x86 kernel needs its `LibAlias.AccessThm`: the access condition
(`X86.AccessRun`) along the separate-region run of the call, and at a hand-over the final bound below
the next kernel's input.  For the kernels whose every-count proof is generated by agent x86b's
`x86_glue.py` (`X86K`: segments `SegFacts`, count steps `Fr`, outcomes `Done`), the access proof
(`x86_glue_al.py`) has the same skeleton:

* `FrA`: count steps (`Fr`) with the access condition of their run at any bound (`quiet`
  instructions: no input or output cells in any state); one lemma per instruction form, with the
  arguments of the `Fr` one;
* `DoneA off c input U k B`: some final bound `Bf` such that every run of at least `k` steps from
  `U` has the access condition from bound `B` up to `Bf`, and the hand-over condition (`Hand`) of
  `AccessThm` at its end; `DoneA.run` (a prefix with its access condition), `DoneA.mono`,
  `DoneA.halt` (a halted run), `DoneA.access` (the statement of `AccessThm`);
* `Hand.none` (no tail call), `Hand.tail` (the hand-over entry fixes the nodes done: `done_eq_of_rdi`);
* `acc_one`: the last step of an exit (`ret` at depth 0, a tail call).

The segments' access conditions come from their footprint summaries (`gen_inplace.py`, `chain_access`).
-/
namespace Keccaktree.Asm.X86K
open Keccaktree.Asm Keccaktree.Asm.X86 Keccaktree.Asm.LibX86

/-- The count-step instructions: no input or output cells in any state. -/
def quiet : Instr → Bool
  | .cmpi _ _ | .test _ _ | .sub _ _ | .movi _ _ | .mov _ _ | .xorz _ | .bt _ _ | .nop | .vzeroupper
  | .jmp _ | .jcc _ _ | .jcct _ _ | .tailcall _ => true
  | .cmprm _ (.rip _) => true
  | _ => false

theorem quiet_cells (s : State (BitVec 64)) (i : Instr) (hq : quiet i = true) :
    (∀ c ∈ reads s i, c.1 ≠ rInput) ∧ (∀ c ∈ writes s i, c.1 ≠ rInput ∧ c.1 ≠ rOutput) := by
  cases i
  case cmprm a mo =>
    cases mo with
    | base g d => simp [quiet] at hq
    | rip o =>
      constructor <;> intro c hc
      · simp only [reads, memCells, memAddr?, storeCells, List.mem_map, List.mem_range] at hc
        obtain ⟨_, _, rfl⟩ := hc
        show rRodata ≠ rInput
        decide
      · simp [writes] at hc
  all_goals (try simp only [quiet, Bool.false_eq_true] at hq)
  all_goals (constructor <;> intro c hc <;> simp [reads, writes] at hc)

theorem accessRun_of_halted {rodata : Array (BitVec 64)} {prog : Array Instr} (j : Nat) (B : Int)
    (T : State (BitVec 64)) (hh : T.halted = true) : AccessRun rodata prog j B B T := by
  cases j with
  | zero => exact Int.le_refl B
  | succ j => simp only [AccessRun, hh, ↓reduceIte]; exact Int.le_refl B

/-- A halted run keeps its access condition when padded. -/
theorem accessRun_pad {rodata : Array (BitVec 64)} {prog : Array Instr} (n k : Nat) (B Bf : Int)
    (U : State (BitVec 64)) (hk : k ≤ n) (hA : AccessRun rodata prog k B Bf U)
    (hh : (X86.isa.run rodata prog k U).halted = true) : AccessRun rodata prog n B Bf U := by
  have := accessRun_add rodata prog k (n - k) B Bf Bf U hA (accessRun_of_halted (n - k) Bf _ hh)
  rwa [show k + (n - k) = n by omega] at this

/-- One step of a `quiet` instruction, or of `ret` at depth 0. -/
theorem acc_one {rodata : Array (BitVec 64)} {prog : Array Instr} (T : State (BitVec 64)) (hh : T.halted = false)
    (hq : quiet (prog.getD T.pc .nop) = true ∨ (prog.getD T.pc .nop = .ret ∧ T.depth = 0))
    (he : (X86.isa.run rodata prog 1 T).err = false) (B : Int) : AccessRun rodata prog 1 B B T := by
  rw [X86.run_one rodata prog T hh] at he
  have hc : (∀ c ∈ reads T (prog.getD T.pc .nop), c.1 ≠ rInput) ∧
      (∀ c ∈ writes T (prog.getD T.pc .nop), c.1 ≠ rInput ∧ c.1 ≠ rOutput) := by
    rcases hq with hq | ⟨hr, hd⟩
    · exact quiet_cells T _ hq
    · rw [hr]; constructor <;> intro c hc <;> simp [reads, writes, hd] at hc
  exact accessRun_step rodata prog 0 B B T hh he hc.1 hc.2 (Int.le_refl B)

variable {rodata : Array (BitVec 64)} {prog : Array Instr} {S : State (BitVec 64)} {m pc : Nat} {zf cf : Bool}
  {vals : List (Nat × Int)} {R : List Nat}

/-- `m` count steps from `S` (`Fr`), with the access condition of their run at any bound. -/
structure FrA (rodata : Array (BitVec 64)) (prog : Array Instr) (S : State (BitVec 64)) (m : Nat)
    (pc : Nat) (zf cf : Bool) (vals : List (Nat × Int)) (R : List Nat) : Prop where
  fr : Fr rodata prog S m pc zf cf vals R
  acc : ∀ B : Int, AccessRun rodata prog m B B S

theorem acc_succ (hA : ∀ B : Int, AccessRun rodata prog m B B S)
    (hh : (X86.isa.run rodata prog m S).halted = false)
    (hq : quiet (prog.getD (X86.isa.run rodata prog m S).pc .nop) = true)
    (he : (X86.isa.run rodata prog (m + 1) S).err = false) : ∀ B : Int, AccessRun rodata prog (m + 1) B B S := by
  intro B
  apply accessRun_add rodata prog m 1 B B B S (hA B)
  apply acc_one _ hh (Or.inl hq)
  rw [← Isa.run_add]; exact he

theorem FrA.step {pc' : Nat} {zf' cf' : Bool} {vals' : List (Nat × Int)} {R' : List Nat}
    (h : FrA rodata prog S m pc zf cf vals R) (h' : Fr rodata prog S (m + 1) pc' zf' cf' vals' R')
    (hq : quiet (prog.getD pc .nop) = true) : FrA rodata prog S (m + 1) pc' zf' cf' vals' R' :=
  ⟨h', acc_succ h.acc h.fr.halted (by rw [h.fr.pc]; exact hq) h'.err⟩

theorem FrA.start (S : State (BitVec 64)) (vals : List (Nat × Int)) (hg : S.g = Vector.replicate 32 ⟨0, 0⟩)
    (hv : ∀ p ∈ vals, S.getGD p.1 = BitVec.ofInt 64 p.2) (he : S.err = false) (hh : S.halted = false)
    (ht : S.tail = none) : FrA rodata prog S 0 S.pc S.zf S.cf vals [] :=
  ⟨Fr.start S vals hg hv he hh ht, fun B => Int.le_refl B⟩

theorem FrA.entry (rodata : Array (BitVec 64)) (prog : Array Instr) (off count : Nat) (input : Int → BitVec 64)
    (S : State (BitVec 64)) (hE : Entry off count input S) :
    FrA rodata prog S 0 S.pc S.zf S.cf [(2, (count : Int))] [] :=
  ⟨Fr.entry rodata prog off count input S hE, fun B => Int.le_refl B⟩

theorem FrA.pc_congr (h : FrA rodata prog S m pc zf cf vals R) {pc' : Nat} (e : pc = pc') :
    FrA rodata prog S m pc' zf cf vals R := e ▸ h

theorem FrA.cmpi (h : FrA rodata prog S m pc zf cf vals R) (n : Nat) (imm v : Int)
    (hi : prog.getD pc .nop = .cmpi n imm) (hv : (n, v) ∈ vals) (h0 : 0 ≤ v) (h1 : v < 2 ^ 55) :
    FrA rodata prog S (m + 1) (pc + 1) (decide (v = imm)) (decide (v < imm)) vals R :=
  h.step (h.fr.cmpi n imm v hi hv h0 h1) (by rw [hi]; rfl)

theorem FrA.test (h : FrA rodata prog S m pc zf cf vals R) (n : Nat) (v : Int)
    (hi : prog.getD pc .nop = .test n n) (hv : (n, v) ∈ vals) (h0 : 0 ≤ v) (h1 : v < 2 ^ 55) :
    FrA rodata prog S (m + 1) (pc + 1) (decide (v = 0)) false vals R :=
  h.step (h.fr.test n v hi hv h0 h1) (by rw [hi]; rfl)

theorem FrA.jcc (h : FrA rodata prog S m pc zf cf vals R) (c : Cond) (t : Nat)
    (hi : prog.getD pc .nop = .jcc c t) :
    FrA rodata prog S (m + 1) (if condF zf cf c then t else pc + 1) zf cf vals R :=
  h.step (h.fr.jcc c t hi) (by rw [hi]; rfl)

theorem FrA.jmp (h : FrA rodata prog S m pc zf cf vals R) (t : Nat) (hi : prog.getD pc .nop = .jmp t) :
    FrA rodata prog S (m + 1) t zf cf vals R :=
  h.step (h.fr.jmp t hi) (by rw [hi]; rfl)

theorem FrA.jcct_not (h : FrA rodata prog S m pc zf cf vals R) (c : Cond) (name : String)
    (hi : prog.getD pc .nop = .jcct c name) (hc : condF zf cf c = false) :
    FrA rodata prog S (m + 1) (pc + 1) zf cf vals R :=
  h.step (h.fr.jcct_not c name hi hc) (by rw [hi]; rfl)

theorem FrA.nop (h : FrA rodata prog S m pc zf cf vals R)
    (hi : prog.getD pc .nop = .nop ∨ prog.getD pc .nop = .vzeroupper) :
    FrA rodata prog S (m + 1) (pc + 1) zf cf vals R :=
  h.step (h.fr.nop hi) (by rcases hi with hi | hi <;> rw [hi] <;> rfl)

theorem FrA.movi (h : FrA rodata prog S m pc zf cf vals R) (n : Nat) (hn : n < 32) (imm : Int)
    (hi : prog.getD pc .nop = .movi n imm) :
    FrA rodata prog S (m + 1) (pc + 1) zf cf (setVal vals n imm) (n :: R) :=
  h.step (h.fr.movi n hn imm hi) (by rw [hi]; rfl)

theorem FrA.mov (h : FrA rodata prog S m pc zf cf vals R) (d s : Nat) (hd : d < 32) (v : Int)
    (hi : prog.getD pc .nop = .mov d s) (hv : (s, v) ∈ vals) :
    FrA rodata prog S (m + 1) (pc + 1) zf cf (setVal vals d v) (d :: R) :=
  h.step (h.fr.mov d s hd v hi hv) (by rw [hi]; rfl)

theorem FrA.xorz (h : FrA rodata prog S m pc zf cf vals R) (d : Nat) (hd : d < 32)
    (hi : prog.getD pc .nop = .xorz d) :
    FrA rodata prog S (m + 1) (pc + 1) true false (setVal vals d 0) (d :: R) :=
  h.step (h.fr.xorz d hd hi) (by rw [hi]; rfl)

theorem FrA.sub (h : FrA rodata prog S m pc zf cf vals R) (n : Nat) (hn : n < 32) (imm v : Int)
    (hi : prog.getD pc .nop = .sub n imm) (hv : (n, v) ∈ vals) (h0 : 0 ≤ v) (h1 : v < 2 ^ 55) :
    FrA rodata prog S (m + 1) (pc + 1) (decide (v = imm)) (decide (v < imm)) (setVal vals n (v - imm)) (n :: R) :=
  h.step (h.fr.sub n hn imm v hi hv h0 h1) (by rw [hi]; rfl)

theorem FrA.bt (h : FrA rodata prog S m pc zf cf vals R) (a b : Nat) (w v : Int)
    (hi : prog.getD pc .nop = .bt a b) (hw : (a, w) ∈ vals) (hv : (b, v) ∈ vals) (h0 : 0 ≤ v) (h1 : v < 2 ^ 55) :
    FrA rodata prog S (m + 1) (pc + 1) zf ((BitVec.ofInt 64 w).getLsbD (v.toNat % 64)) vals R :=
  h.step (h.fr.bt a b w v hi hw hv h0 h1) (by rw [hi]; rfl)

theorem FrA.cmprm (h : FrA rodata prog S m pc zf cf vals R) (a off : Nat) (v : Int)
    (hi : prog.getD pc .nop = .cmprm a (.rip off)) (hal : (off : Int) % 8 = 0) (hpos : 0 ≤ (off : Int) / 8)
    (hv : (a, v) ∈ vals) (h0 : 0 ≤ v) (h1 : v < 2 ^ 55) :
    FrA rodata prog S (m + 1) (pc + 1) (decide (BitVec.ofInt 64 v = rodata.getD ((off : Int) / 8).toNat 0))
      (decide ((BitVec.ofInt 64 v).toNat < (rodata.getD ((off : Int) / 8).toNat 0).toNat)) vals R :=
  h.step (h.fr.cmprm a off v hi hal hpos hv h0 h1) (by rw [hi]; rfl)

/-- The access condition of a taken conditional tail call (the run then halts). -/
theorem FrA.acc_jcct (h : FrA rodata prog S m pc zf cf vals R) (c : Cond) (name : String)
    (hi : prog.getD pc .nop = .jcct c name) (hc : condF zf cf c = true) :
    ∀ B : Int, AccessRun rodata prog (m + 1) B B S :=
  acc_succ h.acc h.fr.halted (by rw [h.fr.pc, hi]; rfl) (by rw [h.fr.jcct_taken c name hi hc]; exact h.fr.err)

/-! ## Access conditions of the runs from a point -/

/-- The hand-over condition of `AccessThm` at the end `T` of a run, for the final bound `Bf`. -/
def Hand (off c : Nat) (input : Int → BitVec 64) (T : State (BitVec 64)) (Bf : Int) : Prop :=
  ∀ (next : String) (done : Nat), done ≤ c → T.tail = some next →
    Entry (off + done) (c - done) input (normCtl { T with halted := false, tail := none }) →
    Bf ≤ 8 * ((off + done : Nat) : Int)

theorem Hand.none {off c : Nat} {input : Int → BitVec 64} {T : State (BitVec 64)} {Bf : Int}
    (ht : T.tail = Option.none) : Hand off c input T Bf := by
  intro next done _ h; rw [ht] at h; cases h

/-- At a tail call handing over the first `d0` nodes: the hand-over entry determines `d0`. -/
theorem Hand.tail {off c : Nat} {input : Int → BitVec 64} {Bf : Int} (T : State (BitVec 64)) (d0 : Nat)
    (hd0 : d0 ≤ c) (hb : 64 * (off + c) ≤ 2 ^ 54)
    (he : Entry (off + d0) (c - d0) input (normCtl { T with halted := false, tail := Option.none }))
    (hBf : Bf ≤ 8 * ((off + d0 : Nat) : Int)) : Hand off c input T Bf := by
  intro next d hd _ hE
  have := LibAlias.done_eq_of_rdi off d d0 (c - d) input _ hE he.rdi (by omega) (by omega)
  subst this; exact hBf

/-- `Hand.tail` at the entry (no node done yet). -/
theorem Hand.tail0 {off c : Nat} {input : Int → BitVec 64} {Bf : Int} (T : State (BitVec 64))
    (hb : 64 * (off + c) ≤ 2 ^ 54)
    (he : Entry off c input (normCtl { T with halted := false, tail := Option.none }))
    (hBf : Bf ≤ 8 * (off : Int)) : Hand off c input T Bf :=
  Hand.tail T 0 (Nat.zero_le c) hb he (by rw [Nat.add_zero]; exact hBf)

/-- From `U`: every run of at least `k` steps has the access condition from bound `B` (up to one final
bound `Bf`) and the hand-over condition at its end. -/
def DoneA (rodata : Array (BitVec 64)) (prog : Array Instr) (off c : Nat) (input : Int → BitVec 64) (U : State (BitVec 64)) (k : Nat) (B : Int) : Prop :=
  ∃ Bf : Int, ∀ n, k ≤ n → AccessRun rodata prog n B Bf U ∧ Hand off c input (X86.isa.run rodata prog n U) Bf

variable {off c : Nat} {input : Int → BitVec 64}

theorem DoneA.mono {U : State (BitVec 64)} {k k' : Nat} {B : Int}
    (h : DoneA rodata prog off c input U k B) (hk : k ≤ k') :
    DoneA rodata prog off c input U k' B :=
  let ⟨Bf, hf⟩ := h; ⟨Bf, fun n hn => hf n (by omega)⟩

theorem DoneA.run {U U' : State (BitVec 64)} {a k : Nat} {B B' B'' : Int}
    (hA : AccessRun rodata prog a B B' U) (hr : X86.isa.run rodata prog a U = U')
    (h : DoneA rodata prog off c input U' k B'') (hB : B' ≤ B'') :
    DoneA rodata prog off c input U (a + k) B := by
  obtain ⟨Bf, hf⟩ := h
  refine ⟨Bf, fun n hn => ?_⟩
  have h2 := hf (n - a) (by omega)
  rw [← hr] at h2
  constructor
  · have := accessRun_add rodata prog a (n - a) B B' Bf U hA (accessRun_mono rodata prog _ B'' B' Bf _ hB h2.1)
    rwa [show a + (n - a) = n by omega] at this
  · rw [show n = a + (n - a) by omega, Isa.run_add]; exact h2.2

/-- A run that halts after `k` steps. -/
theorem DoneA.halt {U : State (BitVec 64)} {k : Nat} {B Bf : Int} (hA : AccessRun rodata prog k B Bf U)
    (hh : (X86.isa.run rodata prog k U).halted = true) (hH : Hand off c input (X86.isa.run rodata prog k U) Bf) :
    DoneA rodata prog off c input U k B :=
  ⟨Bf, fun n hn => ⟨accessRun_pad n k B Bf U hn hA hh, by rw [run_pad rodata prog U k n hn hh]; exact hH⟩⟩

/-- The statement of `AccessThm` at a run of `n ≥ k` steps. -/
theorem DoneA.access {U : State (BitVec 64)} {k : Nat} {B : Int}
    (h : DoneA rodata prog off c input U k B) (n : Nat) (hn : k ≤ n) :
    ∃ Bf : Int, AccessRun rodata prog n B Bf U ∧ Hand off c input (X86.isa.run rodata prog n U) Bf :=
  let ⟨Bf, hf⟩ := h; ⟨Bf, (hf n hn).1, (hf n hn).2⟩

/-! ## Segments -/

/-- **A segment's access condition at node `m`**, from its slices' footprint summaries
(`gen_inplace.py`: `certs`, `len`, `chain`, `sums`). -/
theorem seg_acc {rodata : Array (BitVec 64)} {prog : Array Instr} {B : Int} (F : SegFacts rodata prog)
    (L : List (SliceCert X86.isa X86.isaReloc rodata prog B))
    (hL : (L.map fun C => C.idx.length).sum = F.len) (hch : ChainOk L)
    (hhd : ∀ C ∈ L.head?, C.ctl = F.ctl0 ∧ C.sc = F.sc0) (m : Nat) (hw : (rho m).within B) (S : State (BitVec 64))
    (hcut : relocState (rho m) (cutOf F.ctl0 F.sc0) = cutOf F.ctl0 S) (hs : SliceCert.Ok S) (b bf : Int)
    (hsum : SummOk (8 * (m : Int)) (4 * (m : Int)) b bf (L.map fun C => summ (traceCells rodata prog C.idx C.cut))) :
    AccessRun rodata prog F.len b bf S := by
  have := chain_access (rho m) (rho_ok m) hw L S b bf hch
    (by intro C hC; obtain ⟨h1, h2⟩ := hhd C hC; rw [h1, h2]; exact hcut) hs
    (by rw [rho_wshift_in, rho_wshift_out]; exact hsum)
  rwa [hL] at this

end Keccaktree.Asm.X86K
